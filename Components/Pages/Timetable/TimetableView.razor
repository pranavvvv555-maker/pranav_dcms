@page "/timetable"
@rendermode InteractiveServer

<PageTitle>DCMS — Timetable</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2 simple-page">
    <section class="page-intro">
        <div>
            <span class="premium-eyebrow">Academic Schedule & Workload</span>
            <MudText Typo="Typo.h4">Academic Timetable</MudText>
            <MudText Typo="Typo.body2">M.Tech CSE (Data Centre Systems Engineering) — Academic Year 2026-27 (SEM-I)</MudText>
        </div>
        <div class="d-flex align-center gap-2">
            <MudButton Variant="@(_activeView == 0 ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.EventAvailable"
                       OnClick="@(() => _activeView = 0)">
                Official Timetable (Thu–Sun · 28 Hrs)
            </MudButton>
            <MudButton Variant="@(_activeView == 1 ? Variant.Filled : Variant.Outlined)"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.History"
                       OnClick="@(() => _activeView = 1)">
                Legacy Weekend (Fri–Sun)
            </MudButton>
        </div>
    </section>

    @if (_activeView == 0)
    {
        <!-- OFFICIAL TIMETABLE (AY 2026-27 SEM-I) -->
        <section class="rate-progress-card mb-4" style="background: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%); border-left: 5px solid #2563eb;">
            <div class="rate-progress-card__icon" style="color: #2563eb;">
                <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Large" />
            </div>
            <div class="rate-progress-card__copy">
                <span style="font-weight:700; color:#1e40af; text-transform:uppercase; font-size:0.75rem;">MIT World Peace University · Dept of Computer Science Engineering</span>
                <MudText Typo="Typo.h6" Style="font-weight:800; color:#0f172a;">Official Semester-I Academic Timetable</MudText>
                <MudText Typo="Typo.body2" Style="color:#475569;">
                    Classrooms: <b>VY101 / VY202 / VY201 / VY602</b> · Teaching Days: <b>Thursday, Friday, Saturday, Sunday</b>
                </MudText>
            </div>
            <div class="rate-progress-card__meter" aria-label="Total weekly load">
                <strong style="color:#2563eb;">28</strong>
                <span>Hrs Load</span>
            </div>
        </section>

        <MudPaper Elevation="0" Class="faculty-list-card mb-5">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3 faculty-list-card__heading">
                <div>
                    <MudText Typo="Typo.h6" Style="font-weight:800;">Class Schedule Grid</MudText>
                    <MudText Typo="Typo.caption" Style="color:#64748b;">All 8 instructional slots with scheduled morning, lunch, and afternoon breaks.</MudText>
                </div>
                <div class="d-flex align-center gap-2">
                    <span class="status-pill" style="background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe;">Thursday (5h)</span>
                    <span class="status-pill" style="background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0;">Friday (8h)</span>
                    <span class="status-pill" style="background:#fefce8; color:#a16207; border:1px solid #fef08a;">Saturday (8h)</span>
                    <span class="status-pill" style="background:#faf5ff; color:#7e22ce; border:1px solid #e9d5ff;">Sunday (7h)</span>
                </div>
            </MudStack>

            <div class="simple-table" style="overflow-x: auto;">
                <MudTable Items="@_officialRows" Dense="true" Hover="true" Bordered="true" Elevation="0">
                    <HeaderContent>
                        <MudTh Style="font-weight: 800; min-width: 100px; background: #0f172a; color: white;">Day</MudTh>
                        <MudTh Style="font-weight: 700; min-width: 110px; background: #1e293b; color: white; text-align: center;">1<br /><small>08:30-09:30</small></MudTh>
                        <MudTh Style="font-weight: 700; min-width: 110px; background: #1e293b; color: white; text-align: center;">2<br /><small>09:30-10:30</small></MudTh>
                        <MudTh Style="font-weight: 600; background: #f1f5f9; color: #64748b; min-width: 70px; text-align: center;">Short<br /><small>10:30-10:45</small></MudTh>
                        <MudTh Style="font-weight: 700; min-width: 110px; background: #1e293b; color: white; text-align: center;">3<br /><small>10:45-11:45</small></MudTh>
                        <MudTh Style="font-weight: 700; min-width: 110px; background: #1e293b; color: white; text-align: center;">4<br /><small>11:45-12:45</small></MudTh>
                        <MudTh Style="font-weight: 600; background: #f1f5f9; color: #64748b; min-width: 70px; text-align: center;">Lunch<br /><small>12:45-01:30</small></MudTh>
                        <MudTh Style="font-weight: 700; min-width: 120px; background: #1e293b; color: white; text-align: center;">5<br /><small>01:30-02:30</small></MudTh>
                        <MudTh Style="font-weight: 700; min-width: 120px; background: #1e293b; color: white; text-align: center;">6<br /><small>02:30-03:30</small></MudTh>
                        <MudTh Style="font-weight: 600; background: #f1f5f9; color: #64748b; min-width: 70px; text-align: center;">Short<br /><small>03:30-03:45</small></MudTh>
                        <MudTh Style="font-weight: 700; min-width: 120px; background: #1e293b; color: white; text-align: center;">7<br /><small>03:45-04:45</small></MudTh>
                        <MudTh Style="font-weight: 700; min-width: 120px; background: #1e293b; color: white; text-align: center;">8<br /><small>04:45-05:45</small></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="font-weight: 800; background: #f8fafc; color: #0f172a;">@context.Day</MudTd>
                        <MudTd Style="@context.S1Style">@((MarkupString)context.Slot1)</MudTd>
                        <MudTd Style="@context.S2Style">@((MarkupString)context.Slot2)</MudTd>
                        <MudTd Style="background: #f8fafc; text-align: center; color: #94a3b8; font-size: 0.75rem;">Break</MudTd>
                        <MudTd Style="@context.S3Style">@((MarkupString)context.Slot3)</MudTd>
                        <MudTd Style="@context.S4Style">@((MarkupString)context.Slot4)</MudTd>
                        <MudTd Style="background: #f8fafc; text-align: center; color: #94a3b8; font-size: 0.75rem;">Lunch</MudTd>
                        <MudTd Style="@context.S5Style">@((MarkupString)context.Slot5)</MudTd>
                        <MudTd Style="@context.S6Style">@((MarkupString)context.Slot6)</MudTd>
                        <MudTd Style="background: #f8fafc; text-align: center; color: #94a3b8; font-size: 0.75rem;">Break</MudTd>
                        <MudTd Style="@context.S7Style">@((MarkupString)context.Slot7)</MudTd>
                        <MudTd Style="@context.S8Style">@((MarkupString)context.Slot8)</MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </MudPaper>

        <!-- SUBJECT TEACHER DETAILS -->
        <MudPaper Elevation="0" Class="faculty-list-card mb-5 p-4">
            <MudText Typo="Typo.h6" Style="font-weight:800; color:#0f172a; margin-bottom: 12px;">
                Subject Teacher Details (Official Allocation)
            </MudText>
            <MudTable Items="@_officialTeachers" Dense="true" Hover="true" Bordered="true" Elevation="0">
                <HeaderContent>
                    <MudTh Style="font-weight:700; width:60px;">Sr. No.</MudTh>
                    <MudTh Style="font-weight:700; width:340px;">Teacher Name (Code)</MudTh>
                    <MudTh Style="font-weight:700;">Subject Name</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd Style="font-weight:700; text-align:center;">@context.SrNo</MudTd>
                    <MudTd Style="font-weight:700; color:#1e293b;">@context.TeacherName</MudTd>
                    <MudTd Style="color:#334155;">@context.SubjectName</MudTd>
                </RowTemplate>
            </MudTable>

            <MudGrid Class="mt-4 pt-3" Style="border-top: 1px dashed #cbd5e1;">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.body2" Style="font-weight:700; color:#b91c1c;">Prof. Dr. B. M. Patil</MudText>
                    <MudText Typo="Typo.caption" Style="color:#64748b;">Program Director, DoME · MIT-WPU, Pune</MudText>
                </MudItem>
                <MudItem xs="12" sm="6" Style="text-align: right;">
                    <MudText Typo="Typo.body2" Style="font-weight:700; color:#b91c1c;">Prof. Dr. Siddharth S Chakrabarti</MudText>
                    <MudText Typo="Typo.caption" Style="color:#64748b;">Dean, SoET · MIT-WPU, Pune</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
    else
    {
        <!-- LEGACY WEEKEND TIMETABLE (FRI - SUN) -->
        <section class="rate-progress-card mb-4">
            <div class="rate-progress-card__icon"><MudIcon Icon="@Icons.Material.Filled.CalendarMonth" /></div>
            <div class="rate-progress-card__copy">
                <span>Legacy Weekend programme</span>
                <MudText Typo="Typo.h6">8:30 AM – 6:45 PM (Fri – Sun)</MudText>
                <MudText Typo="Typo.body2">Classrooms VY003 and VT303 · breaks are already marked in the schedule.</MudText>
            </div>
            <div class="rate-progress-card__meter" aria-label="Three teaching days">
                <strong>3</strong>
                <span>days</span>
            </div>
        </section>

        <MudPaper Elevation="0" Class="faculty-list-card mb-5">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4 faculty-list-card__heading">
                <div>
                    <MudText Typo="Typo.h6">Class schedule (Legacy)</MudText>
                    <MudText Typo="Typo.body2">Scroll across to view the full day.</MudText>
                </div>
            </MudStack>
            <div class="simple-table" style="overflow-x: auto;">
                <MudTable Items="@_legacyRows" Dense="true" Hover="true" Bordered="true" Elevation="0">
                    <HeaderContent>
                        <MudTh Style="font-weight: 800; min-width: 110px;">Day</MudTh>
                        <MudTh Style="font-weight: 700; min-width: 120px;">08:30 - 09:30</MudTh>
                        <MudTh Style="font-weight: 700; min-width: 120px;">09:30 - 10:30</MudTh>
                        <MudTh Style="font-weight: 600; background: #F8FAFC !important; color: #94A3B8 !important; min-width: 80px; text-align: center;">10:30 - 10:45</MudTh>
                        <MudTh Style="font-weight: 700; min-width: 120px;">10:45 - 11:45</MudTh>
                        <MudTh Style="font-weight: 700; min-width: 120px;">11:45 - 12:45</MudTh>
                        <MudTh Style="font-weight: 600; background: #F8FAFC !important; color: #94A3B8 !important; min-width: 80px; text-align: center;">12:45 - 01:30</MudTh>
                        <MudTh Style="font-weight: 700; min-width: 130px;">01:30 - 02:30</MudTh>
                        <MudTh Style="font-weight: 700; min-width: 130px;">02:30 - 03:30</MudTh>
                        <MudTh Style="font-weight: 600; background: #F8FAFC !important; color: #94A3B8 !important; min-width: 80px; text-align: center;">03:30 - 03:45</MudTh>
                        <MudTh Style="font-weight: 700; min-width: 130px;">03:45 - 04:45</MudTh>
                        <MudTh Style="font-weight: 700; min-width: 130px;">04:45 - 05:45</MudTh>
                        <MudTh Style="font-weight: 700; min-width: 130px;">05:45 - 06:45</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="font-weight: 800; background: #F1F5F9; color: #0F172A;">@context.Day</MudTd>
                        <MudTd><span class="status-pill" style="@context.S1Style">@context.Slot1</span></MudTd>
                        <MudTd><span class="status-pill" style="@context.S2Style">@context.Slot2</span></MudTd>
                        <MudTd Style="background: #F8FAFC; text-align: center; color: #94A3B8; font-size: 0.75rem;">Break</MudTd>
                        <MudTd><span class="status-pill" style="@context.S3Style">@context.Slot3</span></MudTd>
                        <MudTd><span class="status-pill" style="@context.S4Style">@context.Slot4</span></MudTd>
                        <MudTd Style="background: #F8FAFC; text-align: center; color: #94A3B8; font-size: 0.75rem;">Lunch</MudTd>
                        <MudTd><span class="status-pill" style="@context.S5Style">@context.Slot5</span></MudTd>
                        <MudTd><span class="status-pill" style="@context.S6Style">@context.Slot6</span></MudTd>
                        <MudTd Style="background: #F8FAFC; text-align: center; color: #94A3B8; font-size: 0.75rem;">Break</MudTd>
                        <MudTd><span class="status-pill" style="@context.S7Style">@context.Slot7</span></MudTd>
                        <MudTd><span class="status-pill" style="@context.S8Style">@context.Slot8</span></MudTd>
                        <MudTd><span class="status-pill" style="@context.S9Style">@context.Slot9</span></MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </MudPaper>

        <MudExpansionPanels Class="payroll-history">
            <MudExpansionPanel Text="Legacy Course Guide & Professors">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="d-block mb-4">Course abbreviations reference.</MudText>
                <MudGrid>
                    @foreach (var item in _legacyLegend)
                    {
                        <MudItem xs="12" sm="6" md="3">
                            <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; padding: 14px; height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
                                <div>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <span class="status-pill" style="@item.BadgeStyle">@item.Code</span>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@item.Category</MudChip>
                                    </MudStack>
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #0F172A; margin-top: 8px;">
                                        @item.SubjectName
                                    </MudText>
                                </div>
                                <div style="margin-top: 10px; padding-top: 8px; border-top: 1px solid #E2E8F0;">
                                    <MudText Typo="Typo.caption" Style="color: #64748B; font-weight: 600; display: block;">
                                        👤 @item.FacultyName
                                    </MudText>
                                </div>
                            </div>
                        </MudItem>
                    }
                </MudGrid>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
</MudContainer>

