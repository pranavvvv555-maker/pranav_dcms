@page "/timetable"
@rendermode InteractiveServer

<PageTitle>DCMS — Timetable</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2 simple-page">
    <section class="page-intro">
        <div>
            <span class="premium-eyebrow">Academic schedule</span>
            <MudText Typo="Typo.h4">Timetable</MudText>
            <MudText Typo="Typo.body2">A simple weekend view for Semester I classes.</MudText>
        </div>
        <span class="status-pill" style="background:#eef6fc; color:#1d5e96; border:1px solid #cce2f2;">Friday – Sunday</span>
    </section>

    <section class="rate-progress-card">
        <div class="rate-progress-card__icon"><MudIcon Icon="@Icons.Material.Filled.CalendarMonth" /></div>
        <div class="rate-progress-card__copy">
            <span>Weekend programme</span>
            <MudText Typo="Typo.h6">8:30 AM – 6:45 PM</MudText>
            <MudText Typo="Typo.body2">Classrooms VY003 and VT303 · breaks are already marked in the schedule.</MudText>
        </div>
        <div class="rate-progress-card__meter" aria-label="Three teaching days">
            <strong>3</strong>
            <span>days</span>
        </div>
    </section>

    <MudPaper Elevation="0" Class="faculty-list-card mb-5">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4 faculty-list-card__heading">
            <div>
                <MudText Typo="Typo.h6">Class schedule</MudText>
                <MudText Typo="Typo.body2">Scroll across to view the full day.</MudText>
            </div>
        </MudStack>
        <div class="simple-table" style="overflow-x: auto;">
        <MudTable Items="@_scheduleRows" Dense="true" Hover="true" Bordered="true" Elevation="0">
            <HeaderContent>
                <MudTh Style="font-weight: 800; min-width: 110px;">Day</MudTh>
                <MudTh Style="font-weight: 700; min-width: 120px;">08:30 - 09:30</MudTh>
                <MudTh Style="font-weight: 700; min-width: 120px;">09:30 - 10:30</MudTh>
                <MudTh Style="font-weight: 600; background: #F8FAFC !important; color: #94A3B8 !important; min-width: 80px; text-align: center;">10:30 - 10:45</MudTh>
                <MudTh Style="font-weight: 700; min-width: 120px;">10:45 - 11:45</MudTh>
                <MudTh Style="font-weight: 700; min-width: 120px;">11:45 - 12:45</MudTh>
                <MudTh Style="font-weight: 600; background: #F8FAFC !important; color: #94A3B8 !important; min-width: 80px; text-align: center;">12:45 - 01:30</MudTh>
                <MudTh Style="font-weight: 700; min-width: 130px;">01:30 - 02:30</MudTh>
                <MudTh Style="font-weight: 700; min-width: 130px;">02:30 - 03:30</MudTh>
                <MudTh Style="font-weight: 600; background: #F8FAFC !important; color: #94A3B8 !important; min-width: 80px; text-align: center;">03:30 - 03:45</MudTh>
                <MudTh Style="font-weight: 700; min-width: 130px;">03:45 - 04:45</MudTh>
                <MudTh Style="font-weight: 700; min-width: 130px;">04:45 - 05:45</MudTh>
                <MudTh Style="font-weight: 700; min-width: 130px;">05:45 - 06:45</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="font-weight: 800; background: #F1F5F9; color: #0F172A;">@context.Day</MudTd>
                <MudTd><span class="status-pill" style="@context.S1Style">@context.Slot1</span></MudTd>
                <MudTd><span class="status-pill" style="@context.S2Style">@context.Slot2</span></MudTd>
                <MudTd Style="background: #F8FAFC; text-align: center; color: #94A3B8; font-size: 0.75rem;">Break</MudTd>
                <MudTd><span class="status-pill" style="@context.S3Style">@context.Slot3</span></MudTd>
                <MudTd><span class="status-pill" style="@context.S4Style">@context.Slot4</span></MudTd>
                <MudTd Style="background: #F8FAFC; text-align: center; color: #94A3B8; font-size: 0.75rem;">Lunch</MudTd>
                <MudTd><span class="status-pill" style="@context.S5Style">@context.Slot5</span></MudTd>
                <MudTd><span class="status-pill" style="@context.S6Style">@context.Slot6</span></MudTd>
                <MudTd Style="background: #F8FAFC; text-align: center; color: #94A3B8; font-size: 0.75rem;">Break</MudTd>
                <MudTd><span class="status-pill" style="@context.S7Style">@context.Slot7</span></MudTd>
                <MudTd><span class="status-pill" style="@context.S8Style">@context.Slot8</span></MudTd>
                <MudTd><span class="status-pill" style="@context.S9Style">@context.Slot9</span></MudTd>
            </RowTemplate>
        </MudTable>
        </div>
    </MudPaper>

    <MudExpansionPanels Class="payroll-history">
        <MudExpansionPanel Text="Course guide and professors">
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="d-block mb-4">Use this guide when you need to decode a subject abbreviation in the timetable.</MudText>

        <MudGrid>
            @foreach (var item in _legend)
            {
                <MudItem xs="12" sm="6" md="3">
                    <div style="background: #F8FAFC; border: 1px solid #E2E8F0; border-radius: 12px; padding: 14px; height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <span class="status-pill" style="@item.BadgeStyle">@item.Code</span>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@item.Category</MudChip>
                            </MudStack>
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #0F172A; margin-top: 8px;">
                                @item.SubjectName
                            </MudText>
                        </div>
                        <div style="margin-top: 10px; padding-top: 8px; border-top: 1px solid #E2E8F0;">
                            <MudText Typo="Typo.caption" Style="color: #64748B; font-weight: 600; display: block;">
                                👤 @item.FacultyName
                            </MudText>
                        </div>
                    </div>
                </MudItem>
            }
        </MudGrid>
        </MudExpansionPanel>
    </MudExpansionPanels>
</MudContainer>

