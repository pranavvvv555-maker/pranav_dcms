@page "/weekend"
@rendermode InteractiveServer
@inject SessionService SessionSvc
@inject AttendanceService AttendanceSvc
@inject FacultyService FacultySvc
@inject CourseService CourseSvc
@inject PaymentService PaymentSvc
@inject AcademicHolidayService HolidaySvc
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>DCMS — Weekend Desk</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-2 simple-page">
    <section class="page-intro weekend-desk-intro">
        <div>
            <span class="premium-eyebrow">Thursday · Friday · Saturday · Sunday</span>
            <MudText Typo="Typo.h4">Weekend desk</MudText>
            <MudText Typo="Typo.body2">Each night, record the classes conducted, mark student attendance, and review the faculty report in one place.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Class="btn-gradient-primary" StartIcon="@Icons.Material.Filled.CalendarMonth" OnClick="@(() => _activeTab = 0)">
            Open timetable
        </MudButton>
    </section>

    <section class="weekend-desk-picker" aria-label="Weekend date selector">
        <div class="weekend-desk-picker__top">
            <div>
                <span class="premium-eyebrow">Teaching weekend</span>
                <MudText Typo="Typo.h6">@WeekendLabel</MudText>
            </div>
            <div class="weekend-desk-picker__controls">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary" OnClick="JumpToEarlySeptemberWeekend" Style="font-weight:700; margin-right:6px;">
                    04–06 Sep (Old Timetable)
                </MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Primary" OnClick="@(() => ShiftWeekend(-7))" aria-label="Previous weekend" />
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ShowCurrentWeekend">Current weekend</MudButton>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary" OnClick="@(() => ShiftWeekend(7))" aria-label="Next weekend" />
            </div>
        </div>
        <div class="weekend-desk-picker__days">
            @foreach (var date in WeekendDates)
            {
                var isHoliday = IsHolidayDate(date);
                <MudButton Variant="Variant.Text" Class="@($"weekend-date-tab {(IsSelectedDate(date) ? "weekend-date-tab--active" : string.Empty)} {(isHoliday ? "weekend-date-tab--holiday" : string.Empty)}")"
                           OnClick="@(() => SetSelectedDate(date))">
                    <span>@date.ToString("dddd")</span>
                    <strong>@date.ToString("dd MMM")</strong>
                    @if (isHoliday)
                    {
                        var onlineClassCount = DaySessionCount(date);
                        if (onlineClassCount > 0)
                        {
                            <small style="color:#0284c7; font-weight:800; background:#e0f2fe; padding:2px 8px; border-radius:6px;">🏖️ Holiday (@onlineClassCount Online)</small>
                        }
                        else
                        {
                            <small style="color:#dc2626; font-weight:800; background:#fee2e2; padding:2px 8px; border-radius:6px;">🏖️ HOLIDAY</small>
                        }
                    }
                    else
                    {
                        <small>@(DaySessionCount(date) > 0 ? $"{DaySessionCount(date)} classes" : "0 classes")</small>
                    }
                </MudButton>
            }
        </div>
    </section>

    <section class="selected-day-banner">
        <span class="selected-day-banner__icon"><MudIcon Icon="@Icons.Material.Filled.EventNote" /></span>
        <div>
            <span>Selected date</span>
            <strong>@_selectedDate.ToString("dddd, dd MMMM yyyy")</strong>
        </div>
        <MudDatePicker Date="@_selectedDate" DateChanged="SelectCustomDate" Label="Choose another date" Variant="Variant.Outlined" Margin="Margin.Dense" Class="selected-day-banner__picker" DateFormat="dd/MM/yyyy" AutoClose="true" ShowToolbar="false" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" />
        @if (CanSubmitDay)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.TaskAlt"
                       OnClick="OpenSubmitDayDialog" Class="selected-day-banner__submit">
                Submit completed day
            </MudButton>
        }
        else if (ConductedDaySessionCount > 0)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Payments"
                       Href="@($"/payment-overview?date={_selectedDate:yyyy-MM-dd}")" Class="selected-day-banner__submit"
                       Style="font-weight:700;">
                View in Billing (₹@DayPaymentTotal.ToString("N0"))
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.TaskAlt"
                       Disabled="true" Class="selected-day-banner__submit">
                No classes to submit
            </MudButton>
        }
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.EventBusy"
                   OnClick="OpenDeclareHolidayDialog"
                   Class="selected-day-banner__holiday-btn"
                   Style="background:#dc2626 !important; color:#ffffff !important; font-weight:800; box-shadow: 0 4px 14px rgba(220, 38, 38, 0.4);">
            @(IsHolidayDate(_selectedDate) ? "Manage Holiday / Restore" : "Declare Holiday / Remove Day")
        </MudButton>
    </section>

    @if (GetHolidayName(_selectedDate) is string holidayName)
    {
        <MudPaper Elevation="0" Class="p-3 mb-3 d-flex align-center justify-space-between flex-wrap gap-2"
                  Style="background:#fff1f2; border:1px solid #fecdd3; border-radius:12px;">
            <div class="d-flex align-center gap-3">
                <div style="background:#ffe4e6; padding:8px; border-radius:10px; display:grid; place-items:center;">
                    <MudIcon Icon="@Icons.Material.Filled.BeachAccess" Style="color:#e11d48;" />
                </div>
                <div>
                    <span style="font-weight:800; color:#9f1239; font-size:0.92rem;">Academic Holiday: @holidayName (@_selectedDate.ToString("dd MMMM yyyy"))</span>
                    <div style="font-size:0.75rem; color:#be123c;">
                        Campus classes suspended. Did a faculty conduct an online lecture? Record it below to credit their workload & payment.
                    </div>
                </div>
            </div>
            <div class="d-flex align-center gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.VideoCall"
                           OnClick="@(() => OpenOnlineLectureDialogForDate(_selectedDate, holidayName))"
                           Style="font-weight:700; text-transform:none;">
                    + Add Online Lecture on this Holiday
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Restore"
                           OnClick="@(() => RevokeHolidayDirectAsync(_selectedDate))"
                           Style="font-weight:700; text-transform:none; border-color:#f43f5e; color:#e11d48;">
                    Restore Day
                </MudButton>
            </div>
        </MudPaper>
    }

    <MudTabs @bind-ActivePanelIndex="_activeTab" Class="weekend-desk-tabs" Rounded="true" Elevation="0">
        <MudTabPanel Text="Timetable plan" Icon="@Icons.Material.Filled.CalendarMonth">
            <div class="timetable-plan-callout">
                <div class="timetable-plan-callout__icon"><MudIcon Icon="@Icons.Material.Filled.CalendarMonth" /></div>
                <div>
                    <MudText Typo="Typo.subtitle1">Classes planned for @_selectedDate.ToString("dddd, dd MMM")</MudText>
                    <MudText Typo="Typo.body2">Prepare this day from the timetable, then edit any professor, subject, time, or class type. When every class is complete, submit the day to update attendance, reports, and payments.</MudText>
                </div>
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudSelect T="int" Value="@_selectedTimetableVersion" ValueChanged="OnTimetableVersionChanged" Label="Timetable Model" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="min-width: 290px; background: white;">
                        <MudSelectItem Value="1">Official AY 2026-27 (Fri–Sun, 26 Hrs)</MudSelectItem>
                        <MudSelectItem Value="2">Official Academic (Thu–Sun, 28 Hrs)</MudSelectItem>
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Class="btn-gradient-primary" StartIcon="@Icons.Material.Filled.AddTask" OnClick="PrepareTimetableDay">
                        Prepare this day
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CalendarViewMonth" OnClick="@(() => _fullScheduleDialogVisible = true)">
                        View Full Schedule
                    </MudButton>
                </div>
                <div class="d-flex align-center gap-1 mt-2 flex-wrap">
                    <span style="font-size:0.75rem; font-weight:700; color:#64748b; margin-right:4px;">Day Schedule:</span>
                    <MudChip T="int" Size="Size.Small" Variant="@(_overrideDayPlanIndex == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" OnClick="@(() => _overrideDayPlanIndex = 0)">
                        Auto by Date @(_selectedDate.Date >= new DateTime(2026, 9, 4) && _selectedDate.Date <= new DateTime(2026, 9, 6) ? "(04–06 Sep · Old 26h Timetable)" : "")
                    </MudChip>
                    <MudChip T="int" Size="Size.Small" Variant="@(_overrideDayPlanIndex == 1 ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" OnClick="@(() => _overrideDayPlanIndex = 1)">
                        Day 1 (Friday)
                    </MudChip>
                    <MudChip T="int" Size="Size.Small" Variant="@(_overrideDayPlanIndex == 2 ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" OnClick="@(() => _overrideDayPlanIndex = 2)">
                        Day 2 (Saturday)
                    </MudChip>
                    <MudChip T="int" Size="Size.Small" Variant="@(_overrideDayPlanIndex == 3 ? Variant.Filled : Variant.Outlined)" Color="Color.Secondary" OnClick="@(() => _overrideDayPlanIndex = 3)">
                        Day 3 (Sunday)
                    </MudChip>
                </div>
                @if (_daySessions.Any())
                {
                    <div class="timetable-payment-preview">
                        <span>Day payment</span>
                        <strong>₹@DayPaymentTotal.ToString("N0")</strong>
                        <small>after submission</small>
                    </div>
                }
            </div>

            @if (TimetablePlanForSelectedDate.Any())
            {
                <div class="timetable-plan-grid">
                    @foreach (var plan in TimetablePlanForSelectedDate)
                    {
                        var session = FindPlannedSession(plan);
                        var isCancelled = session?.Status == SessionStatus.Cancelled;
                        var isConducted = session?.Status == SessionStatus.Conducted;
                        var isScheduled = session?.Status == SessionStatus.Scheduled;

                        <MudPaper Elevation="0" Class="@($"timetable-plan-card {(isCancelled ? "timetable-plan-card--cancelled" : "")}")"
                                  Style="@(isCancelled ? "border: 1.5px dashed #fca5a5 !important; background: #fff8f8 !important; opacity: 0.9;" : "")">
                            <div class="timetable-plan-card__topline">
                                <span class="@($"type-pill type-pill--{(session?.SessionType ?? plan.SessionType).ToLowerInvariant()}")">@(session?.SessionType ?? plan.SessionType)</span>
                                @if (session is null)
                                {
                                    <span class="attendance-status">Not prepared</span>
                                }
                                else if (isCancelled)
                                {
                                    <span class="attendance-status" style="background:#fee2e2; color:#b91c1c; font-weight:800; border:1px solid #fecaca;">
                                        <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Style="font-size:0.8rem; vertical-align:text-bottom; margin-right:2px;" />
                                        Removed
                                    </span>
                                }
                                else if (isConducted)
                                {
                                    <span class="attendance-status attendance-status--done">Conducted</span>
                                }
                                else
                                {
                                    <span class="attendance-status">Planned</span>
                                }
                            </div>
                            <MudText Typo="Typo.subtitle1" Style="@(isCancelled ? "text-decoration:line-through; color:#94a3b8;" : "")">
                                @(session?.Course.CourseName ?? plan.CourseName)
                            </MudText>
                            <div class="d-flex align-center flex-wrap gap-1">
                                <MudText Typo="Typo.body2" Style="@(isCancelled ? "color:#94a3b8;" : "")">
                                    @(session?.Faculty.FullName ?? plan.FacultyLabel)
                                </MudText>
                                @if ((session?.Course.CourseCode ?? plan.CourseCode) == "MEC51050")
                                {
                                    <span class="status-pill" style="background:#fef3c7; color:#92400e; border:1px solid #fde68a; font-size:0.65rem; font-weight:800; padding:1px 6px;">
                                        50-50 RM Split (Hambarde & Gutte)
                                    </span>
                                }
                            </div>
                            <div class="timetable-plan-card__footer">
                                <div>
                                    <span>@FormatTime(plan.StartTime) – @FormatTime(plan.EndTime)</span>
                                    @if (session is not null)
                                    {
                                        if (isCancelled)
                                        {
                                            <small style="color:#ef4444; font-weight:700;">₹0 (Removed from payment)</small>
                                        }
                                        else if ((session.Course?.CourseCode ?? plan.CourseCode) == "MEC51050")
                                        {
                                            var totalAmt = GetSessionPaymentAmount(session.Id);
                                            <small class="timetable-plan-card__payment">₹@totalAmt.ToString("N0") payment (50-50 Split: ₹@((totalAmt * 0.5m).ToString("N0")) each)</small>
                                        }
                                        else
                                        {
                                            <small class="timetable-plan-card__payment">₹@GetSessionPaymentAmount(session.Id).ToString("N0") payment</small>
                                        }
                                    }
                                </div>
                                <div class="d-flex align-center gap-1">
                                    @if (session is not null && !isCancelled)
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Edit"
                                                   OnClick="@(() => OpenEditSession(session))">
                                            Edit
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.DeleteOutline"
                                                   OnClick="@(() => OpenRemoveSpecificClassDialog(session, plan))"
                                                   Style="font-weight:700; text-transform:none;">
                                            Remove
                                        </MudButton>
                                    }
                                    else if (isCancelled)
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Restore"
                                                   OnClick="@(() => RestoreSpecificClass(session!, plan))"
                                                   Style="font-weight:700; text-transform:none; font-size:0.75rem;">
                                            Restore
                                        </MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Add"
                                                   OnClick="@(() => PrepareSingleClass(plan))"
                                                   Style="font-weight:700; text-transform:none;">
                                            Prepare
                                        </MudButton>
                                        <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.RemoveCircleOutline"
                                                   OnClick="@(() => ExcludeSingleClass(plan))"
                                                   Style="font-weight:700; text-transform:none;">
                                            Remove / Skip
                                        </MudButton>
                                    }
                                </div>
                            </div>
                        </MudPaper>
                    }
                </div>
            }
            else
            {
                @if (_selectedTimetableVersion == 1 && _selectedDate.DayOfWeek == DayOfWeek.Thursday)
                {
                    <div class="weekend-desk-empty" style="background:#f8fafc; border:1px solid #cbd5e1; border-radius:12px; padding:28px 20px;">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Size="Size.Large" />
                        <div>
                            <MudText Typo="Typo.subtitle1" Style="font-weight:800; color:#1e293b;">
                                Thursday is not an instructional day in the AY 2026-27 Sem-I (26 Hrs) timetable
                            </MudText>
                            <MudText Typo="Typo.body2" Style="color:#64748b; max-width:620px; margin:6px auto 16px;">
                                The AY 2026-27 Sem-I timetable runs strictly on <b>Friday, Saturday, and Sunday (26 instructional hours)</b>. Thursday teaching was scheduled under the <b>AY 2026-27 Official Academic model (28 hours)</b>.
                            </MudText>
                            <div class="d-flex justify-center gap-2 flex-wrap">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowForward"
                                           OnClick="@(() => SetSelectedDate(_weekendStart.AddDays(1)))">
                                    View Friday, @_weekendStart.AddDays(1).ToString("dd MMM") (Friday Classes)
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.SwapHoriz"
                                           OnClick="@(() => OnTimetableVersionChanged(2))">
                                    Switch to Official Model (Thu–Sun)
                                </MudButton>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CalendarViewMonth"
                                           OnClick="@(() => _fullScheduleDialogVisible = true)">
                                    View Full Schedule
                                </MudButton>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="weekend-desk-empty">
                        <MudIcon Icon="@Icons.Material.Filled.EventBusy" />
                        <div>
                            <MudText Typo="Typo.subtitle1">No timetable is set for this date</MudText>
                            <MudText Typo="Typo.body2">Choose Friday, Saturday, or Sunday to load the weekend timetable.</MudText>
                        </div>
                        <div class="mt-2">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CalendarViewMonth"
                                       OnClick="@(() => _fullScheduleDialogVisible = true)">
                                View Full Timetable Schedule
                            </MudButton>
                        </div>
                    </div>
                }
            }
        </MudTabPanel>

        <MudTabPanel Text="Class log" Icon="@Icons.Material.Filled.AddTask">
            <div class="weekend-workflow-callout">
                <div class="weekend-workflow-callout__icon"><MudIcon Icon="@Icons.Material.Filled.NightlightRound" /></div>
                <div>
                    <MudText Typo="Typo.subtitle1">Nightly class entry</MudText>
                    <MudText Typo="Typo.body2">Add every lecture or practical that was actually conducted. You can use any professor, subject, and class type—nothing is locked to the timetable.</MudText>
                </div>
                <div class="d-flex align-center gap-2">
                    <MudButton Variant="Variant.Filled" Class="btn-gradient-primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenLogDialog">Add a class</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.VideoCall" OnClick="@(() => OpenOnlineLectureDialogForDate(_selectedDate, GetHolidayName(_selectedDate)))">Add Online Class</MudButton>
                </div>
            </div>

            @if (_daySessions.Any())
            {
                <div class="simple-table weekend-class-log-table">
                    <MudDataGrid Items="@_daySessions" Dense="true" Hover="true" Elevation="0">
                        <Columns>
                            <TemplateColumn Title="Professor">
                                <CellTemplate>
                                    <MudText Typo="Typo.subtitle2">@context.Item.Faculty.FullName</MudText>
                                    @if (!string.IsNullOrWhiteSpace(context.Item.Notes))
                                    {
                                        <MudText Typo="Typo.caption" Style="color:#64748b;">@context.Item.Notes</MudText>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Class type & Mode">
                                <CellTemplate>
                                    <div class="d-flex align-center flex-wrap gap-1">
                                        <span class="@($"type-pill type-pill--{context.Item.SessionType.ToLowerInvariant()}")">@context.Item.SessionType</span>
                                        @if (context.Item.IsOnline)
                                        {
                                            <span class="status-pill" style="background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd; font-size:0.7rem; font-weight:700;">
                                                <MudIcon Icon="@Icons.Material.Filled.Videocam" Size="Size.Small" Style="font-size:0.85rem; vertical-align:text-bottom; margin-right:2px;" />
                                                Online @(!string.IsNullOrEmpty(context.Item.MeetingPlatform) ? $"({context.Item.MeetingPlatform})" : "")
                                            </span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(context.Item.MeetingLink))
                                    {
                                        <a href="@context.Item.MeetingLink" target="_blank" style="font-size:0.7rem; color:#2563eb; display:inline-flex; align-items:center; gap:2px; margin-top:2px; text-decoration:underline;">
                                            <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Style="font-size:0.75rem;" /> Join Link
                                        </a>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="x => x.Course.CourseName" Title="Subject" />
                            <TemplateColumn Title="Status">
                                <CellTemplate>
                                    <span class="@(context.Item.Status == SessionStatus.Conducted ? "attendance-status attendance-status--done" : "attendance-status")">
                                        @(context.Item.Status == SessionStatus.Conducted ? "Conducted" : "Planned")
                                    </span>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Attendance">
                                <CellTemplate>
                                    @{ var attendance = GetAttendanceSummary(context.Item.Id); }
                                    @if (attendance?.IsAttendanceMarked == true)
                                    {
                                        <span class="attendance-count"><MudIcon Icon="@Icons.Material.Filled.Groups" /> @attendance.PresentCount/@attendance.StudentCount present</span>
                                    }
                                    else
                                    {
                                        <span class="attendance-pending">Not marked</span>
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="">
                                <CellTemplate>
                                    @if (context.Item.Status != SessionStatus.Conducted)
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@(() => MarkConducted(context.Item.Id))">Conducted</MudButton>
                                    }
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                                   OnClick="@(() => OpenEditSession(context.Item))" aria-label="Edit class" />
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Default"
                                                   OnClick="@(() => DeleteSession(context.Item.Id))" aria-label="Remove class" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                </div>
            }
            else
            {
                <div class="weekend-desk-empty">
                    <MudIcon Icon="@Icons.Material.Filled.AutoStories" />
                    <div>
                        <MudText Typo="Typo.subtitle1">No classes recorded for this date</MudText>
                        <MudText Typo="Typo.body2">When the day is over, add the lectures and practicals that were conducted.</MudText>
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenLogDialog">Add a class</MudButton>
                </div>
            }
        </MudTabPanel>

        <MudTabPanel Text="Student attendance" Icon="@Icons.Material.Filled.FactCheck">
            <div class="attendance-section-heading">
                <div>
                    <span class="premium-eyebrow">Student register</span>
                    <MudText Typo="Typo.h6">Mark attendance by class</MudText>
                    <MudText Typo="Typo.body2">Open a class, then untick the students who were absent. The present count feeds straight into the night report.</MudText>
                </div>
                <span class="status-pill attendance-section-heading__count">@_attendanceSummaries.Count(summary => summary.IsAttendanceMarked) of @_attendanceSummaries.Count marked</span>
            </div>

            @if (_attendanceSummaries.Any())
            {
                <div class="attendance-session-grid">
                    @foreach (var summary in _attendanceSummaries)
                    {
                        <MudPaper Elevation="0" Class="attendance-session-card">
                            <div class="attendance-session-card__topline">
                                <span class="@($"type-pill type-pill--{summary.SessionType.ToLowerInvariant()}")">@summary.SessionType</span>
                                <span class="@(summary.IsAttendanceMarked ? "attendance-status attendance-status--done" : "attendance-status")">
                                    @(summary.IsAttendanceMarked ? "Attendance saved" : "To be marked")
                                </span>
                            </div>
                            <MudText Typo="Typo.subtitle1">@summary.CourseName</MudText>
                            <MudText Typo="Typo.body2">@summary.FacultyName</MudText>
                            <div class="attendance-session-card__footer">
                                @if (summary.IsAttendanceMarked)
                                {
                                    <span class="attendance-count"><MudIcon Icon="@Icons.Material.Filled.Groups" /> @summary.PresentCount of @summary.StudentCount present</span>
                                }
                                else
                                {
                                    <span class="attendance-pending">Register not saved</span>
                                }
                                <MudButton Variant="@(summary.IsAttendanceMarked ? Variant.Outlined : Variant.Filled)" Color="Color.Primary"
                                           Class="@(summary.IsAttendanceMarked ? string.Empty : "btn-gradient-primary")"
                                           StartIcon="@(summary.IsAttendanceMarked ? Icons.Material.Filled.Edit : Icons.Material.Filled.FactCheck)"
                                           OnClick="@(() => OpenAttendanceDialog(summary))">
                                    @(summary.IsAttendanceMarked ? "Edit" : "Mark")
                                </MudButton>
                            </div>
                        </MudPaper>
                    }
                </div>
            }
            else
            {
                <div class="weekend-desk-empty">
                    <MudIcon Icon="@Icons.Material.Filled.FactCheck" />
                    <div>
                        <MudText Typo="Typo.subtitle1">Attendance becomes available after class entry</MudText>
                        <MudText Typo="Typo.body2">Add the lecture or practical first, then its student register will appear here.</MudText>
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => _activeTab = 1)">Go to class log</MudButton>
                </div>
            }
        </MudTabPanel>

        <MudTabPanel Text="Night report" Icon="@Icons.Material.Filled.Assessment">
            <section class="night-report-hero">
                <div>
                    <span class="premium-eyebrow">Live report · @(_selectedDate.ToString("ddd, dd MMM"))</span>
                    <MudText Typo="Typo.h5">Faculty activity report</MudText>
                    <MudText Typo="Typo.body2">A clear end-of-day summary of who conducted lectures and practicals, plus the students recorded as present.</MudText>
                </div>
                <div class="night-report-hero__total">
                    <span>Students attended</span>
                    <strong>@_nightReport.Sum(row => row.TotalAttendance)</strong>
                    <small>across all saved registers</small>
                </div>
            </section>

            @if (_nightReport.Any())
            {
                <div class="simple-table night-report-table">
                    <MudDataGrid Items="@_nightReport" Dense="true" Hover="true" Elevation="0">
                        <Columns>
                            <PropertyColumn Property="x => x.FacultyName" Title="Professor" />
                            <TemplateColumn Title="Conducted">
                                <CellTemplate>
                                    <span class="class-count"><b>@context.Item.LectureCount</b> lectures · <b>@context.Item.PracticalCount</b> practicals</span>
                                </CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Lecture attendance">
                                <CellTemplate><span class="attendance-count">@context.Item.LectureAttendance students</span></CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Practical attendance">
                                <CellTemplate><span class="attendance-count">@context.Item.PracticalAttendance students</span></CellTemplate>
                            </TemplateColumn>
                            <TemplateColumn Title="Register status">
                                <CellTemplate>
                                    <span class="@(context.Item.SessionsWithAttendance == context.Item.LectureCount + context.Item.PracticalCount ? "attendance-status attendance-status--done" : "attendance-status")">
                                        @context.Item.SessionsWithAttendance/@(context.Item.LectureCount + context.Item.PracticalCount) saved
                                    </span>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </MudDataGrid>
                </div>
            }
            else
            {
                <div class="weekend-desk-empty">
                    <MudIcon Icon="@Icons.Material.Filled.Assessment" />
                    <div>
                        <MudText Typo="Typo.subtitle1">Your night report will appear here</MudText>
                        <MudText Typo="Typo.body2">Record a class for this date to start building the faculty report.</MudText>
                    </div>
                </div>
            }
        </MudTabPanel>

    </MudTabs>
</MudContainer>

<MudDialog @bind-Visible="_logDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <div class="dialog-title-simple">
            <span class="dialog-title-simple__icon dialog-title-simple__icon--blue"><MudIcon Icon="@Icons.Material.Filled.AddTask" /></span>
            <div>
                <MudText Typo="Typo.h6">@(_editingSessionId.HasValue ? "Edit timetable class" : "Record conducted class")</MudText>
                <MudText Typo="Typo.caption">@(_editingSessionId.HasValue ? "Update the actual professor, subject, time, or class type. Changes are reflected throughout Weekend Desk." : "Add what actually happened today—lecture or practical.")</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <div class="d-flex align-center justify-space-between p-2 rounded" style="background:#f1f5f9; border:1px solid #cbd5e1;">
                    <span style="font-weight:700; font-size:0.8rem; color:#1e293b;">Delivery Mode:</span>
                    <MudRadioGroup @bind-Value="_newSessionIsOnline">
                        <MudRadio Value="false" Color="Color.Default" Dense="true">🏫 In-Person (Classroom)</MudRadio>
                        <MudRadio Value="true" Color="Color.Primary" Dense="true">🌐 Online Lecture</MudRadio>
                    </MudRadioGroup>
                </div>
            </MudItem>

            @if (_newSessionIsOnline)
            {
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_newSessionPlatform" Label="Online Platform" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                        <MudSelectItem Value="@("Microsoft Teams")">Microsoft Teams</MudSelectItem>
                        <MudSelectItem Value="@("Google Meet")">Google Meet</MudSelectItem>
                        <MudSelectItem Value="@("Zoom")">Zoom</MudSelectItem>
                        <MudSelectItem Value="@("Webex")">Webex</MudSelectItem>
                        <MudSelectItem Value="@("Virtual Classroom")">Virtual Classroom</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_newSessionMeetingLink" Label="Meeting Link / URL (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Link" Placeholder="https://teams.microsoft.com/..." />
                </MudItem>
            }

            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_newSessionDate" Label="Class date" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" AutoClose="true" ShowToolbar="false" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_newSessionType" Label="Class type" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                    <MudSelectItem Value="@("Lecture")">Lecture</MudSelectItem>
                    <MudSelectItem Value="@("Tutorial")">Tutorial</MudSelectItem>
                    <MudSelectItem Value="@("Practical")">Practical</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSelect @bind-Value="_newSessionFacultyId" Label="Professor" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                    @foreach (var faculty in _faculty.Where(faculty => faculty.IsActive))
                    {
                        <MudSelectItem Value="@faculty.Id">@faculty.FullName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudSelect @bind-Value="_newSessionCourseId" Label="Subject" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true">
                    @foreach (var course in _courses)
                    {
                        <MudSelectItem Value="@course.Id">@course.CourseCode — @course.CourseName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6">
                <MudTimePicker @bind-Time="_newSessionStart" Label="Start time" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6">
                <MudTimePicker @bind-Time="_newSessionEnd" Label="End time" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>
        <MudTextField @bind-Value="_newSessionNotes" Label="Notes (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Class="mt-2" />
    </DialogContent>
    <DialogActions>
        @if (_editingSessionId.HasValue)
        {
            <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteOutline"
                       OnClick="DeleteSessionFromEditDialog" Style="margin-right:auto; font-weight:700; text-transform:none;">
                Remove this class
            </MudButton>
        }
        <MudButton OnClick="@(() => _logDialogVisible = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Class="btn-gradient-primary" OnClick="SaveSession">@(_editingSessionId.HasValue ? "Save changes" : "Save class")</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_submitDayDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <div class="dialog-title-simple">
            <span class="dialog-title-simple__icon dialog-title-simple__icon--green"><MudIcon Icon="@Icons.Material.Filled.TaskAlt" /></span>
            <div>
                <MudText Typo="Typo.h6">Submit completed day</MudText>
                <MudText Typo="Typo.caption">@_selectedDate.ToString("dddd, dd MMMM yyyy")</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="attendance-dialog-note">
            <MudIcon Icon="@Icons.Material.Filled.Info" />
            <span>This confirms @PlannedDaySessionCount planned class(es) as conducted. The night report and Payment Overview will update immediately.</span>
        </div>
        <MudText Typo="Typo.body2" Class="mt-3">Already recorded: <b>@ConductedDaySessionCount</b> conducted class(es). You can still correct a class later if needed.</MudText>
        <div class="submit-day-payment-total">
            <span>Payment for @_selectedDate.ToString("dd MMM")</span>
            <strong>₹@DayPaymentTotal.ToString("N0")</strong>
        </div>
        <div class="submit-day-payment-list">
            @foreach (var payment in DayPaymentSummary)
            {
                <div>
                    <span>@payment.FacultyName @(payment.HasRmSplit ? "(50-50 RM Split)" : "") · @payment.LectureCount.ToString("0.#") lectures · @payment.PracticalCount.ToString("0.#") practicals</span>
                    <strong>₹@payment.Amount.ToString("N0")</strong>
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _submitDayDialogVisible = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.TaskAlt" OnClick="SubmitCompletedDay">Submit day</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_attendanceDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <div class="dialog-title-simple">
            <span class="dialog-title-simple__icon dialog-title-simple__icon--green"><MudIcon Icon="@Icons.Material.Filled.FactCheck" /></span>
            <div>
                <MudText Typo="Typo.h6">Student attendance</MudText>
                <MudText Typo="Typo.caption">@_attendanceSession?.CourseName · @_attendanceSession?.SessionType · @_attendanceSession?.FacultyName</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="attendance-dialog-note">
            <MudIcon Icon="@Icons.Material.Filled.Info" />
            <span>All active students are selected by default. Untick anyone who was absent, then save the register.</span>
        </div>
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3 mb-2">
            <MudText Typo="Typo.subtitle2">@PresentStudentCount of @_attendanceStudents.Count marked present</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="MarkAllPresent">Mark all present</MudButton>
        </MudStack>
        <div class="attendance-checklist">
            @foreach (var student in _attendanceStudents)
            {
                <div class="attendance-checklist__row">
                    <MudCheckBox @bind-Value="student.IsPresent" Color="Color.Primary" />
                    <div>
                        <MudText Typo="Typo.subtitle2">@student.FullName</MudText>
                        <MudText Typo="Typo.caption">@student.StudentCode</MudText>
                    </div>
                    <span class="@(student.IsPresent ? "attendance-status attendance-status--done" : "attendance-status")">@(student.IsPresent ? "Present" : "Absent")</span>
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _attendanceDialogVisible = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Class="btn-gradient-primary" OnClick="SaveAttendance">Save attendance</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_fullScheduleDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <div class="dialog-title-simple">
            <span class="dialog-title-simple__icon dialog-title-simple__icon--blue">
                <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" />
            </span>
            <div>
                <MudText Typo="Typo.h6">@(_selectedTimetableVersion == 1 ? "Official AY 2026-27 Timetable (Fri–Sun, 26 Hrs)" : "Official Academic Timetable (Thu–Sun, 28 Hrs)")</MudText>
                <MudText Typo="Typo.caption">Full instructional schedule across all teaching days</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-3 p-2 rounded" style="background:#f1f5f9; border:1px solid #cbd5e1;">
            <span style="font-weight:700; font-size:0.82rem; color:#1e293b;">Switch Model:</span>
            <MudRadioGroup T="int" Value="@_selectedTimetableVersion" ValueChanged="OnTimetableVersionChanged">
                <MudRadio Value="1" Color="Color.Primary" Dense="true">AY 2026-27 Sem-I (Fri–Sun, 26 Hrs)</MudRadio>
                <MudRadio Value="2" Color="Color.Secondary" Dense="true">Official Academic (Thu–Sun, 28 Hrs)</MudRadio>
            </MudRadioGroup>
        </div>

        <MudTabs Rounded="true" Elevation="0" ApplyEffectsToContainer="true">
            @foreach (var dayGroup in (_selectedTimetableVersion == 1 ? WeekendTimetable : OfficialSem1Timetable).GroupBy(x => x.Day).OrderBy(g => g.Key == DayOfWeek.Thursday ? 0 : g.Key == DayOfWeek.Friday ? 1 : g.Key == DayOfWeek.Saturday ? 2 : 3))
            {
                <MudTabPanel Text="@($"{dayGroup.Key} ({dayGroup.Count()} classes)")">
                    <div class="simple-table mt-2">
                        <MudTable Items="@dayGroup" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Time</MudTh>
                                <MudTh>Subject</MudTh>
                                <MudTh>Class Type</MudTh>
                                <MudTh>Faculty</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd><b>@FormatTime(context.StartTime) – @FormatTime(context.EndTime)</b></MudTd>
                                <MudTd>
                                    <div>@context.CourseName</div>
                                    <small style="color:#64748b;">@context.CourseCode</small>
                                </MudTd>
                                <MudTd>
                                    <span class="@($"type-pill type-pill--{context.SessionType.ToLowerInvariant()}")">@context.SessionType</span>
                                </MudTd>
                                <MudTd>@context.FacultyLabel</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                </MudTabPanel>
            }
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Class="btn-gradient-primary" OnClick="@(() => _fullScheduleDialogVisible = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_declareHolidayDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <div style="background:#fee2e2; border-radius:10px; width:38px; height:38px; display:grid; place-items:center;">
                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Style="color:#dc2626;" />
            </div>
            <div>
                <MudText Typo="Typo.h6" Style="font-weight:800; color:#0f172a;">Declare Holiday or Remove Day</MudText>
                <div style="font-size:0.8rem; color:#64748b;">Selected Date: <b>@_selectedDate.ToString("dddd, dd MMMM yyyy")</b></div>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-3 pt-2">
            @if (IsHolidayDate(_selectedDate))
            {
                <MudPaper Elevation="0" Class="p-3 d-flex align-center justify-space-between flex-wrap gap-2"
                          Style="background:#fef2f2; border:1.5px solid #fecaca; border-radius:12px;">
                    <div>
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.BeachAccess" Style="color:#dc2626;" Size="Size.Small" />
                            <span style="font-weight:800; color:#991b1b; font-size:0.95rem;">Current Status: Declared Holiday</span>
                        </div>
                        <div style="font-size:0.85rem; color:#b91c1c; margin-top:2px;">
                            Title: <b>@GetHolidayName(_selectedDate)</b> · Campus classes suspended
                        </div>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Restore"
                               OnClick="@(() => RevokeHolidayDirectAsync(_selectedDate))"
                               Style="font-weight:700; text-transform:none;">
                        Restore Regular Teaching Day
                    </MudButton>
                </MudPaper>
            }

            <MudPaper Elevation="0" Class="p-3" Style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px;">
                <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                        <MudButton Color="Color.Error" Variant="@(_holidayDialogMode == 0 ? Variant.Filled : Variant.Outlined)"
                                   OnClick="@(() => _holidayDialogMode = 0)" Style="font-weight:700; text-transform:none;">
                            🏖️ Declare as Holiday
                        </MudButton>
                        <MudButton Color="Color.Dark" Variant="@(_holidayDialogMode == 1 ? Variant.Filled : Variant.Outlined)"
                                   OnClick="@(() => _holidayDialogMode = 1)" Style="font-weight:700; text-transform:none;">
                            🗑️ Remove Day / Clear Classes
                        </MudButton>
                    </MudButtonGroup>
                </div>

                @if (_holidayDialogMode == 0)
                {
                    <div class="d-flex flex-column gap-3 mt-2">
                        <MudTextField @bind-Value="_declareHolidayName" Label="Holiday Occasion / Reason" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" Placeholder="e.g. Ganesh Chaturthi, University Holiday, Local Festival" />

                        <div>
                            <span style="font-size:0.72rem; font-weight:800; color:#64748b; text-transform:uppercase;">Quick Presets:</span>
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => _declareHolidayName = "Ganesh Chaturthi")">Ganesh Chaturthi</MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => _declareHolidayName = "Gouri Poojan")">Gouri Poojan</MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => _declareHolidayName = "Anant Chaturdashi")">Anant Chaturdashi</MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => _declareHolidayName = "Gandhi Jayanti")">Gandhi Jayanti</MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => _declareHolidayName = "Diwali Vacation")">Diwali Vacation</MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => _declareHolidayName = "University Gazetted Holiday")">University Holiday</MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => _declareHolidayName = "Institutional / Local Holiday")">Local Holiday</MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@(() => _declareHolidayName = "Emergency Closure")">Emergency Closure</MudChip>
                            </div>
                        </div>

                        <MudTextField @bind-Value="_declareHolidayDesc" Label="Description / Circular Reference (Optional)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="e.g. Vice Chancellor circular or local district holiday" />

                        <div class="p-2" style="background:#fff; border:1px solid #e2e8f0; border-radius:8px;">
                            <MudCheckBox @bind-Value="_clearDayClassesOnHoliday" Color="Color.Error" Dense="true">
                                <span style="font-size:0.83rem; font-weight:600;">
                                    Clear & cancel physical timetable classes on this day (@_daySessions.Count(s => !s.IsOnline) scheduled classes)
                                </span>
                            </MudCheckBox>
                            <MudCheckBox @bind-Value="_removeOnlineClassesOnHoliday" Color="Color.Warning" Dense="true" Class="mt-1">
                                <span style="font-size:0.83rem; color:#64748b;">
                                    Also delete online lectures conducted on this day (@_daySessions.Count(s => s.IsOnline) online lectures)
                                </span>
                            </MudCheckBox>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3 mt-2">
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="my-1">
                            This will remove all classes logged or scheduled for <b>@_selectedDate.ToString("dddd, dd MMMM yyyy")</b>. Total classes will be reset to 0.
                        </MudAlert>

                        <div class="d-flex align-center justify-space-between p-2" style="background:#fff; border:1px solid #e2e8f0; border-radius:8px;">
                            <div>
                                <span style="font-size:0.85rem; font-weight:700; color:#0f172a;">Current Classes on this Date:</span>
                                <div style="font-size:0.75rem; color:#64748b;">Physical: @_daySessions.Count(s => !s.IsOnline) · Online: @_daySessions.Count(s => s.IsOnline)</div>
                            </div>
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Style="font-weight:800;">
                                @_daySessions.Count classes (@_daySessions.Sum(s => s.DurationHours) Hrs)
                            </MudChip>
                        </div>

                        <div class="p-2" style="background:#fff; border:1px solid #e2e8f0; border-radius:8px;">
                            <MudCheckBox @bind-Value="_markAsExcludedNonTeachingDay" Color="Color.Error" Dense="true">
                                <span style="font-size:0.83rem; font-weight:700; color:#991b1b;">
                                    Mark this date as an Excluded / Non-Teaching Day (shows on calendar & timetable)
                                </span>
                            </MudCheckBox>
                            <MudCheckBox @bind-Value="_removeOnlineClassesOnHoliday" Color="Color.Warning" Dense="true" Class="mt-1">
                                <span style="font-size:0.83rem; color:#64748b;">
                                    Also delete online lectures if any exist on this date
                                </span>
                            </MudCheckBox>
                        </div>
                    </div>
                }
            </MudPaper>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => _declareHolidayDialogVisible = false)">Cancel</MudButton>
        @if (_holidayDialogMode == 0)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.EventBusy"
                       OnClick="ConfirmDeclareHolidayAsync"
                       Style="font-weight:800; background:#dc2626 !important; color:#fff !important; text-transform:none;">
                Confirm & Declare Holiday
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.DeleteForever"
                       OnClick="ConfirmRemoveDayAsync"
                       Style="font-weight:800; background:#dc2626 !important; color:#fff !important; text-transform:none;">
                Remove All Classes for This Day
            </MudButton>
        }
    </DialogActions>
</MudDialog>

<MudDialog @bind-Visible="_removeSessionDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <div style="background:#fee2e2; border-radius:10px; width:38px; height:38px; display:grid; place-items:center;">
                <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Style="color:#dc2626;" />
            </div>
            <div>
                <MudText Typo="Typo.h6" Style="font-weight:800; color:#0f172a;">Remove Lecture / Practical</MudText>
                <div style="font-size:0.8rem; color:#64748b;">Schedule & Payment Adjustment (@_selectedDate.ToString("dd MMM yyyy"))</div>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_sessionToRemove is not null || _planToRemove is not null)
        {
            var title = _sessionToRemove?.Course?.CourseName ?? _planToRemove?.CourseName ?? "";
            var courseCode = _sessionToRemove?.Course?.CourseCode ?? _planToRemove?.CourseCode ?? "";
            var fac = _sessionToRemove?.Faculty?.FullName ?? _planToRemove?.FacultyLabel ?? "";
            var type = _sessionToRemove?.SessionType ?? _planToRemove?.SessionType ?? "Class";
            var start = _sessionToRemove?.ActualStartTime ?? _planToRemove?.StartTime ?? TimeSpan.Zero;
            var end = _sessionToRemove?.ActualEndTime ?? _planToRemove?.EndTime ?? TimeSpan.Zero;
            var pay = _removeImpactAmount > 0 ? _removeImpactAmount : 1200m;

            <div class="d-flex flex-column gap-3 pt-1">
                <MudPaper Elevation="0" Class="p-3" Style="background:#fef2f2; border:1px solid #fecaca; border-radius:10px;">
                    <div class="d-flex align-center justify-space-between mb-1">
                        <span class="@($"type-pill type-pill--{type.ToLowerInvariant()}")">@type</span>
                        <span style="font-weight:800; color:#b91c1c; font-size:0.88rem;">₹@pay.ToString("N0") Payment</span>
                    </div>
                    <MudText Typo="Typo.subtitle1" Style="font-weight:800; color:#0f172a; margin-top:4px;">@title</MudText>
                    <div style="font-size:0.82rem; color:#475569;">Professor: <b>@fac</b></div>
                    <div style="font-size:0.8rem; color:#64748b; margin-top:2px;">
                        Timing: <b>@FormatTime(start) – @FormatTime(end)</b> (@courseCode)
                    </div>
                </MudPaper>

                <MudAlert Severity="Severity.Warning" Dense="true">
                    Removing this class will deduct <b>₹@pay.ToString("N0")</b> from today's payment. It will not be counted in the faculty's payment overview or monthly payroll.
                </MudAlert>

                <div class="p-2" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px;">
                    <MudCheckBox @bind-Value="_permanentlyDeleteSession" Color="Color.Error" Dense="true">
                        <span style="font-size:0.82rem; color:#475569;">
                            Permanently delete from database (otherwise kept as Cancelled for 1-click restore)
                        </span>
                    </MudCheckBox>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => _removeSessionDialogVisible = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete"
                   OnClick="ConfirmRemoveSpecificClass"
                   Style="font-weight:800; background:#dc2626 !important; color:#fff !important; text-transform:none;">
            Confirm & Remove Class
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly List<Session> _daySessions = new();
    private Dictionary<DateTime, int> _weekendSessionCounts = new();
    private List<DailySessionAttendanceSummary> _attendanceSummaries = new();
    private List<FacultyNightReportRow> _nightReport = new();
    private List<SessionPaymentAmount> _sessionPaymentAmounts = new();
    private List<Faculty> _faculty = new();
    private List<Course> _courses = new();
    private DateTime _weekendStart = MostRecentThursday(DateTime.Today);
    private DateTime _selectedDate = DateTime.Today;
    private int _selectedTimetableVersion = 2; // Default: New Timetable (Thu–Sun, 28 Hrs); 4–6 Sep uses Old Timetable (Fri–Sun, 26 Hrs)
    private int _overrideDayPlanIndex = 0; // 0 = Auto by date, 1 = Day 1 (Friday), 2 = Day 2 (Saturday), 3 = Day 3 (Sunday)
    private int _activeTab;
    private bool _logDialogVisible;
    private bool _attendanceDialogVisible;
    private bool _submitDayDialogVisible;
    private bool _fullScheduleDialogVisible;
    private int? _editingSessionId;
    private DateTime? _newSessionDate;
    private int _newSessionFacultyId;
    private int _newSessionCourseId;
    private string _newSessionType = "Lecture";
    private TimeSpan? _newSessionStart;
    private TimeSpan? _newSessionEnd;
    private string? _newSessionNotes;
    private bool _newSessionIsOnline;
    private string _newSessionPlatform = "Microsoft Teams";
    private string? _newSessionMeetingLink;
    private DailySessionAttendanceSummary? _attendanceSession;
    private List<AttendanceStudentItem> _attendanceStudents = new();

    private Dictionary<DateTime, string> _holidays = new();
    private bool _declareHolidayDialogVisible;
    private int _holidayDialogMode = 0; // 0 = Declare Holiday, 1 = Remove Day / Clear Classes
    private string _declareHolidayName = "University Holiday";
    private string? _declareHolidayDesc;
    private bool _clearDayClassesOnHoliday = true;
    private bool _removeOnlineClassesOnHoliday = false;
    private bool _markAsExcludedNonTeachingDay = false;

    private bool _removeSessionDialogVisible;
    private Session? _sessionToRemove;
    private TimetablePlanItem? _planToRemove;
    private decimal _removeImpactAmount;
    private bool _permanentlyDeleteSession;

    private IEnumerable<DateTime> WeekendDates
    {
        get
        {
            // 4, 5, 6 September 2026 use the Old Fri–Sun 26h Timetable
            if (_weekendStart.Date == new DateTime(2026, 9, 3)
                || (_selectedDate.Date >= new DateTime(2026, 9, 4) && _selectedDate.Date <= new DateTime(2026, 9, 6)))
            {
                return new List<DateTime>
                {
                    new(2026, 9, 4), // Friday (04 Sep)
                    new(2026, 9, 5), // Saturday (05 Sep)
                    new(2026, 9, 6)  // Sunday (06 Sep)
                };
            }

            return Enumerable.Range(0, 4).Select(day => _weekendStart.AddDays(day));
        }
    }

    private IEnumerable<TimetablePlanItem> TimetablePlanForSelectedDate
    {
        get
        {
            if (_overrideDayPlanIndex == 1)
                return WeekendTimetable.Where(item => item.Day == DayOfWeek.Friday);
            if (_overrideDayPlanIndex == 2)
                return WeekendTimetable.Where(item => item.Day == DayOfWeek.Saturday);
            if (_overrideDayPlanIndex == 3)
                return WeekendTimetable.Where(item => item.Day == DayOfWeek.Sunday);

            // 4, 5, 6 September 2026 always use the Old Timetable (Official AY 2026-27 Fri–Sun 26 Hrs)
            if (_selectedDate.Date >= new DateTime(2026, 9, 4) && _selectedDate.Date <= new DateTime(2026, 9, 6))
            {
                return WeekendTimetable.Where(item => item.Day == _selectedDate.DayOfWeek);
            }

            return (_selectedTimetableVersion == 2 ? OfficialSem1Timetable : WeekendTimetable)
                .Where(item => item.Day == _selectedDate.DayOfWeek);
        }
    }
    private int PresentStudentCount => _attendanceStudents.Count(student => student.IsPresent);
    private int PlannedDaySessionCount => _daySessions.Count(session => session.Status == SessionStatus.Scheduled);
    private int ConductedDaySessionCount => _daySessions.Count(session => session.Status == SessionStatus.Conducted);
    private bool CanSubmitDay => PlannedDaySessionCount > 0;
    private decimal DayPaymentTotal => _sessionPaymentAmounts.Sum(item => item.Amount);
    private IReadOnlyList<DayFacultyPaymentSummary> DayPaymentSummary => _sessionPaymentAmounts
        .GroupBy(item => new { item.FacultyId, item.FacultyName })
        .Select(group => new DayFacultyPaymentSummary(
            group.Key.FacultyName,
            group.Where(item => item.SessionType is "Lecture" or "Tutorial").Sum(item => item.Units),
            group.Where(item => item.SessionType is not ("Lecture" or "Tutorial")).Sum(item => item.Units),
            group.Sum(item => item.Amount),
            group.Any(item => item.IsRmSplit)))
        .OrderBy(item => item.FacultyName)
        .ToList();
    private string SubmitDayButtonLabel => !_daySessions.Any()
        ? "No classes to submit"
        : CanSubmitDay ? "Submit completed day" : "Day submitted";
    private string WeekendLabel => (_weekendStart.Date == new DateTime(2026, 9, 3) || (_selectedDate.Date >= new DateTime(2026, 9, 4) && _selectedDate.Date <= new DateTime(2026, 9, 6)))
        ? "04 Sep – 06 Sep 2026 (Old Timetable · Fri–Sun)"
        : $"{_weekendStart:dd MMM} – {_weekendStart.AddDays(3):dd MMM yyyy}";

    protected override async Task OnInitializedAsync()
    {
        _faculty = await FacultySvc.GetAllAsync();
        _courses = await CourseSvc.GetAllAsync();
        _selectedDate = WeekendDates.Contains(DateTime.Today) ? DateTime.Today : _weekendStart;
        await RefreshHolidaysAsync();
        await LoadDayData();
    }

    private async Task OnTimetableVersionChanged(int version)
    {
        _selectedTimetableVersion = version;
        _overrideDayPlanIndex = 0;
        if (_selectedTimetableVersion == 1 && _selectedDate.DayOfWeek == DayOfWeek.Thursday)
        {
            // Auto switch to Friday so user immediately sees classes
            await SetSelectedDate(_weekendStart.AddDays(1));
            Snackbar.Add("Switched to Friday (AY 2026-27 Sem-I schedule runs Friday, Saturday & Sunday).", Severity.Info);
        }
        else
        {
            StateHasChanged();
        }
    }

    private async Task LoadDayData()
    {
        var rawSessions = await SessionSvc.GetAllAsync(_selectedDate, _selectedDate);
        var scheduledOnDay = rawSessions.Where(s => s.Status == SessionStatus.Scheduled).ToList();
        if (scheduledOnDay.Any())
        {
            foreach (var session in scheduledOnDay)
            {
                session.Status = SessionStatus.Conducted;
                session.IsApproved = true;
                session.ApprovedBy = "Administrator";
                session.ApprovedAt = DateTime.UtcNow;
                await SessionSvc.UpdateAsync(session);
            }
            rawSessions = await SessionSvc.GetAllAsync(_selectedDate, _selectedDate);
        }

        _daySessions.Clear();
        _daySessions.AddRange(rawSessions);
        var weekendSessions = await SessionSvc.GetAllAsync(_weekendStart, _weekendStart.AddDays(3));
        _weekendSessionCounts = weekendSessions
            .Where(session => session.Status != SessionStatus.Cancelled)
            .GroupBy(session => session.Date.Date)
            .ToDictionary(group => group.Key, group => group.Count());
        _attendanceSummaries = await AttendanceSvc.GetDailySessionSummariesAsync(_selectedDate);
        _nightReport = await AttendanceSvc.GetFacultyNightReportAsync(_selectedDate);
        _sessionPaymentAmounts = await PaymentSvc.GetSessionPaymentAmountsAsync(_selectedDate);
    }

    private int DaySessionCount(DateTime date) => _weekendSessionCounts.GetValueOrDefault(date.Date);

    private bool IsSelectedDate(DateTime date) => date.Date == _selectedDate.Date;

    private async Task JumpToEarlySeptemberWeekend()
    {
        _weekendStart = new DateTime(2026, 9, 3);
        _selectedTimetableVersion = 1;
        await SetSelectedDate(new DateTime(2026, 9, 4));
    }

    private async Task ShiftWeekend(int days)
    {
        _weekendStart = _weekendStart.AddDays(days);
        if (_weekendStart.Date == new DateTime(2026, 9, 3))
        {
            _selectedTimetableVersion = 1;
            await SetSelectedDate(new DateTime(2026, 9, 4));
            return;
        }
        _selectedTimetableVersion = 2;
        await SetSelectedDate(_weekendStart);
    }

    private async Task ShowCurrentWeekend()
    {
        _weekendStart = MostRecentThursday(DateTime.Today);
        var targetDate = (_selectedTimetableVersion == 1 && _selectedDate.DayOfWeek == DayOfWeek.Thursday)
            ? _weekendStart.AddDays(1)
            : (WeekendDates.Contains(DateTime.Today) ? DateTime.Today : _weekendStart);
        await SetSelectedDate(targetDate);
    }

    private async Task SetSelectedDate(DateTime date)
    {
        _selectedDate = date.Date;
        _overrideDayPlanIndex = 0;
        if (_selectedDate.Date >= new DateTime(2026, 9, 4) && _selectedDate.Date <= new DateTime(2026, 9, 6))
        {
            _selectedTimetableVersion = 1;
        }
        else
        {
            _selectedTimetableVersion = 2;
        }
        await LoadDayData();
    }

    private async Task SelectCustomDate(DateTime? date)
    {
        if (!date.HasValue) return;
        _selectedDate = date.Value.Date;
        _weekendStart = MostRecentThursday(_selectedDate);
        if (_selectedDate.Date >= new DateTime(2026, 9, 4) && _selectedDate.Date <= new DateTime(2026, 9, 6))
        {
            _selectedTimetableVersion = 1;
        }
        else
        {
            _selectedTimetableVersion = 2;
        }
        await LoadDayData();
    }

    private void OpenLogDialog()
    {
        _editingSessionId = null;
        _newSessionDate = _selectedDate;
        _newSessionIsOnline = false;
        _newSessionPlatform = "Microsoft Teams";
        _newSessionMeetingLink = null;
        _newSessionType = "Lecture";
        _newSessionFacultyId = _faculty.FirstOrDefault(faculty => faculty.IsActive)?.Id ?? 0;
        _newSessionCourseId = _courses.FirstOrDefault()?.Id ?? 0;
        _newSessionStart = new TimeSpan(8, 30, 0);
        _newSessionEnd = new TimeSpan(9, 30, 0);
        _newSessionNotes = null;
        _logDialogVisible = true;
    }

    private void OpenOnlineLectureDialogForDate(DateTime date, string? holidayName = null)
    {
        _editingSessionId = null;
        _newSessionDate = date.Date;
        _newSessionIsOnline = true;
        _newSessionPlatform = "Microsoft Teams";
        _newSessionMeetingLink = null;
        _newSessionType = "Lecture";
        _newSessionFacultyId = _faculty.FirstOrDefault(faculty => faculty.IsActive)?.Id ?? 0;
        _newSessionCourseId = _courses.FirstOrDefault()?.Id ?? 0;
        _newSessionStart = new TimeSpan(9, 0, 0);
        _newSessionEnd = new TimeSpan(10, 0, 0);
        _newSessionNotes = string.IsNullOrWhiteSpace(holidayName) ? "Online lecture" : $"Online lecture conducted on {holidayName}";
        _logDialogVisible = true;
    }

    private void OpenEditSession(Session session)
    {
        _editingSessionId = session.Id;
        _newSessionDate = session.Date;
        _newSessionIsOnline = session.IsOnline;
        _newSessionPlatform = string.IsNullOrWhiteSpace(session.MeetingPlatform) ? "Microsoft Teams" : session.MeetingPlatform;
        _newSessionMeetingLink = session.MeetingLink;
        _newSessionType = session.SessionType;
        _newSessionFacultyId = session.FacultyId;
        _newSessionCourseId = session.CourseId;
        _newSessionStart = session.ActualStartTime;
        _newSessionEnd = session.ActualEndTime;
        _newSessionNotes = session.Notes;
        _logDialogVisible = true;
    }

    private async Task SaveSession()
    {
        if (!_newSessionDate.HasValue || _newSessionFacultyId == 0 || _newSessionCourseId == 0) return;

        var isEditing = _editingSessionId.HasValue;
        try
        {
            if (isEditing)
            {
                var existing = await SessionSvc.GetByIdAsync(_editingSessionId!.Value);
                if (existing is null) return;

                var originalFacultyName = existing.Faculty.FullName;
                var replacementFacultyName = _faculty.FirstOrDefault(faculty => faculty.Id == _newSessionFacultyId)?.FullName;
                existing.Date = _newSessionDate.Value.Date;
                existing.FacultyId = _newSessionFacultyId;
                existing.CourseId = _newSessionCourseId;
                existing.ActualStartTime = _newSessionStart ?? TimeSpan.Zero;
                existing.ActualEndTime = _newSessionEnd ?? TimeSpan.Zero;
                existing.SessionType = _newSessionType;
                existing.Notes = _newSessionNotes;
                existing.IsOnline = _newSessionIsOnline;
                existing.MeetingPlatform = _newSessionIsOnline ? _newSessionPlatform : null;
                existing.MeetingLink = _newSessionIsOnline ? _newSessionMeetingLink : null;

                if (!string.Equals(originalFacultyName, replacementFacultyName, StringComparison.Ordinal))
                {
                    var substitutionNote = $"Substitution: {replacementFacultyName} took this class in place of {originalFacultyName}.";
                    existing.Notes = string.IsNullOrWhiteSpace(existing.Notes)
                        ? substitutionNote
                        : $"{existing.Notes.Trim()}\n\n{substitutionNote}";
                }

                await SessionSvc.UpdateAsync(existing);
            }
            else
            {
                await SessionSvc.LogSessionAsync(new Session
                {
                    Date = _newSessionDate.Value.Date,
                    FacultyId = _newSessionFacultyId,
                    CourseId = _newSessionCourseId,
                    ActualStartTime = _newSessionStart ?? TimeSpan.Zero,
                    ActualEndTime = _newSessionEnd ?? TimeSpan.Zero,
                    SessionType = _newSessionType,
                    Notes = _newSessionNotes,
                    IsOnline = _newSessionIsOnline,
                    MeetingPlatform = _newSessionIsOnline ? _newSessionPlatform : null,
                    MeetingLink = _newSessionIsOnline ? _newSessionMeetingLink : null,
                    LoggedBy = "Administrator",
                    IsApproved = true,
                    ApprovedBy = "Administrator",
                    ApprovedAt = DateTime.UtcNow
                });
            }

            _logDialogVisible = false;
            _selectedDate = _newSessionDate.Value.Date;
            _weekendStart = MostRecentThursday(_selectedDate);
            await LoadDayData();
            Snackbar.Add(isEditing ? "Timetable class updated." : "Class recorded. Its attendance register is ready.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task MarkConducted(int sessionId)
    {
        await SessionSvc.MarkConductedAsync(sessionId);
        await LoadDayData();
        Snackbar.Add("Class confirmed as conducted. Its attendance register is ready.", Severity.Success);
    }

    private void OpenSubmitDayDialog()
    {
        if (!CanSubmitDay) return;
        _submitDayDialogVisible = true;
    }

    private async Task SubmitCompletedDay()
    {
        try
        {
            await SessionSvc.SubmitCompletedDayAsync(_selectedDate);
            _submitDayDialogVisible = false;
            await LoadDayData();

            Navigation.NavigateTo($"/payment-overview?date={_selectedDate:yyyy-MM-dd}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task PrepareTimetableDay()
    {
        if (IsHolidayDate(_selectedDate))
        {
            Snackbar.Add($"Notice: {_selectedDate:dddd, dd MMM} is marked as a Holiday ({GetHolidayName(_selectedDate)}). To hold regular classes, please first restore this day using the red button.", Severity.Warning);
        }

        var plannedClasses = TimetablePlanForSelectedDate.ToList();
        if (!plannedClasses.Any())
        {
            if (_selectedTimetableVersion == 1 && _selectedDate.DayOfWeek == DayOfWeek.Thursday)
            {
                await SetSelectedDate(_weekendStart.AddDays(1)); // Switch to Friday
                Snackbar.Add("Switched to Friday (04 Sep). Now preparing Friday classes...", Severity.Info);
                plannedClasses = TimetablePlanForSelectedDate.ToList();
            }
            else
            {
                Snackbar.Add("No timetable is set for this date. The schedule is available for Friday, Saturday, and Sunday.", Severity.Info);
                return;
            }
        }

        var added = 0;
        foreach (var plannedClass in plannedClasses)
        {
            var course = _courses.FirstOrDefault(item => string.Equals(item.CourseCode, plannedClass.CourseCode, StringComparison.OrdinalIgnoreCase));
            var faculty = _faculty.FirstOrDefault(item => string.Equals(item.FullName, plannedClass.DefaultFacultyName, StringComparison.OrdinalIgnoreCase) && item.IsActive)
                ?? _faculty.FirstOrDefault(item => item.FullName.Contains(plannedClass.DefaultFacultyName.Split(' ').Last(), StringComparison.OrdinalIgnoreCase) && item.IsActive);
            var existingSession = FindPlannedSession(plannedClass);

            if (course is null || faculty is null) continue;

            if (existingSession != null)
            {
                if (existingSession.Status == SessionStatus.Scheduled)
                {
                    existingSession.Status = SessionStatus.Conducted;
                    existingSession.IsApproved = true;
                    existingSession.ApprovedBy = "Administrator";
                    existingSession.ApprovedAt = DateTime.UtcNow;
                    await SessionSvc.UpdateAsync(existingSession);
                    added++;
                }
                continue;
            }

            await SessionSvc.LogSessionAsync(new Session
            {
                Date = _selectedDate,
                FacultyId = faculty.Id,
                CourseId = course.Id,
                ActualStartTime = plannedClass.StartTime,
                ActualEndTime = plannedClass.EndTime,
                DurationHours = (decimal)(plannedClass.EndTime - plannedClass.StartTime).TotalHours,
                SessionType = plannedClass.SessionType,
                Status = SessionStatus.Conducted,
                IsApproved = true,
                ApprovedBy = "Administrator",
                ApprovedAt = DateTime.UtcNow,
                Notes = $"Prepared from the {(_selectedTimetableVersion == 1 ? "Official AY 2026-27 (26h)" : "Official Academic (28h)")} timetable.",
                LoggedBy = "Administrator"
            });
            added++;
        }

        await LoadDayData();
        Snackbar.Add(added > 0 ? $"{added} timetable classes prepared for {_selectedDate:dddd, dd MMM}." : "This day's classes are already prepared.", added > 0 ? Severity.Success : Severity.Info);
    }

    private void OpenRemoveSpecificClassDialog(Session session, TimetablePlanItem plan)
    {
        _sessionToRemove = session;
        _planToRemove = plan;
        _removeImpactAmount = GetSessionPaymentAmount(session.Id);
        _permanentlyDeleteSession = false;
        _removeSessionDialogVisible = true;
    }

    private async Task ConfirmRemoveSpecificClass()
    {
        if (_sessionToRemove is null && _planToRemove is null) return;
        try
        {
            var courseName = _sessionToRemove?.Course?.CourseName ?? _planToRemove?.CourseName ?? "Class";
            var type = _sessionToRemove?.SessionType ?? _planToRemove?.SessionType ?? "Class";

            if (_sessionToRemove is not null)
            {
                if (_permanentlyDeleteSession)
                {
                    await SessionSvc.DeleteAsync(_sessionToRemove.Id);
                }
                else
                {
                    _sessionToRemove.Status = SessionStatus.Cancelled;
                    _sessionToRemove.CancellationReason = "Manually removed from daily schedule by administrator";
                    await SessionSvc.UpdateAsync(_sessionToRemove);
                }
            }
            else if (_planToRemove is not null)
            {
                await ExcludeSingleClass(_planToRemove);
            }

            _removeSessionDialogVisible = false;
            await LoadDayData();
            Snackbar.Add($"Removed {courseName} ({type}). Amount deducted from day calculation.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RestoreSpecificClass(Session session, TimetablePlanItem plan)
    {
        try
        {
            var hasConductedOnDay = _daySessions.Any(s => s.Id != session.Id && s.Status == SessionStatus.Conducted);
            session.Status = hasConductedOnDay ? SessionStatus.Conducted : SessionStatus.Scheduled;
            session.CancellationReason = null;
            if (hasConductedOnDay)
            {
                session.IsApproved = true;
                session.ApprovedBy = "Administrator";
                session.ApprovedAt = DateTime.UtcNow;
            }
            await SessionSvc.UpdateAsync(session);
            await LoadDayData();
            Snackbar.Add($"Restored {session.Course?.CourseName ?? plan.CourseName} to today's schedule.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ExcludeSingleClass(TimetablePlanItem plan)
    {
        try
        {
            var course = _courses.FirstOrDefault(item => string.Equals(item.CourseCode, plan.CourseCode, StringComparison.OrdinalIgnoreCase));
            var faculty = _faculty.FirstOrDefault(item => string.Equals(item.FullName, plan.DefaultFacultyName, StringComparison.OrdinalIgnoreCase) && item.IsActive)
                ?? _faculty.FirstOrDefault(item => item.FullName.Contains(plan.DefaultFacultyName.Split(' ').Last(), StringComparison.OrdinalIgnoreCase) && item.IsActive);

            if (course is null || faculty is null)
            {
                Snackbar.Add("Could not identify course or faculty to exclude.", Severity.Warning);
                return;
            }

            var cancelledSession = new Session
            {
                Date = _selectedDate,
                FacultyId = faculty.Id,
                CourseId = course.Id,
                ActualStartTime = plan.StartTime,
                ActualEndTime = plan.EndTime,
                DurationHours = (decimal)(plan.EndTime - plan.StartTime).TotalHours,
                SessionType = plan.SessionType,
                Status = SessionStatus.Cancelled,
                CancellationReason = "Excluded prior to day preparation",
                Notes = "Manually excluded by administrator",
                LoggedBy = "Administrator"
            };

            await SessionSvc.ScheduleSessionAsync(cancelledSession);
            await LoadDayData();
            Snackbar.Add($"Excluded {plan.CourseName} ({plan.SessionType}) from today's plan.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task PrepareSingleClass(TimetablePlanItem plan)
    {
        try
        {
            var course = _courses.FirstOrDefault(item => string.Equals(item.CourseCode, plan.CourseCode, StringComparison.OrdinalIgnoreCase));
            var faculty = _faculty.FirstOrDefault(item => string.Equals(item.FullName, plan.DefaultFacultyName, StringComparison.OrdinalIgnoreCase) && item.IsActive)
                ?? _faculty.FirstOrDefault(item => item.FullName.Contains(plan.DefaultFacultyName.Split(' ').Last(), StringComparison.OrdinalIgnoreCase) && item.IsActive);

            if (course is null || faculty is null)
            {
                Snackbar.Add("Could not identify course or faculty to prepare.", Severity.Warning);
                return;
            }

            var existingSession = FindPlannedSession(plan);
            if (existingSession != null)
            {
                existingSession.Status = SessionStatus.Conducted;
                existingSession.IsApproved = true;
                existingSession.ApprovedBy = "Administrator";
                existingSession.ApprovedAt = DateTime.UtcNow;
                await SessionSvc.UpdateAsync(existingSession);
            }
            else
            {
                await SessionSvc.LogSessionAsync(new Session
                {
                    Date = _selectedDate,
                    FacultyId = faculty.Id,
                    CourseId = course.Id,
                    ActualStartTime = plan.StartTime,
                    ActualEndTime = plan.EndTime,
                    DurationHours = (decimal)(plan.EndTime - plan.StartTime).TotalHours,
                    SessionType = plan.SessionType,
                    Status = SessionStatus.Conducted,
                    IsApproved = true,
                    ApprovedBy = "Administrator",
                    ApprovedAt = DateTime.UtcNow,
                    Notes = $"Prepared from the {(_selectedTimetableVersion == 1 ? "Official AY 2026-27 (26h)" : "Official Academic (28h)")} timetable.",
                    LoggedBy = "Administrator"
                });
            }
            await LoadDayData();
            Snackbar.Add($"Prepared {plan.CourseName} ({plan.SessionType}) for {_selectedDate:dd MMM}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteSessionFromEditDialog()
    {
        if (!_editingSessionId.HasValue) return;
        var session = _daySessions.FirstOrDefault(s => s.Id == _editingSessionId.Value);
        if (session != null)
        {
            session.Status = SessionStatus.Cancelled;
            session.CancellationReason = "Manually removed by administrator via edit dialog";
            await SessionSvc.UpdateAsync(session);
        }
        else
        {
            await SessionSvc.DeleteAsync(_editingSessionId.Value);
        }
        _logDialogVisible = false;
        await LoadDayData();
        Snackbar.Add("Class removed from schedule. Total payment adjusted.", Severity.Warning);
    }

    private async Task DeleteSession(int sessionId)
    {
        await SessionSvc.DeleteAsync(sessionId);
        await LoadDayData();
        Snackbar.Add("Class removed.", Severity.Warning);
    }

    private DailySessionAttendanceSummary? GetAttendanceSummary(int sessionId) =>
        _attendanceSummaries.FirstOrDefault(summary => summary.SessionId == sessionId);

    private async Task OpenAttendanceDialog(DailySessionAttendanceSummary summary)
    {
        _attendanceSession = summary;
        _attendanceStudents = await AttendanceSvc.GetAttendanceChecklistAsync(summary.SessionId);
        _attendanceDialogVisible = true;
    }

    private void MarkAllPresent()
    {
        foreach (var student in _attendanceStudents)
            student.IsPresent = true;
    }

    private async Task SaveAttendance()
    {
        if (_attendanceSession is null) return;

        try
        {
            await AttendanceSvc.SaveAttendanceAsync(_attendanceSession.SessionId, _attendanceStudents);
            _attendanceDialogVisible = false;
            await LoadDayData();
            Snackbar.Add("Attendance saved and included in the night report.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private Session? FindPlannedSession(TimetablePlanItem plan) =>
        _daySessions.FirstOrDefault(session =>
            session.ActualStartTime == plan.StartTime &&
            session.ActualEndTime == plan.EndTime)
        ?? _daySessions.FirstOrDefault(session =>
            session.Course?.CourseCode == plan.CourseCode &&
            session.SessionType == plan.SessionType &&
            session.ActualStartTime == plan.StartTime);

    private decimal GetSessionPaymentAmount(int sessionId) =>
        _sessionPaymentAmounts.Where(item => item.SessionId == sessionId).Sum(item => item.Amount);

    private static string FormatTime(TimeSpan time) => DateTime.Today.Add(time).ToString("h:mm tt");

