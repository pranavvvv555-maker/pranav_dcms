    private static DateTime MostRecentThursday(DateTime date)
    {
        var daysSinceThursday = ((int)date.DayOfWeek - (int)DayOfWeek.Thursday + 7) % 7;
        return date.Date.AddDays(-daysSinceThursday);
    }

    private async Task RefreshHolidaysAsync()
    {
        _holidays = await HolidaySvc.GetHolidaysDictAsync();
    }

    private bool IsHolidayDate(DateTime date) => _holidays.ContainsKey(date.Date);

    private string? GetHolidayName(DateTime date) => _holidays.GetValueOrDefault(date.Date);

    private void OpenDeclareHolidayDialog()
    {
        _holidayDialogMode = 0;
        if (IsHolidayDate(_selectedDate))
        {
            _declareHolidayName = GetHolidayName(_selectedDate) ?? "University Holiday";
        }
        else
        {
            _declareHolidayName = "University Holiday";
        }
        _declareHolidayDesc = null;
        _clearDayClassesOnHoliday = true;
        _removeOnlineClassesOnHoliday = false;
        _markAsExcludedNonTeachingDay = false;
        _declareHolidayDialogVisible = true;
    }

    private async Task ConfirmDeclareHolidayAsync()
    {
        if (string.IsNullOrWhiteSpace(_declareHolidayName))
        {
            Snackbar.Add("Please specify a holiday reason or occasion.", Severity.Warning);
            return;
        }

        try
        {
            await HolidaySvc.DeclareHolidayAsync(
                _selectedDate,
                _declareHolidayName,
                _declareHolidayDesc,
                isRemovedDay: false,
                clearScheduledClasses: _clearDayClassesOnHoliday,
                removeOnlineToo: _removeOnlineClassesOnHoliday);

            await RefreshHolidaysAsync();
            await LoadDayData();
            _declareHolidayDialogVisible = false;
            Snackbar.Add($"Declared {_selectedDate:dddd, dd MMM yyyy} as Holiday: {_declareHolidayName}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ConfirmRemoveDayAsync()
    {
        try
        {
            if (_markAsExcludedNonTeachingDay)
            {
                await HolidaySvc.DeclareHolidayAsync(
                    _selectedDate,
                    "Removed / Non-Teaching Day",
                    "Explicitly removed from teaching schedule",
                    isRemovedDay: true,
                    clearScheduledClasses: true,
                    removeOnlineToo: _removeOnlineClassesOnHoliday);
            }
            else
            {
                await HolidaySvc.RemoveDaySessionsAsync(_selectedDate, removeOnlineToo: _removeOnlineClassesOnHoliday);
            }

            await RefreshHolidaysAsync();
            await LoadDayData();
            _declareHolidayDialogVisible = false;
            Snackbar.Add($"All classes for {_selectedDate:dddd, dd MMM yyyy} have been removed.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RevokeHolidayDirectAsync(DateTime date)
    {
        try
        {
            var removed = await HolidaySvc.RevokeHolidayAsync(date);
            await RefreshHolidaysAsync();
            await LoadDayData();
            _declareHolidayDialogVisible = false;
            if (removed)
            {
                Snackbar.Add($"Holiday revoked. {date:dddd, dd MMM yyyy} restored as regular instructional day.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
