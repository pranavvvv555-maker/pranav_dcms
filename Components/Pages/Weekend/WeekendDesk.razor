    {
        if (!CanSubmitDay) return;
        _submitDayDialogVisible = true;
    }

    private async Task SubmitCompletedDay()
    {
        try
        {
            await SessionSvc.SubmitCompletedDayAsync(_selectedDate);
            _submitDayDialogVisible = false;
            await LoadDayData();

            Navigation.NavigateTo($"/payment-overview?date={_selectedDate:yyyy-MM-dd}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task PrepareTimetableDay()
    {
        var plannedClasses = TimetablePlanForSelectedDate.ToList();
        if (!plannedClasses.Any())
        {
            Snackbar.Add("The timetable is available for Friday, Saturday, and Sunday.", Severity.Info);
            return;
        }

        var added = 0;
        foreach (var plannedClass in plannedClasses)
        {
            var course = _courses.FirstOrDefault(item => item.CourseCode == plannedClass.CourseCode);
            var faculty = _faculty.FirstOrDefault(item => item.FullName == plannedClass.DefaultFacultyName && item.IsActive);
            var alreadyPrepared = _daySessions.Any(session =>
                session.ActualStartTime == plannedClass.StartTime &&
                session.ActualEndTime == plannedClass.EndTime);

            if (course is null || faculty is null || alreadyPrepared) continue;

            await SessionSvc.ScheduleSessionAsync(new Session
            {
                Date = _selectedDate,
                FacultyId = faculty.Id,
                CourseId = course.Id,
                ActualStartTime = plannedClass.StartTime,
                ActualEndTime = plannedClass.EndTime,
                SessionType = plannedClass.SessionType,
                Notes = "Prepared from the weekend timetable.",
                LoggedBy = "Administrator"
            });
            added++;
        }

        await LoadDayData();
        Snackbar.Add(added > 0 ? $"{added} timetable classes prepared. Edit any class if there is a substitution." : "This day is already prepared.", added > 0 ? Severity.Success : Severity.Info);
    }

    private async Task DeleteSession(int sessionId)
    {
        await SessionSvc.DeleteAsync(sessionId);
        await LoadDayData();
        Snackbar.Add("Class removed.", Severity.Warning);
    }

    private DailySessionAttendanceSummary? GetAttendanceSummary(int sessionId) =>
        _attendanceSummaries.FirstOrDefault(summary => summary.SessionId == sessionId);

