    private async Task ExportCsv()
    {
        if (!_evaluations.Any())
        {
            Snackbar.Add("No evaluations to export.", Severity.Warning);
            return;
        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"# MOCK INTERVIEW MARKS RECORD: {_activeDrive?.Title}");
        sb.AppendLine($"# SUBJECT: {GetActiveDriveSubjectDisplayName()}");
        sb.AppendLine($"# DATE: {_activeDrive?.DriveDate:dd MMMM yyyy} | STATUS: {_activeDrive?.Status}");
        sb.AppendLine("Sr,STUDENT NAME,ROLL NO,SUBJECT,Confidence (0-10),Communication (0-10),Technical (0-10),Marks / 10,Evaluator Feedback & Notes");

        var currentSubject = GetActiveDriveSubjectDisplayName();
        int sr = 1;

        foreach (var e in FilteredEvaluations)
        {
            var conf = e.IsAbsent ? "" : (e.ConfidenceScore?.ToString("0.#") ?? "");
            var comm = e.IsAbsent ? "" : (e.CommunicationScore?.ToString("0.#") ?? "");
            var tech = e.IsAbsent ? "" : (e.TechnicalScore?.ToString("0.#") ?? "");
            var marks = e.IsAbsent ? "absent" : (e.MarksOutOf10?.ToString("0.#") ?? "");
            var cleanFeedback = (e.Feedback ?? "").Replace("\"", "\"\"");
            var roll = e.Student?.StudentCode ?? "";

            sb.AppendLine($"{sr++},\"{e.Student?.FullName}\",\"{roll}\",\"{currentSubject}\",{conf},{comm},{tech},{marks},\"{cleanFeedback}\"");
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var subjectCodeSafe = _activeDrive?.Course?.CourseCode ?? "MockFeedback";
        var fileName = $"{(_activeDrive?.Title ?? "MockFeedback").Replace(" ", "_")}_{subjectCodeSafe}.csv";

        await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, "text/csv;charset=utf-8", base64);
        Snackbar.Add("Mock Feedback sheet downloaded with subject details.", Severity.Success);
    }

