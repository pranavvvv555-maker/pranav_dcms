<!-- Dialog: Delete Drive Confirmation -->
<MudDialog @bind-Visible="_deleteDriveVisible" Options="_smallDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #dc2626;">Delete Mock Interview Drive</MudText>
    </TitleContent>
