@page "/mock-interviews"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Hosting
@inject MockInterviewService InterviewSvc
@inject MockInterviewImportService ImportSvc
@inject FacultyService FacultySvc
@inject CourseService CourseSvc
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IWebHostEnvironment HostEnv

<PageTitle>DCMS — Mock Feedback Spreadsheet</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2 simple-page">
    <!-- Header Section -->
    <section class="page-intro">
        <div>
            <span class="premium-eyebrow">Month-End Industry Interview Desk · Flexible Scheduling</span>
            <MudText Typo="Typo.h4">Mock Feedback & Scheduling</MudText>
            <MudText Typo="Typo.body2">
                Schedule flexible month-end mock interview drives, track status, and directly grade student Confidence, Communication, Technical factors, and Feedback.
            </MudText>
        </div>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.UploadFile" OnClick="OpenImportDialog">
                Import Sheet
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="ExportPdf">
                Download PDF
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportCsv">
                Export Sheet
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenAddStudentDialog">
                Add Student
            </MudButton>
            <MudButton Variant="Variant.Filled" Class="btn-gradient-primary" StartIcon="@Icons.Material.Filled.CalendarMonth" OnClick="OpenCreateDriveDialog">
                Schedule Mock Drive
            </MudButton>
        </MudStack>
    </section>

    <!-- Key Metrics Bar with Gradients & Polish -->
    <MudGrid Class="mb-5">
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="0" Class="metric-card" Style="border-top: 3px solid #2563eb !important;">
                <div class="d-flex justify-space-between align-center mb-1">
                    <span class="metric-card__label">Average Marks</span>
                    <MudIcon Icon="@Icons.Material.Filled.Stars" Size="Size.Small" Style="color: #2563eb;" />
                </div>
                <strong class="metric-card__value" style="color: #2563eb;">@_stats.AverageMarksOutOf10 <small style="font-size: 0.9rem; color: #64748b; font-weight: 600;">/ 10</small></strong>
                <small class="metric-card__hint">@_stats.TotalEvaluated evaluated · @_stats.AbsentCount absent</small>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="0" Class="metric-card" Style="border-top: 3px solid #059669 !important;">
                <div class="d-flex justify-space-between align-center mb-1">
                    <span class="metric-card__label">Confidence Avg</span>
                    <MudIcon Icon="@Icons.Material.Filled.Psychology" Size="Size.Small" Style="color: #059669;" />
                </div>
                <strong class="metric-card__value" style="color: #059669;">@_stats.AverageConfidence <small style="font-size: 0.9rem; color: #64748b; font-weight: 600;">/ 10</small></strong>
                <small class="metric-card__hint">Poise & self-assurance</small>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="0" Class="metric-card" Style="border-top: 3px solid #d97706 !important;">
                <div class="d-flex justify-space-between align-center mb-1">
                    <span class="metric-card__label">Communication</span>
                    <MudIcon Icon="@Icons.Material.Filled.RecordVoiceOver" Size="Size.Small" Style="color: #d97706;" />
                </div>
                <strong class="metric-card__value" style="color: #d97706;">@_stats.AverageCommunication <small style="font-size: 0.9rem; color: #64748b; font-weight: 600;">/ 10</small></strong>
                <small class="metric-card__hint">Articulation & clarity</small>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="0" Class="metric-card" Style="border-top: 3px solid #7c3aed !important;">
                <div class="d-flex justify-space-between align-center mb-1">
                    <span class="metric-card__label">Technical Avg</span>
                    <MudIcon Icon="@Icons.Material.Filled.Terminal" Size="Size.Small" Style="color: #7c3aed;" />
                </div>
                <strong class="metric-card__value" style="color: #7c3aed;">@_stats.AverageTechnical <small style="font-size: 0.9rem; color: #64748b; font-weight: 600;">/ 10</small></strong>
                <small class="metric-card__hint">Core concept & queries</small>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- Drive Tabs Bar (Modern Pill Style with Glowing Selection & Subject Filter) -->
    <div class="d-flex flex-wrap gap-2 align-center justify-space-between mb-4">
        <div class="d-flex flex-wrap gap-2 align-center">
            @foreach (var d in FilteredDrives)
            {
                var isSelected = d.Id == _selectedDriveId;
                <button type="button" @onclick="@(() => OnDriveChanged(d.Id))"
                        style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; font-size: 0.86rem; font-weight: 600; border-radius: 9999px; border: 1px solid @(isSelected ? "#2563eb" : "#e2e8f0"); background: @(isSelected ? "linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%)" : "#ffffff"); color: @(isSelected ? "#ffffff" : "#475569"); box-shadow: @(isSelected ? "0 4px 14px rgba(37, 99, 235, 0.3)" : "0 1px 3px rgba(0,0,0,0.04)"); cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);">
                    <span>📅 @d.Title</span>
                    @if (d.Course != null || !string.IsNullOrWhiteSpace(d.SubjectName))
                    {
                        <span style="font-size: 0.72rem; padding: 2px 8px; border-radius: 9999px; font-weight: 700; background: @(isSelected ? "rgba(255,255,255,0.25)" : "#eff6ff"); color: @(isSelected ? "#ffffff" : "#2563eb"); border: 1px solid @(isSelected ? "rgba(255,255,255,0.4)" : "#bfdbfe");">
                            📚 @(d.Course?.CourseCode ?? ShortenSubject(d.SubjectName))
                        </span>
                    }
                    <span style="font-size: 0.7rem; padding: 2px 8px; border-radius: 9999px; font-weight: 700; background: @(isSelected ? "rgba(255,255,255,0.22)" : GetDriveBadgeBackground(d.Status)); color: @(isSelected ? "#ffffff" : GetDriveBadgeColor(d.Status));">
                        @d.Status
                    </span>
                </button>
            }
            <button type="button" @onclick="OpenCreateDriveDialog"
                    style="display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; font-size: 0.86rem; font-weight: 700; border-radius: 9999px; border: 1.5px dashed #3b82f6; background: #eff6ff; color: #2563eb; cursor: pointer; transition: all 0.2s;">
                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                <span>Schedule New Drive</span>
            </button>
        </div>

        <div class="d-flex align-center gap-2 flex-wrap" style="min-width: 320px;">
            <select value="@(_selectedSubjectFilterCourseId?.ToString() ?? "")"
                    @onchange="OnSubjectFilterChanged"
                    style="font-size: 0.82rem; font-weight: 600; padding: 7px 10px; border: 1px solid #cbd5e1; border-radius: 8px; background: #ffffff; color: #334155; outline: none; cursor: pointer;">
                <option value="">Filter: All Subjects</option>
                @foreach (var c in _courses)
                {
                    <option value="@c.Id">@c.CourseCode</option>
                }
            </select>
            <div style="flex: 1; min-width: 180px;">
                <MudTextField @bind-Value="_searchQuery" Placeholder="Search student name..."
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Margin="Margin.Dense" Variant="Variant.Outlined" Clearable="true" Immediate="true" />
            </div>
        </div>
    </div>

    <!-- Active Drive Card & Flexible Reschedule Bar -->
    @if (_activeDrive != null)
    {
        <div class="pa-4 mb-4"
             style="background: #ffffff; border: 1px solid #e2e8f0; border-left: 5px solid @GetDriveStatusBorderColor(_activeDrive.Status); border-radius: 12px; box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.04);">
            <div class="d-flex flex-wrap align-center justify-space-between gap-3 mb-3">
                <div class="d-flex flex-column gap-1">
                    <div class="d-flex align-center gap-2 flex-wrap">
                        <span style="font-size: 1.15rem; font-weight: 800; color: #0f172a; letter-spacing: -0.3px;">@_activeDrive.Title</span>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@GetDriveStatusChipColor(_activeDrive.Status)" Style="font-weight: 700; font-size: 0.72rem;">
                            @_activeDrive.Status
                        </MudChip>
                        <span style="font-size: 0.84rem; font-weight: 600; color: #334155; background: #f8fafc; border: 1px solid #e2e8f0; padding: 3px 12px; border-radius: 9999px;">
                            📅 @_activeDrive.DriveDate.ToString("dddd, dd MMMM yyyy")
                        </span>
                        @if (GetLeadInterviewerName() is string leadName && !string.IsNullOrWhiteSpace(leadName))
                        {
                            <span style="font-size: 0.82rem; color: #1e40af; background: #eff6ff; border: 1px solid #dbeafe; padding: 3px 10px; border-radius: 9999px; font-weight: 600;">
                                👤 Panel: @leadName
                            </span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_activeDrive.PanelNotes))
                    {
                        <div style="font-size: 0.84rem; color: #64748b;" class="d-flex align-center gap-1 mt-1">
                            <MudIcon Icon="@Icons.Material.Filled.Notes" Size="Size.Small" Style="color: #94a3b8;" />
                            <span>@_activeDrive.PanelNotes</span>
                        </div>
                    }
                </div>

                <div class="d-flex align-center gap-2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.EditCalendar"
                               OnClick="OpenEditDriveDialog"
                               Style="font-weight: 600; border-radius: 8px;">
                        Reschedule / Edit Drive
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                   OnClick="OpenDeleteDriveDialog" />
                </div>
            </div>

            <!-- Prominent Subject / Course Selection Bar for Marks Entry -->
            <div class="pa-3 d-flex flex-wrap align-center justify-space-between gap-3"
                 style="background: #f0fdf4; border: 1.5px solid #86efac; border-radius: 10px;">
                <div class="d-flex align-center gap-3 flex-wrap">
                    <div class="d-flex align-center gap-2">
                        <span style="background: #15803d; color: #ffffff; padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 800; display: inline-flex; align-items: center; gap: 4px;">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" />
                            <span>SUBJECT FOR MARKS</span>
                        </span>
                        <span style="font-size: 0.88rem; font-weight: 700; color: #14532d;">Select Subject:</span>
                    </div>
                    <select value="@(_activeDrive.CourseId?.ToString() ?? "")"
                            @onchange="OnActiveDriveSubjectSelectChanged"
                            style="font-size: 0.88rem; font-weight: 700; padding: 6px 14px; border: 1.5px solid #16a34a; border-radius: 8px; background: #ffffff; color: #14532d; outline: none; cursor: pointer; box-shadow: 0 1px 3px rgba(22, 163, 74, 0.15); min-width: 340px;">
                        <option value="">-- Choose Subject / Course --</option>
                        @foreach (var c in _courses)
                        {
                            <option value="@c.Id">@c.CourseCode — @c.CourseName</option>
                        }
                    </select>

                    @if (_activeDrive.Course != null || !string.IsNullOrWhiteSpace(_activeDrive.SubjectName))
                    {
                        <span style="font-size: 0.82rem; font-weight: 700; padding: 3px 12px; border-radius: 9999px; background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; display: inline-flex; align-items: center; gap: 4px;">
                            <span>✔</span>
                            <span>Currently Grading: <strong>@GetActiveDriveSubjectDisplayName()</strong></span>
                        </span>
                    }
                    else
                    {
                        <span style="font-size: 0.8rem; font-weight: 700; padding: 3px 10px; border-radius: 9999px; background: #fffbeb; color: #92400e; border: 1px solid #fde68a;">
                            ⚠️ Select subject from dropdown above to assign marks to this subject
                        </span>
                    }
                </div>

                <div class="d-flex align-center gap-2">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" Style="font-size: 0.72rem; font-weight: 700;">
                        @(string.IsNullOrWhiteSpace(_activeDrive.Course?.AssessmentScheme) ? "10-Pt Factor Scale" : $"Scheme: {_activeDrive.Course.AssessmentScheme}")
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Style="font-size: 0.72rem; font-weight: 700;">
                        3 Factors: Conf / Comm / Tech
                    </MudChip>
                </div>
            </div>
        </div>
    }

    <!-- Sticky Spreadsheet Action Bar (Modern Frosted Glass) -->
    <div class="sheet-action-bar mb-4 pa-3 d-flex flex-wrap align-center justify-space-between gap-2"
         style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(12px); border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05); position: sticky; top: 76px; z-index: 10;">
        <div class="d-flex align-center gap-3">
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Medium"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAllChanges"
                       Disabled="@(!_modifiedEvaluationIds.Any())"
                       Style="font-weight: 700; border-radius: 8px; box-shadow: 0 2px 8px rgba(16, 185, 129, 0.25);">
                @if (_modifiedEvaluationIds.Any())
                {
                    <span>Save Changes (@_modifiedEvaluationIds.Count)</span>
                }
                else
                {
                    <span>All Changes Saved</span>
                }
            </MudButton>

            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Medium"
                       StartIcon="@Icons.Material.Filled.AutoFixHigh"
                       OnClick="AutoCalculateMarks"
                       Style="font-weight: 600; border-radius: 8px;">
                Auto-Calc Marks
            </MudButton>

            <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" Size="Size.Medium"
                       StartIcon="@Icons.Material.Filled.UploadFile"
                       OnClick="OpenImportDialog"
                       Style="font-weight: 600; border-radius: 8px;">
                Import Sheet
            </MudButton>

            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Medium"
                       StartIcon="@Icons.Material.Filled.Undo"
                       Disabled="@(!_modifiedEvaluationIds.Any())"
                       OnClick="DiscardChanges"
                       Style="font-weight: 600; border-radius: 8px;">
                Discard
            </MudButton>
        </div>

        <div class="d-flex align-center gap-3">
            <span style="font-size: 0.82rem; color: #64748b;" class="d-none d-md-inline">
                💡 <em>Press <strong>Tab</strong> to navigate quickly between cells</em>
            </span>
            <MudChip T="string" Color="@(_modifiedEvaluationIds.Any() ? Color.Warning : Color.Success)" Size="Size.Small" Variant="Variant.Filled" Style="font-weight: 700; font-size: 0.75rem;">
                @(_modifiedEvaluationIds.Any() ? $"{_modifiedEvaluationIds.Count} unsaved row(s)" : "All saved")
            </MudChip>
        </div>
    </div>

    <!-- Spreadsheet Feedback Table (Modern Slate & Pastel Palette) -->
    @if (!_evaluations.Any())
    {
        <MudPaper Elevation="0" Class="pa-8 text-center" Style="background: #f8fafc; border: 1.5px dashed #cbd5e1; border-radius: 16px;">
            <MudIcon Icon="@Icons.Material.Filled.Assessment" Style="font-size: 3.5rem; color: #94a3b8;" Class="mb-3" />
            <MudText Typo="Typo.h6" Style="color: #1e293b; font-weight: 700;">No student evaluations assigned for this drive</MudText>
            <MudText Typo="Typo.body2" Style="color: #64748b;" Class="mb-4">Import an existing Excel/CSV marksheet or add enrolled students to populate.</MudText>
            <MudStack Row="true" Spacing="2" Justify="Justify.Center">
                <MudButton Variant="Variant.Filled" Color="Color.Tertiary" OnClick="OpenImportDialog" StartIcon="@Icons.Material.Filled.UploadFile" Style="font-weight: 700;">
                    Import Excel / CSV Sheet
                </MudButton>
                <MudButton Variant="Variant.Filled" Class="btn-gradient-primary" OnClick="OpenAddStudentDialog" StartIcon="@Icons.Material.Filled.PersonAdd">
                    Add Students
                </MudButton>
            </MudStack>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Style="border: 1px solid #e2e8f0; border-radius: 14px; overflow-x: auto; background: #ffffff; box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);">
            <table class="sheet-table" style="width: 100%; border-collapse: collapse; font-size: 0.88rem; min-width: 1100px;">
                <thead>
                    <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0;">
                        <th style="padding: 12px 10px; text-align: center; font-weight: 700; color: #475569; width: 50px; border-right: 1px solid #e2e8f0;">#</th>
                        <th style="padding: 12px 14px; text-align: left; font-weight: 700; color: #334155; width: 230px; border-right: 1px solid #e2e8f0;">STUDENT DETAILS</th>
                        <th style="padding: 12px 10px; text-align: center; width: 120px; border-right: 1px solid #e2e8f0;">
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 9999px; font-weight: 700; font-size: 0.76rem; background: #fef3c7; color: #92400e; border: 1px solid #fde68a;">
                                Confidence (0–10)
                            </span>
                        </th>
                        <th style="padding: 12px 10px; text-align: center; width: 130px; border-right: 1px solid #e2e8f0;">
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 9999px; font-weight: 700; font-size: 0.76rem; background: #d1fae5; color: #065f46; border: 1px solid #a7f3d0;">
                                Communication (0–10)
                            </span>
                        </th>
                        <th style="padding: 12px 10px; text-align: center; width: 120px; border-right: 1px solid #e2e8f0;">
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 9999px; font-weight: 700; font-size: 0.76rem; background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;">
                                Technical (0–10)
                            </span>
                        </th>
                        <th style="padding: 12px 10px; text-align: center; width: 135px; border-right: 1px solid #e2e8f0;">
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 9999px; font-weight: 700; font-size: 0.76rem; background: #ede9fe; color: #5b21b6; border: 1px solid #ddd6fe;">
                                Marks / 10
                            </span>
                        </th>
                        <th style="padding: 12px 14px; text-align: left; border-right: 1px solid #e2e8f0;">
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 9999px; font-weight: 700; font-size: 0.76rem; background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1;">
                                Evaluator Feedback & Notes
                            </span>
                        </th>
                        <th style="padding: 12px 10px; text-align: center; width: 95px;">
                            <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; border-radius: 9999px; font-weight: 700; font-size: 0.76rem; background: #ffe4e6; color: #be123c; border: 1px solid #fecdd3;">
                                Absent
                            </span>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int sr = 1;
                        var evalList = FilteredEvaluations.ToList();
                    }
                    @if (!evalList.Any())
                    {
                        <tr>
                            <td colspan="8" style="padding: 24px; text-align: center; color: #64748b;">
                                No students match the search filter.
                            </td>
                        </tr>
                    }
                    @foreach (var item in evalList)
                    {
                        var isModified = _modifiedEvaluationIds.Contains(item.Id);
                        <tr style="border-bottom: 1px solid #f1f5f9; background: @(item.IsAbsent ? "#fef2f2" : (isModified ? "#f0fdf4" : "#ffffff")); transition: background 0.15s ease;">
                            <!-- Sr -->
                            <td style="padding: 10px 10px; text-align: center; font-weight: 600; color: #64748b; width: 50px; border-right: 1px solid #f1f5f9;">
                                @(sr++)
                                @if (isModified)
                                {
                                    <span title="Unsaved changes" style="display: inline-block; width: 8px; height: 8px; background: #10b981; border-radius: 50%; margin-left: 3px; vertical-align: middle; box-shadow: 0 0 6px rgba(16,185,129,0.5);"></span>
                                }
                            </td>

                            <!-- STUDENT NAME & ROLL -->
                            <td style="padding: 10px 14px; font-weight: 700; color: #0f172a; width: 230px; border-right: 1px solid #f1f5f9;">
                                <div class="d-flex flex-column">
                                    <span style="font-size: 0.95rem; color: #0f172a; font-weight: 700;">@item.Student?.FullName</span>
                                    <div class="d-flex align-center gap-2 mt-1">
                                        <span style="font-size: 0.76rem; color: #475569; font-weight: 600; background: #f1f5f9; padding: 2px 8px; border-radius: 4px; border: 1px solid #e2e8f0;">
                                            Roll: @(item.Student?.StudentCode ?? "—")
                                        </span>
                                        @if (item.Student?.EnrollmentStatus != null)
                                        {
                                            <span style="font-size: 0.72rem; color: #059669; font-weight: 600;">
                                                @(item.Student.EnrollmentStatus)
                                            </span>
                                        }
                                    </div>
                                </div>
                            </td>

                                    <!-- Confidence (Soft Yellow) -->
                                    <td style="padding: 6px 8px; text-align: center; width: 120px; border-right: 1px solid #f1f5f9;">
                                        <input type="number" min="0" max="10" step="0.5"
                                               disabled="@item.IsAbsent"
                                               value="@(item.ConfidenceScore?.ToString("0.#") ?? "")"
                                               @onchange="@((ChangeEventArgs e) => OnConfidenceChanged(item, e.Value?.ToString()))"
                                               placeholder="0–10"
                                               style="width: 100%; text-align: center; font-weight: 700; font-size: 0.95rem; color: #78350f; padding: 6px 8px; border: 1px solid @(item.IsAbsent ? "#e2e8f0" : "#fde68a"); border-radius: 8px; background: @(item.IsAbsent ? "#f1f5f9" : "#fffbeb"); outline: none;" />
                                    </td>

                                    <!-- Communication (Soft Emerald) -->
                                    <td style="padding: 6px 8px; text-align: center; width: 130px; border-right: 1px solid #f1f5f9;">
                                        <input type="number" min="0" max="10" step="0.5"
                                               disabled="@item.IsAbsent"
                                               value="@(item.CommunicationScore?.ToString("0.#") ?? "")"
                                               @onchange="@((ChangeEventArgs e) => OnCommunicationChanged(item, e.Value?.ToString()))"
                                               placeholder="0–10"
                                               style="width: 100%; text-align: center; font-weight: 700; font-size: 0.95rem; color: #065f46; padding: 6px 8px; border: 1px solid @(item.IsAbsent ? "#e2e8f0" : "#a7f3d0"); border-radius: 8px; background: @(item.IsAbsent ? "#f1f5f9" : "#ecfdf5"); outline: none;" />
                                    </td>

                                    <!-- Technical (Soft Sky Blue) -->
                                    <td style="padding: 6px 8px; text-align: center; width: 120px; border-right: 1px solid #f1f5f9;">
                                        <input type="number" min="0" max="10" step="0.5"
                                               disabled="@item.IsAbsent"
                                               value="@(item.TechnicalScore?.ToString("0.#") ?? "")"
                                               @onchange="@((ChangeEventArgs e) => OnTechnicalChanged(item, e.Value?.ToString()))"
                                               placeholder="0–10"
                                               style="width: 100%; text-align: center; font-weight: 700; font-size: 0.95rem; color: #0369a1; padding: 6px 8px; border: 1px solid @(item.IsAbsent ? "#e2e8f0" : "#bae6fd"); border-radius: 8px; background: @(item.IsAbsent ? "#f1f5f9" : "#f0f9ff"); outline: none;" />
                                    </td>

                                    <!-- Marks out of 10 (Soft Violet) -->
                                    <td style="padding: 6px 8px; text-align: center; width: 135px; border-right: 1px solid #f1f5f9;">
                                        @if (item.IsAbsent)
                                        {
                                            <span style="display: inline-block; padding: 4px 10px; font-size: 0.78rem; font-weight: 700; color: #be123c; background: #ffe4e6; border-radius: 6px;">
                                                ABSENT
                                            </span>
                                        }
                                        else
                                        {
                                            <input type="number" min="0" max="10" step="0.5"
                                                   value="@(item.MarksOutOf10?.ToString("0.#") ?? "")"
                                                   @onchange="@((ChangeEventArgs e) => OnMarksChanged(item, e.Value?.ToString()))"
                                                   placeholder="Score"
                                                   style="width: 100%; text-align: center; font-weight: 800; font-size: 1.05rem; color: @GetMarksColor(item.MarksOutOf10); padding: 6px 8px; border: 1px solid #ddd6fe; border-radius: 8px; background: #f5f3ff; outline: none;" />
                                        }
                                    </td>

                                    <!-- Feedback -->
                                    <td style="padding: 6px 10px; border-right: 1px solid #f1f5f9;">
                                        <textarea rows="2"
                                                  value="@item.Feedback"
                                                  @onchange="@((ChangeEventArgs e) => OnFeedbackChanged(item, e.Value?.ToString()))"
                                                  placeholder="Feedback, concept clarity, SQL queries, areas of improvement..."
                                                  style="width: 100%; font-size: 0.84rem; line-height: 1.4; padding: 6px 10px; border: 1px solid #e2e8f0; border-radius: 8px; background: #ffffff; color: #1e293b; resize: vertical; outline: none;"></textarea>
                                    </td>

                                    <!-- Absent Toggle / Action -->
                                    <td style="padding: 6px 8px; text-align: center; width: 95px;">
                                        <button type="button" @onclick="@(() => OnAbsentToggled(item, !item.IsAbsent))"
                                                style="display: inline-flex; align-items: center; justify-content: center; gap: 4px; padding: 5px 10px; border-radius: 9999px; font-size: 0.75rem; font-weight: 700; border: 1px solid @(item.IsAbsent ? "#fecdd3" : "#e2e8f0"); background: @(item.IsAbsent ? "#ffe4e6" : "#f8fafc"); color: @(item.IsAbsent ? "#be123c" : "#64748b"); cursor: pointer; transition: all 0.2s;">
                                            <span>@(item.IsAbsent ? "❌ Absent" : "✔ Present")</span>
                                        </button>
                                    </td>
                                </tr>
                    }
                </tbody>
            </table>
        </MudPaper>
    }
</MudContainer>

<!-- Dialog: Add Student to Drive -->
<MudDialog @bind-Visible="_addStudentVisible" Options="_smallDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: 700;">Add Student to Mock Feedback Sheet</MudText>
    </TitleContent>
    <DialogContent>
        <MudSelect T="int" @bind-Value="_newStudentId" Label="Select Student" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
            @foreach (var s in _availableStudents)
            {
                <MudSelectItem Value="@s.Id">@s.FullName (@s.StudentCode)</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _addStudentVisible = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Class="btn-gradient-primary" OnClick="SaveAddStudent">Add Student</MudButton>
    </DialogActions>
</MudDialog>

<!-- Dialog: Schedule Flexible Month-End Drive -->
<MudDialog @bind-Visible="_createDriveVisible" Options="_mediumDialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Style="font-weight: 700;">Schedule Month-End Mock Interview</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <!-- 1-Click Flexible Month-End Presets -->
        <div class="pa-3 mb-3" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
            <div style="font-size: 0.78rem; font-weight: 700; color: #475569; margin-bottom: 6px;">
                ⚡ 1-CLICK FLEXIBLE MONTH-END PRESETS:
            </div>
            <div class="d-flex flex-wrap gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => ApplyDatePreset(GetLastSaturday(DateTime.Today)))">
                    Last Saturday (@GetLastSaturday(DateTime.Today).ToString("dd MMM"))
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => ApplyDatePreset(GetLastSunday(DateTime.Today)))">
                    Last Sunday (@GetLastSunday(DateTime.Today).ToString("dd MMM"))
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                           OnClick="@(() => ApplyDatePreset(GetLastSaturday(DateTime.Today.AddMonths(1))))">
                    Next Month (@GetLastSaturday(DateTime.Today.AddMonths(1)).ToString("dd MMM"))
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                           OnClick="@(() => ApplyDatePreset(DateTime.Today))">
                    Today
                </MudButton>
            </div>
        </div>

        <MudDatePicker @bind-Date="_newDriveDate" Label="Drive Date (Flexible)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

        <MudSelect T="int?" @bind-Value="_newDriveCourseId" Label="Subject / Course (Marks will be evaluated for this subject)"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                   SelectedValuesChanged="OnNewDriveCourseChanged">
            <MudSelectItem Value="@((int?)null)">-- Select Subject / Course --</MudSelectItem>
            @foreach (var c in _courses)
            {
                <MudSelectItem Value="@((int?)c.Id)">@c.CourseCode — @c.CourseName</MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="_newDriveTitle" Label="Drive Title" Placeholder="e.g. Mock Feedback — CDS40010 (Month End September 2026)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Required="true" />

        <div class="d-flex gap-3 mb-3">
            <MudSelect T="string" @bind-Value="_newDriveStatus" Label="Drive Status" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex: 1;">
                <MudSelectItem Value="@("Scheduled")">Scheduled</MudSelectItem>
                <MudSelectItem Value="@("In Progress")">In Progress</MudSelectItem>
                <MudSelectItem Value="@("Completed")">Completed</MudSelectItem>
            </MudSelect>

            <MudSelect T="int?" @bind-Value="_newDriveLeadInterviewerId" Label="Panel Lead / Interviewer" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex: 1;">
                <MudSelectItem Value="@((int?)null)">-- Select Faculty (Optional) --</MudSelectItem>
                @foreach (var f in _faculties)
                {
                    <MudSelectItem Value="@((int?)f.Id)">@f.FullName (@f.Organization)</MudSelectItem>
                }
            </MudSelect>
        </div>

        <MudTextField @bind-Value="_newDriveNotes" Label="Focus Areas & Panel Notes" Placeholder="e.g. Month-end evaluation: SQL complex joins, DBMS theory, communication, and DC concepts." Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _createDriveVisible = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Class="btn-gradient-primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveNewDrive">Schedule Drive</MudButton>
    </DialogActions>
</MudDialog>

<!-- Dialog: Reschedule / Edit Drive -->
<MudDialog @bind-Visible="_editDriveVisible" Options="_mediumDialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.EditCalendar" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Style="font-weight: 700;">Reschedule / Edit Mock Drive</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="pa-3 mb-3" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
            <div style="font-size: 0.78rem; font-weight: 700; color: #475569; margin-bottom: 6px;">
                ⚡ QUICK RESCHEDULE PRESETS:
            </div>
            <div class="d-flex flex-wrap gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => ApplyEditDatePreset(GetLastSaturday(DateTime.Today)))">
                    Last Sat (@GetLastSaturday(DateTime.Today).ToString("dd MMM"))
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => ApplyEditDatePreset(GetLastSunday(DateTime.Today)))">
                    Last Sun (@GetLastSunday(DateTime.Today).ToString("dd MMM"))
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                           OnClick="@(() => ApplyEditDatePreset(GetLastSaturday(DateTime.Today.AddMonths(1))))">
                    Next Month (@GetLastSaturday(DateTime.Today.AddMonths(1)).ToString("dd MMM"))
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                           OnClick="@(() => ApplyEditDatePreset(DateTime.Today))">
                    Today
                </MudButton>
            </div>
        </div>

        <MudDatePicker @bind-Date="_editingDriveDate" Label="Drive Date (Flexible)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

        <MudSelect T="int?" @bind-Value="_editingDriveCourseId" Label="Subject / Course"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
            <MudSelectItem Value="@((int?)null)">-- No Specific Subject --</MudSelectItem>
            @foreach (var c in _courses)
            {
                <MudSelectItem Value="@((int?)c.Id)">@c.CourseCode — @c.CourseName</MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="_editingDriveTitle" Label="Drive Title" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Required="true" />

        <div class="d-flex gap-3 mb-3">
            <MudSelect T="string" @bind-Value="_editingDriveStatus" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex: 1;">
                <MudSelectItem Value="@("Scheduled")">Scheduled</MudSelectItem>
                <MudSelectItem Value="@("In Progress")">In Progress</MudSelectItem>
                <MudSelectItem Value="@("Completed")">Completed</MudSelectItem>
            </MudSelect>

            <MudSelect T="int?" @bind-Value="_editingDriveLeadInterviewerId" Label="Panel Lead / Interviewer" Variant="Variant.Outlined" Margin="Margin.Dense" Style="flex: 1;">
                <MudSelectItem Value="@((int?)null)">-- Keep Current --</MudSelectItem>
                @foreach (var f in _faculties)
                {
                    <MudSelectItem Value="@((int?)f.Id)">@f.FullName (@f.Organization)</MudSelectItem>
                }
            </MudSelect>
        </div>

        <MudTextField @bind-Value="_editingDriveNotes" Label="Focus Areas & Panel Notes" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _editDriveVisible = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Class="btn-gradient-primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveEditDrive">Update Drive</MudButton>
    </DialogActions>
</MudDialog>

<!-- Dialog: Delete Drive Confirmation -->
<MudDialog @bind-Visible="_deleteDriveVisible" Options="_smallDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: 700; color: #dc2626;">Delete Mock Interview Drive</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-2">
            Are you sure you want to delete <strong>@_activeDrive?.Title</strong>?
