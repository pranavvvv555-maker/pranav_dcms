    private static string ShortenSubject(string? subject)
    {
        if (string.IsNullOrWhiteSpace(subject)) return "";
        var parts = subject.Split(new[] { '—', '-' }, StringSplitOptions.TrimEntries);
        if (parts.Length > 0 && parts[0].Length <= 12)
            return parts[0];
        return subject.Length > 15 ? subject.Substring(0, 15) + "..." : subject;
    }

