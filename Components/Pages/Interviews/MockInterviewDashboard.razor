@code {
    private List<MockInterviewDrive> _drives = new();
    private MockInterviewDrive? _activeDrive;
    private List<MockInterviewEvaluation> _evaluations = new();
    private MockInterviewReadinessStats _stats = new();
    private List<Faculty> _faculties = new();

    private int _selectedDriveId;
    private string _searchQuery = "";
    private HashSet<int> _modifiedEvaluationIds = new();

    private bool _addStudentVisible;
    private int _newStudentId;
    private string _newStudentGroup = "Group A";
    private List<Student> _availableStudents = new();

    private bool _createDriveVisible;
    private string _newDriveTitle = "";
    private DateTime? _newDriveDate = GetLastSaturday(DateTime.Today);
    private string _newDriveStatus = "Scheduled";
    private int? _newDriveLeadInterviewerId;
    private string? _newDriveNotes;

    private bool _editDriveVisible;
    private string _editingDriveTitle = "";
    private DateTime? _editingDriveDate;
    private string _editingDriveStatus = "Scheduled";
    private int? _editingDriveLeadInterviewerId;
    private string? _editingDriveNotes;

    private bool _deleteDriveVisible;

    private DialogOptions _smallDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
    private DialogOptions _mediumDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

    protected override async Task OnInitializedAsync()
    {
        _faculties = await FacultySvc.GetAllAsync();
        await LoadDrives();
    }

    private async Task LoadDrives()
    {
        _drives = await InterviewSvc.GetDrivesAsync();
        if (_drives.Any())
        {
            if (_selectedDriveId == 0 || !_drives.Any(d => d.Id == _selectedDriveId))
                _selectedDriveId = _drives.First().Id;

            await LoadActiveDrive();
        }
        else
        {
            _activeDrive = null;
            _evaluations = new();
            _stats = new();
        }
    }

    private async Task OnDriveChanged(int driveId)
    {
        if (_modifiedEvaluationIds.Any())
        {
            await SaveAllChanges();
        }

        _selectedDriveId = driveId;
        await LoadActiveDrive();
    }

    private async Task LoadActiveDrive()
    {
        if (_selectedDriveId > 0)
        {
            _activeDrive = await InterviewSvc.GetDriveWithEvaluationsAsync(_selectedDriveId);
            _evaluations = _activeDrive?.Evaluations.ToList() ?? new();
            _stats = await InterviewSvc.GetOverallReadinessStatsAsync(_selectedDriveId);
            _modifiedEvaluationIds.Clear();
        }
    }

    private string? GetLeadInterviewerName()
    {
        var facultyId = _evaluations.FirstOrDefault(e => e.InterviewerFacultyId.HasValue)?.InterviewerFacultyId;
        if (facultyId.HasValue)
        {
            return _faculties.FirstOrDefault(f => f.Id == facultyId.Value)?.FullName;
        }
        return null;
    }

    private static DateTime GetLastDayOfWeekOfMonth(DateTime refDate, DayOfWeek dayOfWeek)
    {
        var daysInMonth = DateTime.DaysInMonth(refDate.Year, refDate.Month);
        var lastDay = new DateTime(refDate.Year, refDate.Month, daysInMonth);
        while (lastDay.DayOfWeek != dayOfWeek)
        {
            lastDay = lastDay.AddDays(-1);
        }
        return lastDay;
    }

    private static DateTime GetLastSaturday(DateTime refDate) => GetLastDayOfWeekOfMonth(refDate, DayOfWeek.Saturday);
    private static DateTime GetLastSunday(DateTime refDate) => GetLastDayOfWeekOfMonth(refDate, DayOfWeek.Sunday);

    private void ApplyDatePreset(DateTime date)
    {
        _newDriveDate = date;
        _newDriveTitle = $"Mock Feedback — {date:dd-MM-yyyy}";
        _newDriveNotes = $"Month-end student interview evaluation for {date:MMMM yyyy}. Focus: SQL complex joins, DBMS theory, communication, and DC concepts.";
        _newDriveStatus = date > DateTime.Today ? "Scheduled" : "Completed";
    }

    private void ApplyEditDatePreset(DateTime date)
    {
        _editingDriveDate = date;
        _editingDriveTitle = $"Mock Feedback — {date:dd-MM-yyyy}";
    }

    private IEnumerable<string> DistinctGroups
    {
        get
        {
            return _evaluations
                .Select(e => string.IsNullOrWhiteSpace(e.StudentGroup) ? "Group A" : e.StudentGroup)
                .Distinct()
                .OrderBy(g => g);
        }
    }

    private List<MockInterviewEvaluation> GetGroupEvaluations(string groupName)
    {
        var list = _evaluations.Where(e => (string.IsNullOrWhiteSpace(e.StudentGroup) ? "Group A" : e.StudentGroup) == groupName);

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            list = list.Where(e => (e.Student?.FullName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return list.ToList();
    }

    private void OnConfidenceChanged(MockInterviewEvaluation item, string? rawValue)
    {
        if (decimal.TryParse(rawValue, out var val))
            item.ConfidenceScore = Math.Clamp(val, 0, 10);
        else
            item.ConfidenceScore = null;

        _modifiedEvaluationIds.Add(item.Id);
    }

    private void OnCommunicationChanged(MockInterviewEvaluation item, string? rawValue)
    {
        if (decimal.TryParse(rawValue, out var val))
            item.CommunicationScore = Math.Clamp(val, 0, 10);
        else
            item.CommunicationScore = null;

        _modifiedEvaluationIds.Add(item.Id);
    }

    private void OnTechnicalChanged(MockInterviewEvaluation item, string? rawValue)
    {
        if (decimal.TryParse(rawValue, out var val))
            item.TechnicalScore = Math.Clamp(val, 0, 10);
        else
            item.TechnicalScore = null;

        _modifiedEvaluationIds.Add(item.Id);
    }

    private void OnMarksChanged(MockInterviewEvaluation item, string? rawValue)
    {
        if (decimal.TryParse(rawValue, out var val))
            item.MarksOutOf10 = Math.Clamp(val, 0, 10);
        else
            item.MarksOutOf10 = null;

        _modifiedEvaluationIds.Add(item.Id);
    }

    private void OnFeedbackChanged(MockInterviewEvaluation item, string? rawValue)
    {
        item.Feedback = rawValue;
        _modifiedEvaluationIds.Add(item.Id);
    }

    private void OnGroupChanged(MockInterviewEvaluation item, string? group)
    {
        if (!string.IsNullOrWhiteSpace(group))
        {
            item.StudentGroup = group;
            _modifiedEvaluationIds.Add(item.Id);
        }
    }

    private void OnAbsentToggled(MockInterviewEvaluation item, bool isAbsent)
    {
        item.IsAbsent = isAbsent;
        if (isAbsent)
        {
            item.ConfidenceScore = null;
            item.CommunicationScore = null;
            item.TechnicalScore = null;
            item.MarksOutOf10 = null;
            item.Status = "Absent";
            if (string.IsNullOrWhiteSpace(item.Feedback))
            {
                item.Feedback = "absent";
            }
        }
        else
        {
            item.Status = "Completed";
            if (item.Feedback == "absent")
            {
                item.Feedback = "";
            }
        }
        _modifiedEvaluationIds.Add(item.Id);
    }

    private void AutoCalculateMarks()
    {
        int count = 0;
        foreach (var item in _evaluations.Where(e => !e.IsAbsent))
        {
            if (item.ConfidenceScore.HasValue && item.CommunicationScore.HasValue && item.TechnicalScore.HasValue)
            {
                var avg = Math.Round((item.ConfidenceScore.Value + item.CommunicationScore.Value + item.TechnicalScore.Value) / 3m, 1);
                if (item.MarksOutOf10 != avg)
                {
                    item.MarksOutOf10 = avg;
                    _modifiedEvaluationIds.Add(item.Id);
                    count++;
                }
            }
        }

        if (count > 0)
        {
            Snackbar.Add($"Calculated marks for {count} student(s). Click 'Save Changes' to apply.", Severity.Success);
        }
        else
        {
            Snackbar.Add("All eligible students already have calculated marks.", Severity.Info);
        }
    }

    private async Task SaveAllChanges()
    {
        if (!_modifiedEvaluationIds.Any())
        {
            Snackbar.Add("No unsaved changes.", Severity.Info);
            return;
        }

        try
        {
            var modifiedItems = _evaluations.Where(e => _modifiedEvaluationIds.Contains(e.Id)).ToList();
            await InterviewSvc.SaveEvaluationsBatchAsync(modifiedItems);
            _modifiedEvaluationIds.Clear();
            _stats = await InterviewSvc.GetOverallReadinessStatsAsync(_selectedDriveId);
            Snackbar.Add($"Saved {modifiedItems.Count} student evaluation(s) successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving evaluations: {ex.Message}", Severity.Error);
        }
    }

    private async Task DiscardChanges()
    {
        _modifiedEvaluationIds.Clear();
        await LoadActiveDrive();
        Snackbar.Add("Unsaved changes discarded.", Severity.Normal);
    }

    private async Task OpenAddStudentDialog()
    {
        if (_selectedDriveId <= 0) return;
        _availableStudents = await InterviewSvc.GetAvailableStudentsForDriveAsync(_selectedDriveId);
        if (!_availableStudents.Any())
        {
            Snackbar.Add("All enrolled students are already added to this mock interview drive.", Severity.Info);
            return;
        }
        _newStudentId = _availableStudents.First().Id;
        _newStudentGroup = "Group A";
        _addStudentVisible = true;
    }

    private async Task SaveAddStudent()
    {
        if (_newStudentId <= 0 || _selectedDriveId <= 0) return;
        try
        {
            await InterviewSvc.AddStudentToDriveAsync(_selectedDriveId, _newStudentId, _newStudentGroup);
            _addStudentVisible = false;
            Snackbar.Add("Student added to mock feedback sheet.", Severity.Success);
            await LoadActiveDrive();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding student: {ex.Message}", Severity.Error);
        }
    }

    private void OpenCreateDriveDialog()
    {
        var defaultDate = GetLastSaturday(DateTime.Today);
        _newDriveDate = defaultDate;
        _newDriveTitle = $"Mock Feedback — {defaultDate:dd-MM-yyyy}";
        _newDriveStatus = defaultDate > DateTime.Today ? "Scheduled" : "Completed";
        _newDriveLeadInterviewerId = _faculties.FirstOrDefault(f => f.FullName.Contains("Siddu") || f.Organization == "NIRVAA")?.Id;
        _newDriveNotes = $"Month-end corporate interview drive for {defaultDate:MMMM yyyy}. Evaluating Confidence, Communication, and Technical SQL & DC skills.";
        _createDriveVisible = true;
    }

    private async Task SaveNewDrive()
    {
        if (string.IsNullOrWhiteSpace(_newDriveTitle))
        {
            Snackbar.Add("Please enter drive title.", Severity.Warning);
            return;
        }

        var semester = await CourseSvc.GetActiveSemesterAsync() ?? (await CourseSvc.GetSemestersAsync()).FirstOrDefault();
        if (semester == null) return;

        var drive = new MockInterviewDrive
        {
            SemesterId = semester.Id,
            Title = _newDriveTitle.Trim(),
            DriveDate = _newDriveDate ?? DateTime.Today,
            Status = _newDriveStatus,
            PanelNotes = _newDriveNotes?.Trim()
        };

        try
        {
            var created = await InterviewSvc.CreateDriveAsync(drive, _newDriveLeadInterviewerId);
            _createDriveVisible = false;
            _selectedDriveId = created.Id;
            Snackbar.Add("Mock feedback drive scheduled successfully.", Severity.Success);
            await LoadDrives();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OpenEditDriveDialog()
    {
        if (_activeDrive == null) return;

        _editingDriveTitle = _activeDrive.Title;
        _editingDriveDate = _activeDrive.DriveDate;
        _editingDriveStatus = _activeDrive.Status;
        _editingDriveNotes = _activeDrive.PanelNotes;
        _editingDriveLeadInterviewerId = _evaluations.FirstOrDefault(e => e.InterviewerFacultyId.HasValue)?.InterviewerFacultyId;

        _editDriveVisible = true;
    }

    private async Task SaveEditDrive()
    {
        if (_activeDrive == null) return;
        if (string.IsNullOrWhiteSpace(_editingDriveTitle))
        {
            Snackbar.Add("Please enter a title.", Severity.Warning);
            return;
        }

        _activeDrive.Title = _editingDriveTitle.Trim();
        _activeDrive.DriveDate = _editingDriveDate ?? _activeDrive.DriveDate;
        _activeDrive.Status = _editingDriveStatus;
        _activeDrive.PanelNotes = _editingDriveNotes?.Trim();

        try
        {
            await InterviewSvc.UpdateDriveAsync(_activeDrive, _editingDriveLeadInterviewerId);
            _editDriveVisible = false;
            Snackbar.Add("Drive details and schedule updated.", Severity.Success);
            await LoadDrives();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OpenDeleteDriveDialog()
    {
        if (_activeDrive == null) return;
        _deleteDriveVisible = true;
    }

    private async Task ConfirmDeleteDrive()
    {
        if (_selectedDriveId <= 0) return;

        try
        {
            await InterviewSvc.DeleteDriveAsync(_selectedDriveId);
            _deleteDriveVisible = false;
            _selectedDriveId = 0;
            Snackbar.Add("Mock interview drive deleted.", Severity.Success);
            await LoadDrives();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private string GetMarksColor(decimal? marks)
    {
        if (!marks.HasValue) return "#475569";
        if (marks.Value >= 8.5m) return "#15803d"; // Green
        if (marks.Value >= 6.0m) return "#1d4ed8"; // Blue
        return "#b45309"; // Amber
    }

    private string GetDriveStatusBorderColor(string? status) => status switch
    {
        "Completed" => "#10b981",
        "In Progress" => "#8b5cf6",
        _ => "#2563eb"
    };

    private Color GetDriveStatusChipColor(string? status) => status switch
    {
        "Completed" => Color.Success,
        "In Progress" => Color.Secondary,
        _ => Color.Info
    };

    private string GetDriveBadgeBackground(string? status) => status switch
    {
        "Completed" => "#dcfce7",
        "In Progress" => "#f3e8ff",
        _ => "#dbeafe"
    };

    private string GetDriveBadgeColor(string? status) => status switch
    {
        "Completed" => "#166534",
        "In Progress" => "#6b21a8",
        _ => "#1e40af"
    };

    private async Task ExportCsv()
    {
        if (!_evaluations.Any())
        {
            Snackbar.Add("No evaluations to export.", Severity.Warning);
            return;
        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Sr,STUDENT NAME,Confidence,Communication,Technical,Marks out of 10,Feedback");

        foreach (var group in DistinctGroups)
        {
            sb.AppendLine($",,,{group},,,");
            int sr = 1;
            foreach (var e in GetGroupEvaluations(group))
            {
                var conf = e.IsAbsent ? "" : (e.ConfidenceScore?.ToString("0.#") ?? "");
                var comm = e.IsAbsent ? "" : (e.CommunicationScore?.ToString("0.#") ?? "");
                var tech = e.IsAbsent ? "" : (e.TechnicalScore?.ToString("0.#") ?? "");
                var marks = e.IsAbsent ? "absent" : (e.MarksOutOf10?.ToString("0.#") ?? "");
                var cleanFeedback = (e.Feedback ?? "").Replace("\"", "\"\"");

                sb.AppendLine($"{sr++},\"{e.Student?.FullName}\",{conf},{comm},{tech},{marks},\"{cleanFeedback}\"");
            }
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"{(_activeDrive?.Title ?? "MockFeedback").Replace(" ", "_")}.csv";

        await JS.InvokeVoidAsync("downloadFileFromBase64", fileName, "text/csv;charset=utf-8", base64);
        Snackbar.Add("Mock Feedback sheet downloaded.", Severity.Success);
    }
}
