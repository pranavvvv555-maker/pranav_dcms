    private void OnAbsentToggled(MockInterviewEvaluation item, bool isAbsent)
    {
        item.IsAbsent = isAbsent;
        if (isAbsent)
        {
            item.ConfidenceScore = null;
            item.CommunicationScore = null;
            item.TechnicalScore = null;
            item.MarksOutOf10 = null;
            item.Status = "Absent";
            if (string.IsNullOrWhiteSpace(item.Feedback))
            {
                item.Feedback = "absent";
            }
        }
        else
        {
            item.Status = "Completed";
            if (item.Feedback == "absent")
            {
                item.Feedback = "";
            }
        }
        _modifiedEvaluationIds.Add(item.Id);
    }

    private void AutoCalculateMarks()
    {
        int count = 0;
        foreach (var item in _evaluations.Where(e => !e.IsAbsent))
        {
            if (item.ConfidenceScore.HasValue && item.CommunicationScore.HasValue && item.TechnicalScore.HasValue)
            {
                var avg = Math.Round((item.ConfidenceScore.Value + item.CommunicationScore.Value + item.TechnicalScore.Value) / 3m, 1);
                if (item.MarksOutOf10 != avg)
                {
                    item.MarksOutOf10 = avg;
                    _modifiedEvaluationIds.Add(item.Id);
                    count++;
                }
            }
        }

        if (count > 0)
        {
            Snackbar.Add($"Calculated marks for {count} student(s). Click 'Save Changes' to apply.", Severity.Success);
        }
        else
        {
            Snackbar.Add("All eligible students already have calculated marks.", Severity.Info);
        }
    }

