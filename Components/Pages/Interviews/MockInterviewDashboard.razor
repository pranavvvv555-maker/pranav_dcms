<!-- Dialog: Import Excel / CSV Sheet -->
<MudDialog @bind-Visible="_importVisible" Options="_largeDialogOptions">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.UploadFile" Color="Color.Tertiary" />
            <div>
                <MudText Typo="Typo.h6" Style="font-weight: 800; line-height: 1.2;">Import Marks Spreadsheet (.xlsx / .csv)</MudText>
                <MudText Typo="Typo.caption" Style="color: #64748b;">
                    Forgiving automatic header & column detection · Auto-handles missing columns & empty rows
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_isParsing)
        {
            <div class="pa-8 text-center">
                <MudProgressCircular Color="Color.Tertiary" Indeterminate="true" Size="Size.Large" Class="mb-3" />
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Analyzing and mapping spreadsheet columns...</MudText>
                <MudText Typo="Typo.caption" Style="color: #64748b;">Detecting headers, calculating factor averages, and matching student codes.</MudText>
            </div>
        }
        else if (_parsedImport == null)
        {
            <!-- Upload Drop Area -->
            <div class="pa-6 text-center" style="border: 2px dashed #93c5fd; background: #f8fafc; border-radius: 12px; transition: all 0.2s;">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Style="font-size: 3.5rem; color: #3b82f6;" Class="mb-2" />
                <MudText Typo="Typo.h6" Style="font-weight: 700; color: #1e293b;">Select an Excel (.xlsx) or CSV (.csv) file</MudText>
                <MudText Typo="Typo.body2" Style="color: #64748b;" Class="mb-4">
                    Upload your faculty marksheet. Even if 2–3 columns (like factors or roll no) or some cells are missing, DCMS smartly adapts and maps the data.
                </MudText>

                <div class="d-flex justify-center gap-3 align-center flex-wrap">
                    <label style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 22px; background: linear-gradient(135deg, #2563eb, #1d4ed8); color: white; border-radius: 8px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);">
                        <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" />
                        <span>Browse Spreadsheet</span>
                        <InputFile OnChange="OnImportFileSelected" accept=".xlsx,.xls,.csv" style="display: none;" />
                    </label>

                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadTemplate">
                        Download Pre-filled Template
                    </MudButton>

                    <MudButton Variant="Variant.Filled" Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.AssignmentTurnedIn" OnClick="LoadBundledScheduleExcel">
                        Load ACC & DSS CCA1 Schedule
                    </MudButton>
                </div>

                <div class="mt-4 pt-3" style="border-top: 1px solid #e2e8f0; font-size: 0.8rem; color: #64748b; text-align: left;">
                    <strong>💡 Resilient Column & Multi-Sheet Support:</strong>
                    <ul style="margin: 4px 0 0 18px; padding: 0;">
                        <li><strong>Multi-Sheet:</strong> Smartly detects and extracts the sheet containing marks/evaluations (e.g. <code>MARKS</code>, <code>Evaluation</code>) even if preceded by <code>Attendance</code> or schedule sheets.</li>
                        <li><strong>Student:</strong> Recognizes <code>Name</code>, <code>Student Name</code>, <code>Candidate</code>, or <code>Roll / PRN / Student Code</code>.</li>
                        <li><strong>Scores:</strong> Accepts <code>CCA1(10)</code>, <code>Marks / 10</code>, or individual <code>Confidence</code>, <code>Communication</code>, <code>Technical</code> factors.</li>
                        <li><strong>Attendance:</strong> Rows marked <code>Absent</code>, <code>Ab.</code>, or <code>AB</code> are accurately flagged as Absent.</li>
                    </ul>
                </div>
            </div>
        }
        else
        {
            <!-- File Info & Mappings Banner -->
            <div class="pa-3 mb-3 d-flex flex-wrap align-center justify-space-between gap-2" style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 8px;">
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Color="Color.Primary" />
                    <div>
                        <strong style="color: #0f172a; font-size: 0.92rem;">@_parsedImport.FileName</strong>
                        @if (!string.IsNullOrWhiteSpace(_parsedImport.SheetName))
                        {
                            <span style="font-size: 0.78rem; background: #e0e7ff; color: #3730a3; padding: 2px 8px; border-radius: 6px; font-weight: 700; margin-left: 6px; border: 1px solid #c7d2fe;">
                                Worksheet: @_parsedImport.SheetName
                            </span>
                        }
                        <span style="font-size: 0.78rem; color: #64748b; margin-left: 8px;">(@_parsedImport.TotalRowsRead total rows read)</span>
                    </div>
                </div>

                <div class="d-flex align-center gap-3">
                    @if (_parsedImport.AvailableSheets.Count > 1)
                    {
                        <div class="d-flex align-center gap-1">
                            <span style="font-size: 0.75rem; color: #475569; font-weight: 600;">Worksheet:</span>
                            <select value="@_parsedImport.SheetName" @onchange="OnSheetSelectionChanged" 
                                    style="font-size: 0.78rem; font-weight: 700; padding: 3px 8px; border-radius: 6px; border: 1px solid #94a3b8; background: white; color: #1e293b;">
                                @foreach (var s in _parsedImport.AvailableSheets)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>
                    }

                    <label style="font-size: 0.8rem; font-weight: 600; color: #2563eb; cursor: pointer; text-decoration: underline;">
                        Upload Different File
                        <InputFile OnChange="OnImportFileSelected" accept=".xlsx,.xls,.csv" style="display: none;" />
                    </label>
                </div>
            </div>

            <!-- Detected Headers & Handled Notes -->
            <div class="mb-3 pa-3" style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px;">
                <div style="font-size: 0.75rem; font-weight: 800; color: #166534; margin-bottom: 4px;">
                    ✔ DETECTED COLUMNS:
                </div>
                <div class="d-flex flex-wrap gap-1 mb-2">
                    @foreach (var col in _parsedImport.DetectedHeaders)
                    {
                        <span style="font-size: 0.75rem; padding: 2px 8px; border-radius: 9999px; background: #dcfce7; color: #15803d; font-weight: 600; border: 1px solid #86efac;">
                            @col
                        </span>
                    }
                </div>

                @if (_parsedImport.HandledNotes.Any())
                {
                    <div style="font-size: 0.75rem; font-weight: 800; color: #854d0e; margin-top: 6px; margin-bottom: 4px;">
                        ⚡ SMART OMISSIONS ADAPTATION:
                    </div>
                    <ul style="margin: 0 0 0 16px; padding: 0; font-size: 0.78rem; color: #713f12;">
                        @foreach (var note in _parsedImport.HandledNotes)
                        {
                            <li>@note</li>
                        }
                    </ul>
                }
            </div>

            <!-- Summary Badges -->
            <div class="d-flex flex-wrap gap-2 mb-3">
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Style="font-weight: 700;">
                    ✔ @_parsedImport.MatchedCount Matched to Roster
                </MudChip>
                @if (_parsedImport.NewStudentsCount > 0)
                {
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Size="Size.Small" Style="font-weight: 700;">
                        ➕ @_parsedImport.NewStudentsCount New Student(s) to Enroll
                    </MudChip>
                }
                @if (_parsedImport.AbsentCount > 0)
                {
                    <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small" Style="font-weight: 700;">
                        ⚠️ @_parsedImport.AbsentCount Absent
                    </MudChip>
                }
            </div>

            <div class="d-flex align-center justify-space-between mb-2">
                <MudCheckBox T="bool" @bind-Value="_autoCreateMissingStudents" Color="Color.Primary" Dense="true">
                    <span style="font-size: 0.82rem; font-weight: 600; color: #334155;">
                        Auto-enroll missing students in active semester if not found in roster
                    </span>
                </MudCheckBox>
                <span style="font-size: 0.75rem; color: #64748b;">
                    Showing all @_parsedImport.Rows.Count student rows (scroll to inspect)
                </span>
            </div>

            <!-- Preview Table -->
            <div style="max-height: 280px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 8px;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.82rem;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; position: sticky; top: 0; z-index: 1;">
                            <th style="padding: 8px 10px; text-align: center; color: #475569;">#</th>
                            <th style="padding: 8px 12px; text-align: left; color: #334155;">STUDENT</th>
                            <th style="padding: 8px 10px; text-align: center; color: #334155;">STATUS</th>
                            <th style="padding: 8px 8px; text-align: center; color: #334155;">CONF</th>
                            <th style="padding: 8px 8px; text-align: center; color: #334155;">COMM</th>
                            <th style="padding: 8px 8px; text-align: center; color: #334155;">TECH</th>
                            <th style="padding: 8px 8px; text-align: center; color: #334155; font-weight: 800;">MARKS</th>
                            <th style="padding: 8px 12px; text-align: left; color: #334155;">FEEDBACK</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _parsedImport.Rows)
                        {
                            <tr style="border-bottom: 1px solid #f1f5f9; background: @(r.IsAbsent ? "#fff1f2" : "#ffffff");">

                                <td style="padding: 6px 10px; text-align: center; color: #64748b;">@r.RowIndex</td>
                                <td style="padding: 6px 12px;">
                                    <div style="font-weight: 700; color: #0f172a;">@(string.IsNullOrWhiteSpace(r.MatchedStudentName) ? r.RawName : r.MatchedStudentName)</div>
                                    <div style="font-size: 0.72rem; color: #64748b;">@(string.IsNullOrWhiteSpace(r.MatchedStudentRoll) ? r.RawRoll : r.MatchedStudentRoll)</div>
                                </td>
                                <td style="padding: 6px 10px; text-align: center;">
                                    @if (r.MatchStatus == "Matched Drive")
                                    {
                                        <span style="font-size: 0.7rem; font-weight: 700; padding: 2px 6px; border-radius: 4px; background: #dcfce7; color: #166534;">Enrolled</span>
                                    }
                                    else if (r.MatchStatus == "Matched Semester")
                                    {
                                        <span style="font-size: 0.7rem; font-weight: 700; padding: 2px 6px; border-radius: 4px; background: #e0f2fe; color: #0369a1;">Semester</span>
                                    }
                                    else
                                    {
                                        <span style="font-size: 0.7rem; font-weight: 700; padding: 2px 6px; border-radius: 4px; background: #fef3c7; color: #92400e;">New</span>
                                    }
                                </td>
                                <td style="padding: 6px 8px; text-align: center; color: #b45309;">@(r.Confidence?.ToString("0.#") ?? "-")</td>
                                <td style="padding: 6px 8px; text-align: center; color: #047857;">@(r.Communication?.ToString("0.#") ?? "-")</td>
                                <td style="padding: 6px 8px; text-align: center; color: #0369a1;">@(r.Technical?.ToString("0.#") ?? "-")</td>
                                <td style="padding: 6px 8px; text-align: center; font-weight: 800; color: @(r.IsAbsent ? "#dc2626" : "#4338ca");">
                                    @(r.IsAbsent ? "ABSENT" : (r.Marks?.ToString("0.#") ?? "-"))
                                </td>
                                <td style="padding: 6px 12px; color: #475569; max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    @(r.Feedback ?? "-")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </DialogContent>
    <DialogActions>
        @if (_parsedImport != null)
        {
            <MudButton OnClick="ResetImport" Variant="Variant.Text">Choose Another File</MudButton>
        }
        <MudButton OnClick="@(() => _importVisible = false)">Cancel</MudButton>
        @if (_parsedImport != null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle"
                       OnClick="ConfirmImport" Disabled="@(_isImporting || _parsedImport.ValidStudentsCount == 0)">
                @if (_isImporting)
                {
                    <span>Importing...</span>
                }
                else
                {
                    <span>Confirm & Import (@_parsedImport.ValidStudentsCount records)</span>
                }
            </MudButton>
        }
    </DialogActions>
</MudDialog>

