    private byte[]? _lastUploadedFileBytes;
    private string? _lastUploadedFileName;

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _isParsing = true;
        StateHasChanged();

        try
        {
            // Allow up to 15MB
            using var stream = file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            _lastUploadedFileBytes = ms.ToArray();
            _lastUploadedFileName = file.Name;

            using var parseMs = new MemoryStream(_lastUploadedFileBytes);
            _parsedImport = await ImportSvc.ParseEvaluationSheetAsync(parseMs, file.Name, _selectedDriveId);

            if (!string.IsNullOrWhiteSpace(_parsedImport.WarningMessage))
            {
                Snackbar.Add(_parsedImport.WarningMessage, Severity.Warning);
            }
            else
            {
                Snackbar.Add($"Parsed {_parsedImport.ValidStudentsCount} student rows successfully from sheet '{_parsedImport.SheetName ?? "default"}'.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error reading spreadsheet: {ex.Message}", Severity.Error);
            _parsedImport = null;
        }
        finally
        {
            _isParsing = false;
            StateHasChanged();
        }
    }

    private async Task OnSheetSelectionChanged(ChangeEventArgs e)
    {
        var sheet = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(sheet) || _lastUploadedFileBytes == null || _selectedDriveId <= 0) return;

        _isParsing = true;
        StateHasChanged();
        try
        {
            using var ms = new MemoryStream(_lastUploadedFileBytes);
            _parsedImport = await ImportSvc.ParseEvaluationSheetAsync(ms, _lastUploadedFileName ?? "data.xlsx", _selectedDriveId, sheet);
            Snackbar.Add($"Switched to worksheet '{sheet}'.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error switching worksheet: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isParsing = false;
            StateHasChanged();
        }
    }

    private async Task LoadBundledScheduleExcel()
    {
        if (_selectedDriveId <= 0) return;

        var paths = new[]
        {
            Path.Combine(HostEnv.ContentRootPath, "Data", "ACC & DSS CCA1 SCHEDULE.xlsx"),
            Path.Combine(HostEnv.WebRootPath, "templates", "ACC & DSS CCA1 SCHEDULE.xlsx"),
            @"C:\Users\prana\Documents\ACC & DSS CCA1 SCHEDULE.xlsx"
        };

        var filePath = paths.FirstOrDefault(File.Exists);
        if (filePath == null)
        {
            Snackbar.Add("ACC & DSS CCA1 SCHEDULE.xlsx could not be located on the server.", Severity.Warning);
            return;
        }

        _isParsing = true;
        StateHasChanged();

        try
        {
            using (var fs = new FileStream(filePath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
            {
                using var ms = new MemoryStream();
                await fs.CopyToAsync(ms);
                _lastUploadedFileBytes = ms.ToArray();
                _lastUploadedFileName = Path.GetFileName(filePath);
            }

            using var parseMs = new MemoryStream(_lastUploadedFileBytes);
            _parsedImport = await ImportSvc.ParseEvaluationSheetAsync(parseMs, _lastUploadedFileName, _selectedDriveId);
            Snackbar.Add($"Loaded {_parsedImport.ValidStudentsCount} students from {_lastUploadedFileName} (Sheet: {_parsedImport.SheetName}).", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed loading schedule Excel: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isParsing = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmImport()
    {
        if (_parsedImport == null || _selectedDriveId <= 0) return;

        _isImporting = true;
        StateHasChanged();

        try
        {
            var (updated, created, absent) = await ImportSvc.ApplyImportAsync(
                _selectedDriveId, 
                _parsedImport.Rows, 
                _autoCreateMissingStudents);

            _importVisible = false;
            _parsedImport = null;

            Snackbar.Add($"Import Complete! {updated} evaluations updated, {created} new students enrolled, {absent} marked absent.", Severity.Success);
            await LoadActiveDrive();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Import failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isImporting = false;
            StateHasChanged();
        }
    }
}
