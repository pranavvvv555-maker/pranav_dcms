                <MudText Typo="Typo.h6" Style="color:#102a43; font-weight:800;">Executive Sanction Cover Page Generator</MudText>
                <MudText Typo="Typo.caption" Style="color:#64748b;">Official Memorandum for Executive Sanction · Select any date range to generate this executive cover page</MudText>
            </div>
        </div>
