            <!-- 2. Memorandum Reference Details (Editable) -->
            <MudExpansionPanels Elevation="0">
                <MudExpansionPanel Text="Memorandum Reference & Sign-off Details" Style="background:#ffffff; border:1px solid #e2e8f0; border-radius:8px;">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_sanctionRefNo" Label="Reference Number" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
