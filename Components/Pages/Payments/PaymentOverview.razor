    private async Task OpenExecutiveSanctionDialog()
    {
        _sanctionStartDate ??= new DateTime(2026, 8, 1);
        _sanctionEndDate ??= new DateTime(2026, 8, 31);
        _sanctionMemoDate ??= new DateTime(2026, 8, 31);
        _executiveSanctionDialogVisible = true;
        await LoadSanctionData();
    }

    private async Task SetSanctionRange(DateTime start, DateTime end)
    {
        _sanctionStartDate = start;
        _sanctionEndDate = end;
        _sanctionMemoDate = end;
        if (start.Year == end.Year && start.Month == end.Month)
        {
            _sanctionCycleLabel = start.ToString("MMMM yyyy").ToUpper();
        }
        else
        {
            _sanctionCycleLabel = $"{start:dd MMM yyyy} – {end:dd MMM yyyy}".ToUpper();
        }
        _sanctionRefNo = $"NIRVAA/DCMS/ES/{start:yyyy}/{start:MM}-{end:dd}";
        await LoadSanctionData();
    }

    private async Task OnSanctionStartDateChanged(DateTime? date)
    {
        _sanctionStartDate = date;
        if (_sanctionStartDate.HasValue && _sanctionEndDate.HasValue)
        {
            await LoadSanctionData();
        }
    }

    private async Task OnSanctionEndDateChanged(DateTime? date)
    {
        _sanctionEndDate = date;
        if (_sanctionStartDate.HasValue && _sanctionEndDate.HasValue)
        {
            _sanctionMemoDate = _sanctionEndDate;
            await LoadSanctionData();
        }
    }

    private async Task LoadSanctionData()
    {
        if (!_sanctionStartDate.HasValue || !_sanctionEndDate.HasValue) return;

        try
        {
            _isLoadingSanctionData = true;
            StateHasChanged();

            _sanctionData = await PaymentSvc.GetExecutiveSanctionDataAsync(
                _sanctionStartDate.Value,
                _sanctionEndDate.Value,
                _sanctionRefNo,
                _sanctionMemoDate ?? _sanctionEndDate.Value,
                _sanctionCycleLabel,
                null,
                _sanctionStatus);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load sanction data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoadingSanctionData = false;
            StateHasChanged();
        }
    }

