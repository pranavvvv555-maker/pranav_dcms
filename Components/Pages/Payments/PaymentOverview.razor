                        </FooterContent>
                    </MudTable>
                </MudPaper>

                <!-- 7. Certification, Enclosures & Words Strip -->
                <div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; padding:8px 12px; font-size:0.75rem;">
                    <div style="color:#1e293b;">
                        <b>Amount in Words:</b> @_sanctionData.AmountInWords | <b>Mode:</b> @_sanctionData.PaymentMode
                    </div>
                    <div style="color:#64748b; margin-top:2px;">
                        <b>Enclosures:</b> @_sanctionData.EnclosuresText
                    </div>
                </div>

                <!-- 8. Executive Review & Signature Matrix Preview -->
                <div>
                    <div style="font-weight:800; font-size:0.75rem; color:#102a43; text-transform:uppercase; margin-bottom:6px;">
                        Executive Review & Signature Approval Matrix (4 Boxes)
                    </div>
                    <MudGrid Spacing="2">
                        @foreach (var sig in _sanctionData.ApprovalMatrix)
                        {
                            <MudItem xs="12" sm="6">
                                <MudPaper Elevation="0" Class="pa-3" Style="border:1px solid #cbd5e1; border-radius:6px; background:#f8fafc;">
                                    <div style="font-size:0.75rem; font-weight:800; color:#0284c7;">@sig.StepTitle</div>
                                    <div style="font-size:0.75rem; font-weight:700; color:#0f172a;">@sig.Name <span style="font-weight:400; color:#64748b;">| @sig.Designation</span></div>
                                    <div style="font-size:0.7rem; color:#64748b; margin-top:2px;">Scope: @sig.Scope</div>
                                    <div style="font-size:0.7rem; color:#334155; margin-top:4px;">Status: [ ] @sig.StatusText | Date: ____________</div>
                                    <div style="font-size:0.7rem; color:#334155; margin-top:4px;">Signature: ____________________________________</div>
