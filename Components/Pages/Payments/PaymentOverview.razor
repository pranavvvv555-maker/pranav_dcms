                            <MudTh Style="width:90px; text-align:center;">Voucher</MudTh>
                            <MudTh>Faculty Member</MudTh>
                            <MudTh>Subject & Conduction Schedule</MudTh>
                            <MudTh Style="text-align:center;">Hours</MudTh>
                            <MudTh Style="text-align:right;">Rate (INR)</MudTh>
                            <MudTh Style="text-align:right;">Payable (INR)</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Style="text-align:center;">@context.SrNo</MudTd>
                            <MudTd Style="text-align:center;">
                                <span style="font-weight:700; font-size:0.75rem; color:#102a43; background:#f1f5f9; padding:2px 6px; border-radius:4px;">
                                    @context.VoucherNo
                                </span>
                            </MudTd>
                            <MudTd>
                                <div style="font-weight:700; color:#0f172a;">@context.FacultyName</div>
                                <div style="font-size:0.72rem; color:#64748b;">@context.DesignationOrRole</div>
                            </MudTd>
                            <MudTd>
                                <div style="font-weight:600; color:#0f172a;">@context.SubjectAndCode</div>
                                <div style="font-size:0.72rem; color:#0284c7;">@context.ConductionSchedule</div>
                            </MudTd>
                            <MudTd Style="text-align:center; font-weight:600;">@context.Hours.ToString("0.#")h</MudTd>
                            <MudTd Style="text-align:right;">₹@context.Rate.ToString("N0")</MudTd>
                            <MudTd Style="text-align:right; font-weight:800; color:#102a43;">₹@context.PayableAmount.ToString("N0")</MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTd colspan="4" Style="font-weight:800; background:#e2e8f0; color:#102a43;">
                                TOTAL CONSOLIDATED REMUNERATION (@_sanctionData.CycleTitle.ToUpper())
