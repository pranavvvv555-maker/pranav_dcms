                    <div style="font-weight:700; font-size:0.8rem; color:#1e293b; margin-bottom:4px;">Respected Authorities,</div>
                    <div style="font-size:0.76rem; color:#334155; line-height:1.45;">@_sanctionData.ExecutiveNarrative</div>
                </div>

                <!-- 6. Itemized Faculty Conduction Schedule Table -->
                <MudPaper Elevation="0" Style="border:1px solid #e2e8f0; border-radius:8px; overflow:hidden;">
                    <div class="pa-2 px-3" style="background:#102a43; color:white; font-weight:700; font-size:0.8rem;">
                        Audited Faculty Remuneration Schedule (@_sanctionData.CycleTitle)
                    </div>
                    <MudTable Items="@_sanctionData.FacultyItems" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
