@page "/payment-overview"
@rendermode InteractiveServer
@inject PaymentService PaymentSvc
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IWebHostEnvironment HostEnv

<PageTitle>DCMS — Faculty Compensation Overview</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2 simple-page">
    <!-- Executive Header -->
    <section class="payover-header" aria-label="Faculty compensation overview banner">
        <div>
            <span class="premium-eyebrow">
                <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Small" Class="mr-1" />
                MIT-WPU × NIRVAA · Executive Compensation Ledger
            </span>
            <h1 class="payover-header__title">Faculty Payment & Conduction Overview</h1>
            <p class="payover-header__subtitle">
                Dual-horizon financial audit and lecture/practical register. Filter by any month (e.g. January), inspect conducted classes, and generate official NIRVAA & MIT-WPU payment receipts.
            </p>
        </div>
        <div class="payover-header__actions">
            <MudButton Href="/weekend" Variant="Variant.Filled" Class="btn-gradient-primary" StartIcon="@Icons.Material.Filled.CalendarMonth">
                Weekend Desk
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Article" OnClick="OpenExecutiveSanctionDialog">
                Executive Cover Page
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Receipt" OnClick="DownloadAllReceipts" Disabled="@(!_paymentOverview.Any())">
                All Receipts (PDF)
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="DownloadPdfReport" Disabled="@(!_paymentOverview.Any())">
                Summary PDF
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportToExcel" Disabled="@(!_paymentOverview.Any())">
                Export Excel
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintLedger">
                Print Ledger
            </MudButton>
        </div>
    </section>

    <!-- Interactive Navigation and Control Toolbar -->
    <section class="payover-controls" aria-label="Date navigation and filters">
        <div class="d-flex align-center flex-wrap gap-2 w-100 mb-2">
            <!-- Mode Selector: By Month vs Specific Dates -->
            <div class="d-inline-flex" style="background:#f1f5f9; padding:3px; border-radius:8px; border:1px solid #cbd5e1;">
                <MudButton Size="Size.Small"
                           Variant="@(_dateMode == DateSelectionMode.Month ? Variant.Filled : Variant.Text)"
                           Color="@(_dateMode == DateSelectionMode.Month ? Color.Primary : Color.Default)"
                           StartIcon="@Icons.Material.Filled.CalendarMonth"
                           OnClick="@(() => SwitchMode(DateSelectionMode.Month))"
                           Style="font-weight:700; font-size:0.8rem; text-transform:none;">
                    By Month
                </MudButton>
                <MudButton Size="Size.Small"
                           Variant="@(_dateMode == DateSelectionMode.DateRange ? Variant.Filled : Variant.Text)"
                           Color="@(_dateMode == DateSelectionMode.DateRange ? Color.Primary : Color.Default)"
                           StartIcon="@Icons.Material.Filled.DateRange"
                           OnClick="@(() => SwitchMode(DateSelectionMode.DateRange))"
                           Style="font-weight:700; font-size:0.8rem; text-transform:none;">
                    Specific Dates
                </MudButton>
            </div>

            <MudDivider Vertical="true" FlexItem="true" Class="mx-2 d-none d-md-flex" />

            @if (_dateMode == DateSelectionMode.Month)
            {
                <!-- Month & Year Selector Strip -->
                <div class="d-flex align-center flex-wrap gap-2">
                    <div class="month-quick-selector">
                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Color="Color.Primary" Size="Size.Small" />
                        <span style="font-size:0.75rem; font-weight:800; color:#164e80; text-transform:uppercase;">Month:</span>
                        <MudSelect T="int" Value="@_referenceDate.Month" ValueChanged="OnMonthSelected" Dense="true" Margin="Margin.Dense" Variant="Variant.Text" Style="min-width:130px; font-weight:700;">
                            <MudSelectItem Value="1">January</MudSelectItem>
                            <MudSelectItem Value="2">February</MudSelectItem>
                            <MudSelectItem Value="3">March</MudSelectItem>
                            <MudSelectItem Value="4">April</MudSelectItem>
                            <MudSelectItem Value="5">May</MudSelectItem>
                            <MudSelectItem Value="6">June</MudSelectItem>
                            <MudSelectItem Value="7">July</MudSelectItem>
                            <MudSelectItem Value="8">August</MudSelectItem>
                            <MudSelectItem Value="9">September</MudSelectItem>
                            <MudSelectItem Value="10">October</MudSelectItem>
                            <MudSelectItem Value="11">November</MudSelectItem>
                            <MudSelectItem Value="12">December</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="int" Value="@_referenceDate.Year" ValueChanged="OnYearSelected" Dense="true" Margin="Margin.Dense" Variant="Variant.Text" Style="min-width:90px; font-weight:700;">
                            <MudSelectItem Value="2025">2025</MudSelectItem>
                            <MudSelectItem Value="2026">2026</MudSelectItem>
                            <MudSelectItem Value="2027">2027</MudSelectItem>
                        </MudSelect>
                    </div>

                    <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="@(() => ShiftMonth(-1))" aria-label="Previous Month" />
                        <MudButton OnClick="ShowCurrentMonth" Style="font-weight:700; font-size:0.75rem;">This Month</MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="@(() => ShiftMonth(1))" aria-label="Next Month" />
                    </MudButtonGroup>
                </div>
            }
            else
            {
                <!-- Specific Dates: From Date and To Date pickers -->
                <div class="d-flex align-center flex-wrap gap-2">
                    <MudDatePicker Date="@_customStartDate" DateChanged="OnCustomStartDateChanged" Label="From Date"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:150px;" />
                    <MudDatePicker Date="@_customEndDate" DateChanged="OnCustomEndDateChanged" Label="To Date"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:150px;" />

                    <!-- Quick Presets -->
                    <div class="d-flex flex-wrap gap-1">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary" OnClick="PresetThisWeekend">
                            Weekend
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary" OnClick="PresetFirstHalf">
                            1st–15th
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary" OnClick="PresetSecondHalf">
                            16th–End
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary" OnClick="PresetFullMonth">
                            Whole Month
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default" OnClick="PresetToday">
                            Today
                        </MudButton>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex align-center justify-space-between flex-wrap gap-2 w-100">
            <!-- Active Period Badge -->
            <div class="d-flex align-center flex-wrap gap-2">
                <span class="status-pill" style="background:#e0f2fe; color:#0369a1; font-weight:700; font-size:0.78rem; padding:4px 10px; border-radius:12px; border:1px solid #bae6fd;">
                    <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Small" Style="vertical-align:text-bottom; margin-right:4px;" />
                    Active Period: <b>@PeriodLabel</b>
                </span>
                <span style="font-size:0.75rem; color:#64748b; font-weight:600;">
                    (@PeriodStart.ToString("dd MMM yyyy") – @PeriodEnd.ToString("dd MMM yyyy") · @PeriodDaysCount day@(PeriodDaysCount == 1 ? "" : "s"))
                </span>
            </div>

            <MudTextField @bind-Value="_searchText" Placeholder="Search professor..." Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Class="payover-controls__search" Clearable="true" />
        </div>
    </section>

    <!-- 4 High-Impact KPI Metric Cards -->
    <section class="payover-kpi-grid" aria-label="Summary financial metrics">
        <!-- Card 1: Weekend Payout -->
        <div class="payover-kpi payover-kpi--emerald">
            <div class="payover-kpi__top">
                <span class="payover-kpi__label">Weekend Payout</span>
                <span class="payover-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.CurrencyRupee" /></span>
            </div>
            <div>
                <div class="payover-kpi__value">₹@TotalWeekendPay.ToString("N0")</div>
                <div class="payover-kpi__caption">
                    <b>@TotalWeekendLectures</b> lectures · <b>@TotalWeekendPracticals</b> practicals (@WeekendLabelShort)
                </div>
            </div>
        </div>

        <!-- Card 2: Selected Month Payout -->
        <div class="payover-kpi payover-kpi--sapphire">
            <div class="payover-kpi__top">
                <span class="payover-kpi__label">@MonthLabel Payout</span>
                <span class="payover-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" /></span>
            </div>
            <div>
                <div class="payover-kpi__value">₹@TotalMonthPay.ToString("N0")</div>
                <div class="payover-kpi__caption">
                    <b>@TotalMonthLectures</b> lectures · <b>@TotalMonthPracticals</b> practicals in @MonthLabel
                </div>
            </div>
        </div>

        <!-- Card 3: Monthly Lectures & Practicals Conduction -->
        <div class="payover-kpi payover-kpi--amber">
            <div class="payover-kpi__top">
                <span class="payover-kpi__label">@MonthLabel Conduction</span>
                <span class="payover-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.MenuBook" /></span>
            </div>
            <div>
                <div class="payover-kpi__value">@(TotalMonthLectures + TotalMonthPracticals) <small style="font-size:1.1rem; color:#786134;">classes</small></div>
                <div class="payover-kpi__caption">
                    <b>@TotalMonthLectures</b> Theory Lectures · <b>@TotalMonthPracticals</b> Practical Labs
                </div>
            </div>
        </div>

        <!-- Card 4: Active Faculty Participation -->
        <div class="payover-kpi payover-kpi--indigo">
            <div class="payover-kpi__top">
                <span class="payover-kpi__label">Active Faculty</span>
                <span class="payover-kpi__icon"><MudIcon Icon="@Icons.Material.Filled.Groups" /></span>
            </div>
            <div>
                <div class="payover-kpi__value">@ActiveMonthFacultyCount <small style="font-size:1.1rem; color:#5c5691;">/ @_paymentOverview.Count</small></div>
                <div class="payover-kpi__caption">
                    <b>@NirvaaActiveMonthCount</b> NIRVAA · <b>@MitActiveMonthCount</b> MIT-WPU teaching in @MonthLabel
                </div>
            </div>
        </div>
    </section>

    <!-- Main Table Container -->
    <MudPaper Elevation="0" Class="payover-table-card">
        <div class="payover-table-header">
            <div>
                <span class="premium-eyebrow">Faculty Register & Remuneration · @MonthLabel</span>
                <MudText Typo="Typo.h6" Class="payover-table-header__title">Conducted Classes and Calculated Compensation</MudText>
                <div class="payover-table-header__subtitle">
                    Showing @FilteredFaculty.Count() professors · <b>@FilteredMonthLectures</b> Lectures & <b>@FilteredMonthPracticals</b> Practicals in @MonthLabel.
                </div>
            </div>

            <!-- Conduction and Organization Filters -->
            <div class="payover-filters">
                <MudButton Variant="Variant.Text" Class="@($"payover-filter-chip {(_selectedFilter == "All" ? "payover-filter-chip--active" : "")}")"
                           OnClick="@(() => _selectedFilter = "All")">
                    All Classes (@_paymentOverview.Count)
                </MudButton>
                <MudButton Variant="Variant.Text" Class="@($"payover-filter-chip {(_selectedFilter == "LecturesOnly" ? "payover-filter-chip--active" : "")}")"
                           OnClick="@(() => _selectedFilter = "LecturesOnly")">
                    Lectures Only (@_paymentOverview.Count(f => f.MonthlyLectureCount > 0))
                </MudButton>
                <MudButton Variant="Variant.Text" Class="@($"payover-filter-chip {(_selectedFilter == "PracticalsOnly" ? "payover-filter-chip--active" : "")}")"
                           OnClick="@(() => _selectedFilter = "PracticalsOnly")">
                    Practicals Only (@_paymentOverview.Count(f => f.MonthlyPracticalCount > 0))
                </MudButton>
                <MudButton Variant="Variant.Text" Class="@($"payover-filter-chip {(_selectedFilter == "ActiveMonth" ? "payover-filter-chip--active" : "")}")"
                           OnClick="@(() => _selectedFilter = "ActiveMonth")">
                    Active in @MonthLabel (@ActiveMonthFacultyCount)
                </MudButton>
                <MudButton Variant="Variant.Text" Class="@($"payover-filter-chip {(_selectedFilter == "NIRVAA" ? "payover-filter-chip--active" : "")}")"
                           OnClick="@(() => _selectedFilter = "NIRVAA")">
                    NIRVAA (@_paymentOverview.Count(f => f.Organization == "NIRVAA"))
                </MudButton>
                <MudButton Variant="Variant.Text" Class="@($"payover-filter-chip {(_selectedFilter == "MIT-WPU" ? "payover-filter-chip--active" : "")}")"
                           OnClick="@(() => _selectedFilter = "MIT-WPU")">
                    MIT-WPU (@_paymentOverview.Count(f => f.Organization == "MIT-WPU"))
                </MudButton>
            </div>
        </div>

        @if (FilteredFaculty.Any())
        {
            <div class="payover-table-wrapper simple-table">
                <MudDataGrid Items="@FilteredFaculty" Dense="false" Hover="true" Elevation="0">
                    <Columns>
                        <!-- Professor Identity Column -->
                        <TemplateColumn Title="Professor & Organization">
                            <CellTemplate>
                                <div class="faculty-profile-cell">
                                    <MudAvatar Class="@($"faculty-profile-avatar {(context.Item.Organization == "NIRVAA" ? "faculty-profile-avatar--nirvaa" : "faculty-profile-avatar--mit")}")">
                                        @GetInitials(context.Item.FacultyName)
                                    </MudAvatar>
                                    <div>
                                        <div class="faculty-profile-name">@context.Item.FacultyName</div>
                                        <div class="faculty-profile-tags">
                                            <span class="@($"org-tag {(context.Item.Organization == "NIRVAA" ? "org-tag--nirvaa" : "org-tag--mit")}")">
                                                @context.Item.Organization
                                            </span>
                                            <span class="role-tag">
                                                @(string.IsNullOrWhiteSpace(context.Item.Designation) ? context.Item.Role : $"{context.Item.Designation} · {context.Item.Role}")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>

                        <!-- Base Fees -->
                        <TemplateColumn Title="Configured Fees">
                            <CellTemplate>
                                <div style="display:flex; flex-direction:column; gap:3px;">
                                    <span class="fee-inline">L: ₹@context.Item.LectureRate.ToString("N0")</span>
                                    <span class="fee-inline fee-inline--blue">P: ₹@context.Item.PracticalRate.ToString("N0")</span>
                                </div>
                            </CellTemplate>
                        </TemplateColumn>

                        <!-- Weekend Classes -->
                        <TemplateColumn Title="Weekend Conducted">
                            <CellTemplate>
                                @if (context.Item.WeeklyLectureCount > 0 || context.Item.WeeklyPracticalCount > 0)
                                {
                                    <div class="class-mix-badge class-mix-badge--active">
                                        <b>@context.Item.WeeklyLectureCount</b> L · <b>@context.Item.WeeklyPracticalCount</b> P
                                    </div>
                                }
                                else
                                {
                                    <div class="class-mix-badge class-mix-badge--empty">0 classes</div>
                                }
                            </CellTemplate>
                        </TemplateColumn>

                        <!-- Weekend Earnings -->
                        <TemplateColumn Title="Weekend Pay">
                            <CellTemplate>
                                @if (context.Item.WeeklyPayableAmount > 0)
                                {
                                    <span class="money-badge money-badge--weekend">
                                        ₹@context.Item.WeeklyPayableAmount.ToString("N0")
                                    </span>
                                }
                                else
                                {
                                    <span class="money-badge money-badge--zero">—</span>
                                }
                            </CellTemplate>
                        </TemplateColumn>

                        <!-- Month Classes -->
                        <TemplateColumn Title="@($"{MonthLabel} Conducted")">
                            <CellTemplate>
                                @if (context.Item.MonthlyLectureCount > 0 || context.Item.MonthlyPracticalCount > 0)
                                {
                                    <div class="class-mix-badge class-mix-badge--active" style="background:#eaf4fd; border-color:#bedcf7;">
                                        <b>@context.Item.MonthlyLectureCount</b> Lectures · <b>@context.Item.MonthlyPracticalCount</b> Practicals
                                    </div>
                                }
                                else
                                {
                                    <div class="class-mix-badge class-mix-badge--empty">0 classes in @MonthLabelShort</div>
                                }
                            </CellTemplate>
                        </TemplateColumn>

                        <!-- Month Earnings -->
                        <TemplateColumn Title="@($"{MonthLabel} Pay")">
                            <CellTemplate>
                                @if (context.Item.MonthlyPayableAmount > 0)
                                {
                                    <span class="money-badge money-badge--month">
                                        ₹@context.Item.MonthlyPayableAmount.ToString("N0")
                                    </span>
                                }
                                else
                                {
                                    <span class="money-badge money-badge--zero">—</span>
                                }
                            </CellTemplate>
                        </TemplateColumn>

                        <!-- Actions -->
                        <TemplateColumn Title="">
                            <CellTemplate>
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Visibility"
                                               OnClick="@(() => OpenBreakdownDialog(context.Item))">
                                        View Classes
                                    </MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Receipt"
                                               OnClick="@(() => DownloadSingleReceipt(context.Item))">
                                        Receipt
                                    </MudButton>
                                </MudStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </MudDataGrid>
            </div>

            <!-- Grand Totals Footer Strip -->
            <div class="payover-table-footer">
                <div>
                    <MudText Typo="Typo.subtitle2" Style="color:#102a43; font-weight:800;">
                        Aggregated Cohort Remuneration (@MonthLabel)
                    </MudText>
                    <MudText Typo="Typo.caption" Style="color:#60758b;">
                        Calculated from @FilteredFaculty.Count() professors · Total @FilteredMonthLectures Lectures & @FilteredMonthPracticals Practicals
                    </MudText>
                </div>
                <div class="payover-table-footer__totals">
                    <div>
                        <span>Weekend Payout Total</span>
                        <strong class="tot-weekend">₹@FilteredWeekendPay.ToString("N0")</strong>
                    </div>
                    <div>
                        <span>@MonthLabel Payout Total</span>
                        <strong class="tot-month">₹@FilteredMonthPay.ToString("N0")</strong>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="simple-empty-state">
                <MudIcon Icon="@Icons.Material.Filled.PersonSearch" />
                <div>
                    <MudText Typo="Typo.subtitle1">No professors match the selected filters for @MonthLabel</MudText>
                    <MudText Typo="Typo.body2">Try selecting "All Classes" or switching to another month above.</MudText>
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => { _selectedFilter = "All"; _searchText = ""; })">
                    Reset filters
                </MudButton>
            </div>
        }
    </MudPaper>
</MudContainer>

<!-- Detailed Session Breakdown Dialog -->
<MudDialog @bind-Visible="_breakdownDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <div class="dialog-title-simple">
            <span class="dialog-title-simple__icon dialog-title-simple__icon--blue">
                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
            </span>
            <div>
                <MudText Typo="Typo.h6">Class Conduction & Fee Breakdown</MudText>
                <MudText Typo="Typo.caption">Detailed audit of conducted lectures & practicals for @MonthLabel</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_selectedFaculty is not null)
        {
            <div class="breakdown-prof-card">
                <div class="faculty-profile-cell">
                    <MudAvatar Class="@($"faculty-profile-avatar {(_selectedFaculty.Organization == "NIRVAA" ? "faculty-profile-avatar--nirvaa" : "faculty-profile-avatar--mit")}")">
                        @GetInitials(_selectedFaculty.FacultyName)
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.subtitle1" Style="font-weight:800; color:#102a43;">
                            @_selectedFaculty.FacultyName
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:#60758b;">
                            @_selectedFaculty.Organization · @_selectedFaculty.Role @(!string.IsNullOrWhiteSpace(_selectedFaculty.Designation) ? $"({_selectedFaculty.Designation})" : "")
                        </MudText>
                    </div>
                </div>
                <div class="breakdown-rates">
                    <span class="breakdown-rate-pill breakdown-rate-pill--lec">
                        Lecture: ₹@_selectedFaculty.LectureRate.ToString("N0")
                    </span>
                    <span class="breakdown-rate-pill breakdown-rate-pill--prac">
                        Practical: ₹@_selectedFaculty.PracticalRate.ToString("N0")
                    </span>
                </div>
            </div>

            <MudTabs Rounded="true" Elevation="0" Class="payover-breakdown-tabs" ApplyEffectsToContainer="true">
                <!-- Tab 1: Month Sessions -->
                <MudTabPanel Text="@($"{MonthLabel} Classes ({_selectedFaculty.MonthlySessions.Count})")" Icon="@Icons.Material.Filled.DateRange">
                    @if (_selectedFaculty.MonthlySessions.Any())
                    {
                        <div class="simple-table mt-3">
                            <MudTable Items="@_selectedFaculty.MonthlySessions" Dense="true" Hover="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>Date</MudTh>
                                    <MudTh>Subject</MudTh>
                                    <MudTh>Class Type</MudTh>
                                    <MudTh>Timing</MudTh>
                                    <MudTh Style="text-align:right;">Amount</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd><b>@context.Date.ToString("ddd, dd MMM yyyy")</b></MudTd>
                                    <MudTd>
                                        <div>@context.CourseName</div>
                                        <small style="color:#71849a;">@context.CourseCode</small>
                                    </MudTd>
                                    <MudTd>
                                        <span class="@($"type-pill type-pill--{context.SessionType.ToLowerInvariant()}")">@context.SessionType</span>
                                    </MudTd>
                                    <MudTd>@FormatTime(context.StartTime) – @FormatTime(context.EndTime)</MudTd>
                                    <MudTd Style="text-align:right; font-weight:800; color:#104373;">₹@context.Amount.ToString("N0")</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                        <div class="breakdown-summary-banner" style="background:#f0f7fd; border-color:#bddcf6;">
                            <div>
                                <span style="color:#1d5b91;">Monthly Compensation Formula (@MonthLabel)</span>
                                <em style="color:#1e5ca8;">(@_selectedFaculty.MonthlyLectureCount lectures × ₹@_selectedFaculty.LectureRate.ToString("N0")) + (@_selectedFaculty.MonthlyPracticalCount practicals × ₹@_selectedFaculty.PracticalRate.ToString("N0"))</em>
                            </div>
                            <div>
                                <span style="color:#1d5b91;">Month Total</span>
                                <strong style="color:#104373;">₹@_selectedFaculty.MonthlyPayableAmount.ToString("N0")</strong>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="simple-empty-state mt-3">
                            <MudIcon Icon="@Icons.Material.Filled.EventBusy" />
                            <div>
                                <MudText Typo="Typo.subtitle1">No classes recorded for @MonthLabel</MudText>
                                <MudText Typo="Typo.body2">This professor has 0 lectures and 0 practicals recorded for @MonthLabel.</MudText>
                            </div>
                        </div>
                    }
                </MudTabPanel>

                <!-- Tab 2: Weekend Sessions -->
                <MudTabPanel Text="@($"Weekend Classes ({_selectedFaculty.WeeklySessions.Count})")" Icon="@Icons.Material.Filled.CalendarMonth">
                    @if (_selectedFaculty.WeeklySessions.Any())
                    {
                        <div class="simple-table mt-3">
                            <MudTable Items="@_selectedFaculty.WeeklySessions" Dense="true" Hover="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>Date</MudTh>
                                    <MudTh>Subject</MudTh>
                                    <MudTh>Class Type</MudTh>
                                    <MudTh>Timing</MudTh>
                                    <MudTh Style="text-align:right;">Amount</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd><b>@context.Date.ToString("ddd, dd MMM")</b></MudTd>
                                    <MudTd>
                                        <div>@context.CourseName</div>
                                        <small style="color:#71849a;">@context.CourseCode</small>
                                    </MudTd>
                                    <MudTd>
                                        <span class="@($"type-pill type-pill--{context.SessionType.ToLowerInvariant()}")">@context.SessionType</span>
                                    </MudTd>
                                    <MudTd>@FormatTime(context.StartTime) – @FormatTime(context.EndTime)</MudTd>
                                    <MudTd Style="text-align:right; font-weight:800; color:#047857;">₹@context.Amount.ToString("N0")</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </div>
                        <div class="breakdown-summary-banner">
                            <div>
                                <span>Weekend Compensation Formula</span>
                                <em>(@_selectedFaculty.WeeklyLectureCount lectures × ₹@_selectedFaculty.LectureRate.ToString("N0")) + (@_selectedFaculty.WeeklyPracticalCount practicals × ₹@_selectedFaculty.PracticalRate.ToString("N0"))</em>
                            </div>
                            <div>
                                <span>Weekend Total</span>
                                <strong>₹@_selectedFaculty.WeeklyPayableAmount.ToString("N0")</strong>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="simple-empty-state mt-3">
                            <MudIcon Icon="@Icons.Material.Filled.EventBusy" />
                            <div>
                                <MudText Typo="Typo.subtitle1">No classes recorded for this weekend</MudText>
                                <MudText Typo="Typo.body2">This professor did not conduct any sessions during @WeekendLabel.</MudText>
                            </div>
                        </div>
                    }
                </MudTabPanel>
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        @if (_selectedFaculty is not null)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Receipt"
                       OnClick="@(() => DownloadSingleReceipt(_selectedFaculty))">
                Download Remuneration Receipt (PDF)
            </MudButton>
        }
        <MudButton Variant="Variant.Filled" Class="btn-gradient-primary" OnClick="@(() => _breakdownDialogVisible = false)">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Executive Sanction & Cover Page Generator Dialog -->
<MudDialog @bind-Visible="_executiveSanctionDialogVisible" Options="@(new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true })">
    <TitleContent>
        <div class="dialog-title-simple">
            <span class="dialog-title-simple__icon" style="background:#e0f2fe; color:#0284c7;">
