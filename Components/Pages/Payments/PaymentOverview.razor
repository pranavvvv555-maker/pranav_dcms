        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PictureAsPdf"
                   OnClick="DownloadSanctionDossier" Disabled="@(_sanctionData is null || !_sanctionData.FacultyItems.Any())">
            Download Complete Dossier (Cover + Vouchers)
        </MudButton>
        <MudButton Variant="Variant.Filled" Class="btn-gradient-primary" StartIcon="@Icons.Material.Filled.Description"
                   OnClick="DownloadSanctionCoverPage" Disabled="@(_sanctionData is null)">
            Download Cover Page (PDF)
        </MudButton>
        <MudButton Variant="Variant.Text" OnClick="@(() => _executiveSanctionDialogVisible = false)">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "date")]
    public DateTime? ReportDate { get; set; }

    private DateTime _referenceDate = DateTime.Today;
    private List<FacultyPaymentOverview> _paymentOverview = new();
    private string _searchText = "";
    private string _selectedFilter = "All";
    private bool _breakdownDialogVisible;
    private FacultyPaymentOverview? _selectedFaculty;

    // Executive Sanction State
    private bool _executiveSanctionDialogVisible;
    private DateTime? _sanctionStartDate = new DateTime(2026, 8, 1);
    private DateTime? _sanctionEndDate = new DateTime(2026, 8, 31);
    private string _sanctionRefNo = "NIRVAA/DCMS/ES/2026/08-01";
    private DateTime? _sanctionMemoDate = new DateTime(2026, 8, 31);
    private string _sanctionCycleLabel = "AUGUST 2026";
    private string _sanctionStatus = "Audited & Recommended";
    private ExecutiveSanctionData? _sanctionData;
    private bool _isLoadingSanctionData;

    private enum DateSelectionMode { Month, DateRange }
    private DateSelectionMode _dateMode = DateSelectionMode.Month;
    private DateTime? _customStartDate;
    private DateTime? _customEndDate;

    private DateTime WeekendStart => MostRecentFriday(_referenceDate);
    private DateTime WeekendEnd => WeekendStart.AddDays(2);
    private DateTime MonthStart => new(_referenceDate.Year, _referenceDate.Month, 1);
    private DateTime MonthEnd => MonthStart.AddMonths(1).AddDays(-1);

    private DateTime PeriodStart => _dateMode == DateSelectionMode.Month
        ? MonthStart
        : (_customStartDate ?? MonthStart);

    private DateTime PeriodEnd => _dateMode == DateSelectionMode.Month
        ? MonthEnd
        : (_customEndDate ?? MonthEnd);

    private int PeriodDaysCount => Math.Max(1, (int)(PeriodEnd.Date - PeriodStart.Date).TotalDays + 1);

    private string WeekendLabel => $"{WeekendStart:dd MMM} – {WeekendEnd:dd MMM yyyy}";
    private string WeekendLabelShort => $"{WeekendStart:dd MMM}–{WeekendEnd:dd MMM}";

    private string PeriodLabel
    {
        get
        {
            if (_dateMode == DateSelectionMode.Month)
                return _referenceDate.ToString("MMMM yyyy");

            if (PeriodStart.Date == PeriodEnd.Date)
                return PeriodStart.ToString("dd MMMM yyyy");

            if (PeriodStart.Year == PeriodEnd.Year && PeriodStart.Month == PeriodEnd.Month && PeriodStart.Day == 1 && PeriodEnd.Day == DateTime.DaysInMonth(PeriodStart.Year, PeriodStart.Month))
                return PeriodStart.ToString("MMMM yyyy");

            if (PeriodStart.Year == PeriodEnd.Year)
                return $"{PeriodStart:dd MMM} – {PeriodEnd:dd MMM yyyy}";

            return $"{PeriodStart:dd MMM yyyy} – {PeriodEnd:dd MMM yyyy}";
        }
    }

    private string PeriodLabelShort
    {
        get
        {
            if (_dateMode == DateSelectionMode.Month)
                return _referenceDate.ToString("MMM yyyy");

            if (PeriodStart.Date == PeriodEnd.Date)
                return PeriodStart.ToString("dd MMM");

            return $"{PeriodStart:dd MMM}–{PeriodEnd:dd MMM}";
        }
    }

    private string MonthLabel => PeriodLabel;
    private string MonthLabelShort => PeriodLabelShort;

    private IEnumerable<FacultyPaymentOverview> FilteredFaculty
    {
        get
        {
            var items = _paymentOverview.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchText))
            {
                items = items.Where(f =>
                    f.FacultyName.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                    (f.Designation?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    f.Organization.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
            }

            items = _selectedFilter switch
            {
                "LecturesOnly" => items.Where(f => f.MonthlyLectureCount > 0),
                "PracticalsOnly" => items.Where(f => f.MonthlyPracticalCount > 0),
                "ActiveMonth" => items.Where(f => f.MonthlyPayableAmount > 0 || f.MonthlyLectureCount > 0 || f.MonthlyPracticalCount > 0),
                "NIRVAA" => items.Where(f => f.Organization == "NIRVAA"),
                "MIT-WPU" => items.Where(f => f.Organization == "MIT-WPU"),
                _ => items
            };

            return items;
        }
    }

    // Totals for all faculty
    private decimal TotalWeekendPay => _paymentOverview.Sum(f => f.WeeklyPayableAmount);
    private decimal TotalMonthPay => _paymentOverview.Sum(f => f.MonthlyPayableAmount);
    private int TotalWeekendLectures => _paymentOverview.Sum(f => f.WeeklyLectureCount);
    private int TotalWeekendPracticals => _paymentOverview.Sum(f => f.WeeklyPracticalCount);
    private int TotalMonthLectures => _paymentOverview.Sum(f => f.MonthlyLectureCount);
    private int TotalMonthPracticals => _paymentOverview.Sum(f => f.MonthlyPracticalCount);
    private int ActiveMonthFacultyCount => _paymentOverview.Count(f => f.MonthlyPayableAmount > 0 || f.MonthlyLectureCount > 0 || f.MonthlyPracticalCount > 0);
    private int NirvaaActiveMonthCount => _paymentOverview.Count(f => f.Organization == "NIRVAA" && (f.MonthlyPayableAmount > 0 || f.MonthlyLectureCount > 0));
    private int MitActiveMonthCount => _paymentOverview.Count(f => f.Organization == "MIT-WPU" && (f.MonthlyPayableAmount > 0 || f.MonthlyLectureCount > 0));

    // Totals for filtered list
    private decimal FilteredWeekendPay => FilteredFaculty.Sum(f => f.WeeklyPayableAmount);
    private decimal FilteredMonthPay => FilteredFaculty.Sum(f => f.MonthlyPayableAmount);
    private int FilteredMonthLectures => FilteredFaculty.Sum(f => f.MonthlyLectureCount);
    private int FilteredMonthPracticals => FilteredFaculty.Sum(f => f.MonthlyPracticalCount);

    protected override async Task OnInitializedAsync()
    {
        if (ReportDate.HasValue)
            _referenceDate = ReportDate.Value.Date;

        _customStartDate = MonthStart;
        _customEndDate = MonthEnd;

        await LoadOverview();
    }

    private async Task SwitchMode(DateSelectionMode mode)
    {
        _dateMode = mode;
        if (_dateMode == DateSelectionMode.DateRange)
        {
            _customStartDate ??= MonthStart;
            _customEndDate ??= MonthEnd;
        }
        await LoadOverview();
    }

    private async Task OnCustomStartDateChanged(DateTime? date)
    {
        if (!date.HasValue) return;
        _customStartDate = date.Value.Date;
        if (_customEndDate.HasValue && _customStartDate > _customEndDate)
        {
            _customEndDate = _customStartDate;
        }
        await LoadOverview();
    }

    private async Task OnCustomEndDateChanged(DateTime? date)
    {
        if (!date.HasValue) return;
        _customEndDate = date.Value.Date;
        if (_customStartDate.HasValue && _customEndDate < _customStartDate)
        {
            _customStartDate = _customEndDate;
        }
        await LoadOverview();
    }

    private async Task SetPresetRange(DateTime start, DateTime end)
    {
        _dateMode = DateSelectionMode.DateRange;
        _customStartDate = start.Date;
        _customEndDate = end.Date;
        await LoadOverview();
    }

    private async Task PresetThisWeekend() => await SetPresetRange(WeekendStart, WeekendEnd);
    private async Task PresetFirstHalf() => await SetPresetRange(new DateTime(_referenceDate.Year, _referenceDate.Month, 1), new DateTime(_referenceDate.Year, _referenceDate.Month, 15));
    private async Task PresetSecondHalf() => await SetPresetRange(new DateTime(_referenceDate.Year, _referenceDate.Month, 16), MonthEnd);
    private async Task PresetFullMonth() => await SetPresetRange(MonthStart, MonthEnd);
    private async Task PresetToday() => await SetPresetRange(DateTime.Today, DateTime.Today);

    private async Task ChangeReferenceDate(DateTime? date)
    {
        if (!date.HasValue) return;
        _referenceDate = date.Value.Date;
        _customStartDate = MonthStart;
        _customEndDate = MonthEnd;
        await LoadOverview();
    }

    private async Task OnMonthSelected(int month)
    {
        var daysInMonth = DateTime.DaysInMonth(_referenceDate.Year, month);
        var targetDay = Math.Min(_referenceDate.Day, daysInMonth);
        _referenceDate = new DateTime(_referenceDate.Year, month, targetDay);
        _customStartDate = MonthStart;
        _customEndDate = MonthEnd;
        await LoadOverview();
    }

    private async Task OnYearSelected(int year)
    {
        var daysInMonth = DateTime.DaysInMonth(year, _referenceDate.Month);
        var targetDay = Math.Min(_referenceDate.Day, daysInMonth);
        _referenceDate = new DateTime(year, _referenceDate.Month, targetDay);
        _customStartDate = MonthStart;
        _customEndDate = MonthEnd;
        await LoadOverview();
    }

    private async Task ShiftMonth(int delta)
    {
        _referenceDate = _referenceDate.AddMonths(delta);
        _customStartDate = MonthStart;
        _customEndDate = MonthEnd;
        await LoadOverview();
    }

    private async Task ShowCurrentMonth()
    {
        _referenceDate = DateTime.Today;
        _customStartDate = MonthStart;
        _customEndDate = MonthEnd;
        await LoadOverview();
    }

    private async Task LoadOverview()
    {
        _paymentOverview = await PaymentSvc.GetFacultyPaymentOverviewAsync(
            WeekendStart,
            WeekendEnd,
            PeriodStart,
            PeriodEnd);
    }

    private void OpenBreakdownDialog(FacultyPaymentOverview faculty)
    {
        _selectedFaculty = faculty;
        _breakdownDialogVisible = true;
    }

    private async Task DownloadSingleReceipt(FacultyPaymentOverview faculty)
    {
        try
        {
            var bytes = PaymentSvc.GenerateFacultyPaymentReceiptPdf(
                faculty,
                PeriodStart,
                PeriodEnd,
                HostEnv.WebRootPath);

