    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "F";
        var parts = name.Replace("Dr.", "").Replace("Mr.", "").Replace("Prof.", "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant() : parts[0][0].ToString().ToUpperInvariant();
    }

    private static string FormatTime(TimeSpan time) => DateTime.Today.Add(time).ToString("h:mm tt");
    private static DateTime MostRecentFriday(DateTime date)
    {
        var daysSinceFriday = ((int)date.DayOfWeek - (int)DayOfWeek.Friday + 7) % 7;
        return date.Date.AddDays(-daysSinceFriday);
    }
